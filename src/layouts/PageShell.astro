---
/**
 * PageShell — оболочка любого маршрута (ds/patterns.md §PageShell)
 *
 * Реализация записанного паттерна, а не новый компонент ДС: собирается
 * из BaseLayout + Navbar + содержимое + ContactBlock + Footer, своей
 * сущности в каталог не добавляет. Файл заведён потому, что три маршрута
 * держат одинаковую обёртку, и копия в каждой странице разошлась бы
 * (ds/CONTRACT.md §Что запрещено).
 *
 * ContactBlock тоже остаётся паттерном без своего файла: он собран здесь
 * из SectionHead + ProseBlock + CopyEmail appearance=address + ряда
 * TextLink. Отдельного компонента не заводим — в продукте он существует
 * ровно в одном экземпляре, в этом файле.
 *
 * Footer уходит в именованный слот BaseLayout: его место под <main>,
 * а не внутри (ds/patterns.md).
 *
 * Движение: ContactBlock — opacity целым блоком (ds/motion-concept.md §7),
 * поэтому SectionHead и ProseBlock внутри своих тактов не получают.
 * Footer без движения. 404 идёт с motion={false} и nav={false} — без
 * движения вовсе.
 *
 * Две раскладки блока, не одна ужатая (ia/wireframes/mobile-home.md):
 * десктоп — по центру, ссылки в ряд; мобильный — по левому краю, ссылки
 * двумя строками с целью нажатия в space-12. Центрированный текст на
 * 327 px даёт рваный левый край на каждой строке, а две цели в ряд —
 * маленькие зоны нажатия рядом, где промах ведёт не туда, куда целился.
 *
 * Тексты приходят из src/copy/site.ts, композиция их не держит. Ведущая
 * строка ContactBlock — проп со сквозным умолчанием: маршрут передаёт свою,
 * когда сквозная на нём неверна (ds/screens/about.md §ContactBlock).
 */
import BaseLayout from './BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ProseBlock from '../components/ProseBlock.astro';
import CopyEmail from '../components/CopyEmail.astro';
import TextLink from '../components/TextLink.astro';
import Footer from '../components/Footer.astro';
import { site, type SiteCopy } from '../copy/site.ts';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Идентификатор OG-карточки из src/copy/og.ts (BaseLayout). */
  ogCard?: string;
  /** Закрыть страницу от индексации независимо от превью-режима. */
  noindex?: boolean;
  /** Канонический адрес. Снимается на страницах ошибок (BaseLayout). */
  canonical?: boolean;
  /** Маршрут для подсветки активного пункта навигации. */
  current?: string;
  /** Навигация. 404 обходится без неё. */
  nav?: boolean;
  /** ContactBlock. Стоит на всех трёх маршрутах продукта (IA-06). */
  contact?: boolean;
  /**
   * Ведущая строка ContactBlock. Умолчание сквозное; маршрут передаёт свою,
   * когда сквозная на нём неверна — на /about это «if the case above
   * answered your question», а кейса выше там нет. IA-06 требует, чтобы
   * блок стоял на всех маршрутах в одинаковом ВИДЕ: состав, порядок и вес
   * от пропа не меняются, меняется одно предложение.
   */
  contactLead?: string;
  /**
   * Заголовок ContactBlock и подписи CopyEmail. Умолчания английские;
   * маршрут /ru/ передаёт русские (src/copy/site.ts: русские строки
   * приходят пропами, а не умолчаниями компонентов).
   */
  contactHeading?: string;
  contactCopy?: {
    copyLabel?: string;
    copyHint?: string;
    copiedLabel?: string;
    announce?: string;
    fallbackAnnounce?: string;
  };
  /** Движение. 404 идёт без него вовсе (ds/motion-concept.md §7). */
  motion?: boolean;
  /** Локализованный слой сквозных строк. */
  siteCopy?: SiteCopy;
}

const {
  title,
  description,
  lang = 'en',
  ogCard,
  noindex,
  canonical,
  current,
  nav = true,
  contact = true,
  siteCopy: siteCopyProp = site,
  contactLead,
  contactHeading,
  contactCopy,
  motion = true,
} = Astro.props;
const siteCopy: SiteCopy = siteCopyProp;
const resolvedContactLead = contactLead ?? siteCopy.contact.lead;
const resolvedContactHeading = contactHeading ?? siteCopy.contact.heading;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  ogCard={ogCard}
  noindex={noindex}
  canonical={canonical}
  current={current}
  nav={nav}
  siteCopy={siteCopy}
>
  <slot />

  {
    contact && (
      <section
        class="ds-container ds-section contact"
        id="contact"
        data-motion={motion ? 'fade' : undefined}
      >
        <SectionHead size="lg" reveal={false}>
          {resolvedContactHeading}
        </SectionHead>

        <ProseBlock motion={false} class="contact__lead">
          <p>{resolvedContactLead}</p>
        </ProseBlock>

        <CopyEmail
          email={siteCopy.contact.email}
          appearance="address"
          label={contactCopy?.copyLabel ?? siteCopy.contact.copyLabel}
          hint={contactCopy?.copyHint ?? siteCopy.contact.copyHint}
          copiedLabel={contactCopy?.copiedLabel ?? siteCopy.contact.copiedLabel}
          announce={contactCopy?.announce ?? siteCopy.contact.announce}
          fallbackAnnounce={contactCopy?.fallbackAnnounce ?? siteCopy.contact.fallbackAnnounce}
          class="contact__email"
        />

        <ul class="contact__links">
          {siteCopy.contact.links.map((link) => (
            <li>
              <TextLink href={link.href} external={link.external}>
                {link.label}
              </TextLink>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Fragment slot="footer">
    <Footer
      location={siteCopy.footer.location}
      utcLabel={siteCopy.footer.utcLabel}
      timeZone={siteCopy.footer.timeZone}
      timeLabel={siteCopy.footer.timeLabel}
      copyright={siteCopy.footer.copyright}
    />
  </Fragment>
</BaseLayout>

<style>
  /* :global обязателен: корни ProseBlock и CopyEmail несут собственный
     data-astro-cid, скоуп оболочки до них не достаёт, и правило молча не
     применяется. Найдено при сборке About 2026-08-24 — правило общее для
     любого корня компонента, не только для ссылок (ds/components.md
     §Реализация). Без него блок шёл без отступов на всех маршрутах.

     Заголовок → ведущая строка идёт шкалой ДС (ds-flow-heading), два
     оставшихся промежутка перебиты: адрес — группа, ссылки принадлежат
     адресу и стоят на узловом шаге, а не отдельным узлом. */
  .contact > :global(.contact__email) {
    margin-block-start: var(--flow-group);
  }

  .contact > .contact__links {
    margin-block-start: var(--flow-node);
  }

  /* Мобильная раскладка — базовая, десктопная надстраивается медиазапросом. */
  .contact__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact__links li {
    display: flex;
    align-items: stretch;
    min-height: var(--space-12);
  }

  /* Цель нажатия — сама ссылка, а не строка вокруг неё: li тянется на
     space-12, ссылка внутри оставалась 26 px. :global обязателен —
     корень TextLink несёт собственный data-astro-cid. */
  .contact__links li :global(.ds-link) {
    display: inline-flex;
    align-items: center;
  }

  @media (--bp-md) {
    .contact {
      text-align: center;
    }

    /* Мера колонки остаётся, центрируется сам блок. */
    .contact > :global(.contact__lead) {
      margin-inline: auto;
    }

    /* Перебивает align-items: flex-start из самого CopyEmail. */
    .contact > :global(.contact__email) {
      align-items: center;
    }

    .contact__links {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-8);
    }

    .contact__links li {
      align-items: center;
      min-height: 0;
    }
  }
</style>
