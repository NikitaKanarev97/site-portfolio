---
import PageShell from '../../../layouts/PageShell.astro';
import CaseStory from '../../../components/CaseStory.astro';
import {vetClinicStory} from '../../../copy/cases/vet-clinic';
import {vetClinicStoryRu} from '../../../copy/ru/cases/vet-clinic';
import {site} from '../../../copy/site';
import {siteRu} from '../../../copy/ru/site';
export function getStaticPaths(){return ['en','ru'].map(locale=>({params:{locale}}));}
const lang=Astro.params.locale as 'en'|'ru';
const story=lang==='ru'?vetClinicStoryRu:vetClinicStory;
const next={href:lang==='ru'?'/ru/work/pawly/':'/work/pawly/',title:'Pawly',theme:'pawly' as const,label:lang==='ru'?'Следующий кейс':'Next case'};
---
<PageShell title={`${story.cover.title} — ${lang==='ru'?'новая версия кейса':'case rebuild'}`} description={story.cover.outcome} lang={lang} siteCopy={lang==='ru'?siteRu:site} localePaths={{en:'/preview/vet-clinic-rebuild/en/',ru:'/preview/vet-clinic-rebuild/ru/'}} noindex canonical={false} current={lang==='ru'?'/ru/work':'/work'}>
  <CaseStory story={story} lang={lang} id="vet-clinic-rebuild" next={next}/>
</PageShell>
