---
/**
 * Home — Site-portfolio, маршрут /
 *
 * Composition map: ds/screens/home.md. Вайрфреймы: ia/wireframes/home.md
 * (десктоп) и ia/wireframes/mobile-home.md (самостоятельный носитель, не
 * сжатие десктопа — SCR-09, TECH-08).
 *
 * Экран не изобретает сущностей: всё собрано из каталога ds/components.md
 * и паттернов ds/patterns.md. Тексты — src/copy/home.ts, сквозные —
 * src/copy/site.ts. Оболочка, ContactBlock и Footer — PageShell.
 *
 * Порядок блоков — это и есть предмет проектирования. Скрининговый пакет
 * (роль, специализация, право на работу, CV, email, вход в кейс) обязан
 * закрыться в первых 2160 px на десктопе и 1624 px на мобильном
 * (SCR-02, SCR-06): его закрывает Hero, вход в кейс повторяется обложкой
 * следом. DevelopmentStrip стоит ниже всех продуктовых блоков (DEV-03).
 *
 * Движение — карта ds/motion-concept.md §7, один в один. Hero играет
 * вступительным тактом по fonts.ready, всё остальное — по ScrollTrigger.
 * Анимаций здесь нет: экран объявляет движение атрибутами.
 */
import PageShell from '../layouts/PageShell.astro';
import MediaFrame from '../components/MediaFrame.astro';
import FeaturedCase from '../components/FeaturedCase.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import ProseBlock from '../components/ProseBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import TextLink from '../components/TextLink.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { home as homeEn } from '../copy/home.ts';
import { homeRu } from '../copy/ru/home.ts';
import { site as siteEn, type SiteCopy } from '../copy/site.ts';
import { siteRu } from '../copy/ru/site.ts';

interface Props {
  locale?: 'en' | 'ru';
}

const { locale = 'en' } = Astro.props;
const home = locale === 'ru' ? homeRu : homeEn;
const site: SiteCopy = locale === 'ru' ? siteRu : siteEn;
---

<PageShell
  title={home.meta.title}
  description={home.meta.description}
  lang={locale}
  current={locale === 'ru' ? '/ru/' : '/'}
  siteCopy={site}
  ogCard={locale === 'ru' ? 'default-ru' : 'default'}
>
  {/*
    Hero. Вступительный такт: имя, роль, специализация и авторизация идут
    автоматическим шагом каскада, ряд действий — явной позицией 0.4.
  */}
  <section class="ds-container ds-section hero" data-motion-intro>
    <p class="ds-body-base hero__name" data-motion="fade"><span>{home.hero.name}</span><span class="hero__profession">{home.hero.role}</span></p>

    <h1 class="ds-display-home hero__role ds-flow-heading">
      {home.hero.headline.map(line => <span data-motion="reveal-text">{line}</span>)}
    </h1>

    <a class="hero__portrait" href={home.about.href} aria-label={home.about.link} data-motion="fade">
      <img src={home.hero.portrait.srcMobile} width="128" height="171" alt={home.hero.portrait.alt} loading="eager" decoding="async" />
    </a>

    <div class="hero__copy">
    <p class="ds-body-base hero__spec" data-motion="fade">{home.hero.specialization}</p>

    {/*
      Право на работу. Максимум две строки на 360 px — единственная строка
      сайта с жёстким лимитом по числу строк (ia/wireframes/mobile-home.md).
    */}
    <div class="hero__actions" data-motion="fade" data-motion-at="0.4">
      <TextLink type="arrow" direction="down" href="#work" class="hero__work-link ds-heading-xl">{home.hero.workAction}</TextLink>
      <TextLink type="arrow" class="hero__cv-link" href={locale === 'ru' ? '/cv-ru.pdf' : '/cv.pdf'}>{home.hero.cv}</TextLink>
      <CopyEmail
        email={site.contact.email}
        appearance="action"
        label={home.hero.copyAction}
        hint={site.contact.copyHint}
        copiedLabel={site.contact.copiedLabel}
        announce={site.contact.announce}
        fallbackAnnounce={site.contact.fallbackAnnounce}
      />
    </div>
    {home.hero.authorization && <p class="ds-body-sm hero__authorization" data-motion="fade">
      {home.hero.authorization}
    </p>}
    </div>
  </section>

  {/*
    FeaturedCase — отдельные переходы в кейс и увеличение каждого снимка.

    Все пять принятых работ открыты. Обложки берут реальные кадры из stories.
  */}
  <section class="ds-container ds-section featured" id="work">
    <div class="featured__bridge" data-motion="cascade">
      <p class="ds-meta-xs featured__eyebrow">{home.featured.eyebrow}</p>
      <span class="ds-meta-xs featured__count" aria-hidden="true">01 — 05</span>
    </div>

    <ol class="featured__list">
      {home.featured.items.map((item, index) => (
        <li><FeaturedCase item={item} index={index} locale={locale} editorial={index < 4} proofFirst={index === 0} /></li>
      ))}
    </ol>
  </section>

  {/*
    Секция WorksList снята 2026-08-27 вместе с `home.works` — обоснование
    там же и в ds/screens/case-agent-ops.md. В ней оставалась одна запись,
    RUUN, чей кейс решено не писать; секция без записей теряет предмет, а
    пустая секция ради компонента не заводится (TECH-15). `WorkRow` живёт
    в каталоге и в /kit, носителей на страницах продукта у него больше нет.
  */}

  {/*
    DevelopmentStrip. Ниже всех продуктовых блоков, заголовок заметно мельче
    заголовка Selected work — это вес блока, а не оформление (DEV-03).
    Мобильная форма — не та же карточка в другом размере, а горизонтальная
    строка с миниатюрой: перенос десктопной сетки даёт 87% площади обложки
    против лимита в четверть (арифметика в ds/patterns.md §DevelopmentCard).

    Описания сборок в полосу не выложены, и это не экономия места: четыре
    описания здесь ломают DEV-03. Они живут в ProjectDialog ниже — вес
    страницы от них не меняется ни на пиксель. Замерено после сборки:
    21,8% на 1440, 14,7% на 375, 16,1% на 360.
  */}
  <section class="ds-container ds-section dev">
    <div class="dev__head" data-motion-group data-motion-stagger="tight">
      <SectionHead size="lg">{home.development.heading}</SectionHead>
      <ProseBlock class="dev__lead">
        <p>{home.development.lead}</p>
      </ProseBlock>
    </div>

    <ul class="dev__list" data-motion-group data-motion-stagger="tight">
      {
        home.development.items.map((item) => (
          <li>
            {/*
              Карточка — кнопка, а не ссылка: она открывает разбор, а не
              уводит на сайт. Живая ссылка стоит внутри ProjectDialog —
              вложить её сюда нельзя, это две цели фокуса подряд (запрет
              ds/patterns.md §FeaturedCaseCover). Название кнопки собрано
              из надписи и имени сборки: четыре «Details» подряд в списке
              ссылок скринридера не различаются между собой.
            */}
            <a href={item.href}
              class="dev__link ds-pressable"
              data-dialog-open={`dev-${item.slug}`}
              aria-label={`${home.development.openLabel} ${home.development.openHint} ${item.name}`}
            >
              {/*
                ratio=wide — вариант ДС под Webflow-сборки. Кадры сняты в
                16:9 нормой scripts/shoot-webflow-frames.mjs: рамка ничего
                не режет, потому что режет уже съёмка — по границе первого
                экрана сборки, а не по краю окна. До 2026-08-25 здесь стоял
                natural под кадры 16:10, и он прятал ошибку съёмки, а не
                решал её. Alt пустой намеренно: описание кадра живёт в
                разборе, а сама карточка названа целиком.
              */}
              <MediaFrame
                src={item.preview}
                ratio="wide"
                alt=""
                counterScale={false}
                reveal={false}
                class="dev__preview"
              />

              <div class="dev__body">
                <h3 class="ds-heading-xl dev__name">{item.name}</h3>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    Разборы сборок — по узлу на сборку, вне полосы. Стоят после секции, а не
    внутри <ul>: showModal() уводит окно в top layer независимо от места в
    DOM, а список из четырёх строк остаётся списком из четырёх строк.
    Обоснование самого окна — ds/components.md §ProjectDialog.
  */}
  {
    home.development.items.map((item) => (
      <ProjectDialog
        id={`dev-${item.slug}`}
        title={item.name}
        lead={item.summary}
        body={item.body}
        meta={[
          { term: home.development.roleLabel, value: home.development.roleValue, tone: 'strong' },
          { term: home.development.builtLabel, value: item.stack },
        ]}
        media={{ src: item.preview, alt: item.previewAlt }}
        action={{ href: item.href, label: home.development.liveLabel }}
        closeLabel={home.development.closeLabel}
      />
    ))
  }

  {/* The process is a sequence; its section heading matches web builds. */}
  <section class="ds-container ds-section about" data-motion="fade">
    <div class="about__head">
      <SectionHead size="lg" reveal={false}>{home.about.heading}</SectionHead>
      <TextLink href={home.about.href} type="arrow">{home.about.link}</TextLink>
    </div>
    <ol class="about__steps">
      {home.about.steps.map(step => <li>
        <h3 class="ds-heading-xl">{step.heading}</h3>
        <p class="ds-body-lg">{step.body}</p>
      </li>)}
    </ol>
  </section>
</PageShell>

<style>
  :global(main:has(> .hero)) { padding-block-start:var(--flow-text); }
  .hero { display:grid; grid-template-columns:minmax(0,1fr) var(--space-16); gap:var(--flow-text); align-items:center; }
  .hero > *, .hero > .hero__role, .hero__copy > *, .hero__copy > :global(.hero__spec) { margin-block-start:0; }
  .hero__copy { display:grid; gap:var(--flow-pair); align-content:start; grid-column:1 / -1; }
  .hero__name { display:flex; flex-direction:column; gap:0; color:var(--text-default); }
  .hero__profession { color:var(--text-subtle); }
  .hero__role { color:var(--text-default); grid-column:1 / -1; }
  .hero__role > span { display:block; }
  .hero__role > span:last-child { color:var(--text-link); }
  .hero__authorization { color:var(--text-subtle); max-inline-size:var(--measure-text); }
  .hero__portrait { grid-column:2; grid-row:1; inline-size:var(--space-16); border-radius:var(--radius-md); overflow:hidden; }
  .hero__portrait img { inline-size:100%; block-size:auto; aspect-ratio:1; object-fit:cover; object-position:top; }
  .hero__portrait:active { outline:var(--focus-ring-width) solid var(--text-link-pressed); }
  /* Explicit action tracks. Subgrid lets CopyEmail keep its semantic wrapper
     while its selectable address spans a separate line beneath both actions. */
  .hero__actions { display:grid; grid-template-columns:max-content minmax(0,1fr); column-gap:var(--space-6); align-items:start; }
  .hero .hero__actions > :global(.ds-link) { display:inline-flex; align-items:center; min-block-size:var(--space-12); justify-self:start; white-space:nowrap; }
  .hero__actions > :global(.hero__work-link) { grid-column:1 / -1; color:var(--text-link); }
  .hero__actions > :global(.hero__cv-link) { grid-column:1; grid-row:2; color:var(--text-subtle); }
  .hero__actions > :global(.copy-email--action) { display:grid; grid-template-columns:subgrid; grid-column:1 / -1; grid-row:2 / span 3; gap:0 var(--space-6); align-items:start; pointer-events:none; }
  .hero__actions :global(.copy-email__button) { grid-column:2; justify-self:start; color:var(--text-subtle); pointer-events:auto; }
  .hero__actions :global(.copy-email__hint), .hero__actions :global(.copy-email__failure) { grid-column:1 / -1; margin:0; pointer-events:auto; }
  .hero__actions :global(.copy-email__hint) { min-block-size:var(--flow-text); }
  .hero__actions :global(.ds-link__arrow) { align-self:center; }
  @media (--can-hover) {
    .hero__actions > :global(.ds-link:hover), .hero__actions :global(.copy-email__button:hover) { color:var(--text-link-hover); }
  }
  .hero__actions > :global(.ds-link:active), .hero__actions :global(.copy-email__button:active) { color:var(--text-link-pressed); }
  @media (--below-bp-md) {
    .hero { gap:var(--flow-pair); }
    .hero__copy { gap:var(--flow-pair); }
  }
  @media (--bp-md) {
    .hero__name { flex-direction:row; gap:var(--space-6); }
    .hero__portrait { inline-size:calc(var(--space-16) + var(--space-4)); }
  }
  @media (--bp-lg) {
    .hero { grid-template-columns:minmax(0,3fr) minmax(0,1fr); gap:var(--flow-text) var(--space-16); }
    .hero__name, .hero__role { grid-column:1 / -1; }
    .hero__portrait { grid-column:2; grid-row:3; inline-size:calc(var(--space-24) + var(--space-4)); justify-self:end; }
    .hero__portrait img { aspect-ratio:3 / 4; }
    .hero__copy { grid-column:1; grid-row:3; }
  }
  @media (--bp-xl) {
    .hero__actions { grid-template-columns:max-content max-content minmax(0,1fr); }
    .hero__actions > :global(.hero__work-link) { grid-column:1; grid-row:1; }
    .hero__actions > :global(.hero__cv-link) { grid-column:2; grid-row:1; }
    .hero__actions > :global(.copy-email--action) { grid-column:3; grid-row:1; display:flex; flex-direction:row; flex-wrap:wrap; align-items:center; gap:0 var(--space-3); }
  }

  .hero + .featured { margin-block-start:var(--flow-node); }
  .featured__bridge { display:flex; align-items:center; justify-content:space-between; gap:var(--gutter); border-block-start:var(--border-width) solid var(--border-default); padding-block-start:var(--flow-pair); }
  .featured__count { color:var(--text-meta); }

  /* Отступ под eyebrow задаёт ds-flow-eyebrow на нём самом. */
  .featured__eyebrow {
    color: var(--text-meta);
  }

  .featured__list { display: grid; gap: var(--section-gap); }
  .featured > .featured__list { margin-block-start: var(--flow-text); }

  /* Only the first cover: native proof follows its title in DOM and on phones.
     The explanatory outcome rejoins the title rail on wider screens. */
  @media (--below-bp-md) {
    .featured > .featured__list { margin-block-start:var(--flow-pair); }
  }
  @media (--bp-md) {
    .featured :global(.featured-case--proof-first .featured-case__outcome) { grid-row:2; }
  }
  @media (--bp-lg) {
    .featured :global(.featured-case--proof-first) { grid-template-columns:minmax(0,3fr) minmax(0,2fr); column-gap:var(--space-16); align-items:end; }
    .featured :global(.featured-case--proof-first .featured-case__head) { display:contents; }
    .featured :global(.featured-case--proof-first .featured-case__identity) { grid-column:1; grid-row:1; }
    .featured :global(.featured-case--proof-first .featured-case__outcome) { grid-column:2; grid-row:1; }
    .featured :global(.featured-case--proof-first .featured-case__stage) { grid-column:1 / -1; grid-row:2; }
    .featured :global(.featured-case--proof-first .featured-case__foot) { grid-column:1 / -1; }
  }

  /* ---------------------------------------------------------------- *
   * WorksList                                                         *
   * ---------------------------------------------------------------- */

  /* Заголовок → лид внутри обёртки каскада и обёртка → перечень идут
     шкалой: ds-flow-heading на SectionHead и умолчание секции. Двух
     правил, стоявших здесь до 2026-08-24, не осталось — они и давали
     на главной 64 там, где на /about выходило 48. */

  /* ---------------------------------------------------------------- *
   * DevelopmentStrip                                                  *
   * ---------------------------------------------------------------- */

  /* Мобильная форма — четыре строки с миниатюрой. */
  .dev__list {
    display: flex;
    flex-direction: column;
  }

  /* Карточка — кнопка, и вид контрола с неё снимается целиком: она обязана
     выглядеть карточкой, а не кнопкой с картинкой внутри. Что она
     нажимается, говорят курсор и ds-pressable, клавиатуре — фокус-кольцо
     глобального слоя. Ширина 100% и выравнивание влево нужны потому, что
     кнопка по умолчанию сжимается по содержимому и центрует его. */
  .dev__link {
    display: grid;
    grid-template-columns: var(--space-16) 1fr;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding-inline: 0;
    padding-block: var(--space-2);
    min-height: var(--space-12);
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .dev__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .dev__name {
    color: var(--text-default);
  }

  /* Десктоп: две карточки в ряд, превью сверху. Четыре в ряд давали кадр
     шириной 300 px — визуальную работу было не разглядеть, а именно эта
     секция показывает визуальный дизайн. Подпись «Details» снята: карточка
     открывает разбор по клику, скринридеру это говорит aria-label. */
  @media (--bp-md) {
    .dev__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-12) var(--gutter);
    }

    .dev__link {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding-block: 0;
      min-height: 0;
    }
  }

  @media (--bp-lg) {
    .dev__list { grid-template-columns:repeat(4,minmax(0,1fr)); }
  }

  /* Preview lift matches FeaturedCase; title stays still. */
  .dev__name { transition: color var(--motion-hover-duration) var(--motion-hover-ease); }
  .dev__link:active .dev__name { color: var(--text-link-pressed); transition-duration: var(--motion-press-duration); transition-timing-function: var(--motion-press-ease); }
  .dev__link :global(.dev__preview) {
    transition: transform var(--motion-hover-duration) var(--motion-hover-ease);
  }
  /* Волосяной контур поверх кадра: у светлых сборок (Common) белая
     страница иначе сливается с фоном и кадр теряет край. */
  .dev__link :global(.media-frame__mask) {
    outline: var(--border-width) solid var(--border-default);
    outline-offset: calc(var(--border-width) * -1);
  }
  @media (--can-hover) {
    .dev__link:hover .dev__name {
      color: var(--text-link-hover);
    }
    .dev__link:active .dev__name { color: var(--text-link-pressed); }
    @media (prefers-reduced-motion: no-preference) {
      .dev__link:hover :global(.dev__preview) {
        transform: translateY(calc(var(--space-1) * -1));
      }
    }
  }

  /* ---------------------------------------------------------------- *
   * AboutShort                                                        *
   * ---------------------------------------------------------------- */

  .about__head { display:grid; gap:var(--flow-text); align-content:start; }
  .about__head > :global(*) { margin-block-start:0; }
  .about__head > :global(.ds-link) {
    display: inline-flex;
    align-items: center;
    justify-self:start;
    min-block-size: var(--space-12);
  }

  .about__steps { display:grid; gap:var(--flow-node); }
  .about__steps li { display:grid; gap:var(--flow-pair); align-content:start; }
  .about__steps p { color:var(--text-subtle); }
  @media (--bp-lg) {
    .about { display:grid; grid-template-columns:1fr 3fr; gap:var(--space-16); }
    .about > * { margin-block-start:0; }
    .about__steps { grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-8); }
  }
</style>
