---
/**
 * Home — Site-portfolio, маршрут /
 *
 * Composition map: ds/screens/home.md. Вайрфреймы: ia/wireframes/home.md
 * (десктоп) и ia/wireframes/mobile-home.md (самостоятельный носитель, не
 * сжатие десктопа — SCR-09, TECH-08).
 *
 * Экран не изобретает сущностей: всё собрано из каталога ds/components.md
 * и паттернов ds/patterns.md. Тексты — src/copy/home.ts, сквозные —
 * src/copy/site.ts. Оболочка, ContactBlock и Footer — PageShell.
 *
 * Порядок блоков — это и есть предмет проектирования. Скрининговый пакет
 * (роль, специализация, право на работу, CV, email, вход в кейс) обязан
 * закрыться в первых 2160 px на десктопе и 1624 px на мобильном
 * (SCR-02, SCR-06): его закрывает Hero, вход в кейс повторяется обложкой
 * следом. DevelopmentStrip стоит ниже всех продуктовых блоков (DEV-03).
 *
 * Движение — карта ds/motion-concept.md §7, один в один. Hero играет
 * вступительным тактом по fonts.ready, всё остальное — по ScrollTrigger.
 * Анимаций здесь нет: экран объявляет движение атрибутами.
 */
import PageShell from '../layouts/PageShell.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ScreenStack from '../components/ScreenStack.astro';
import MetaList from '../components/MetaList.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import ProseBlock from '../components/ProseBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import TextLink from '../components/TextLink.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { home as homeEn } from '../copy/home.ts';
import { homeRu } from '../copy/ru/home.ts';
import { site as siteEn, type SiteCopy } from '../copy/site.ts';
import { siteRu } from '../copy/ru/site.ts';

interface Props {
  locale?: 'en' | 'ru';
}

const { locale = 'en' } = Astro.props;
const home = locale === 'ru' ? homeRu : homeEn;
const site: SiteCopy = locale === 'ru' ? siteRu : siteEn;
---

<PageShell
  title={home.meta.title}
  description={home.meta.description}
  lang={locale}
  current={locale === 'ru' ? '/ru/' : '/'}
  siteCopy={site}
  ogCard={locale === 'ru' ? 'default-ru' : 'default'}
>
  {/*
    Hero. Вступительный такт: имя, роль, специализация и авторизация идут
    автоматическим шагом каскада, ряд действий — явной позицией 0.4.
  */}
  <section class="ds-container ds-section hero" data-motion-intro>
    <h1 class="ds-display-5xl hero__name" data-motion="reveal-text">{home.hero.name}</h1>

    <p class="ds-heading-2xl hero__role ds-flow-heading" data-motion="reveal-text">
      {home.hero.role}
    </p>

    <ProseBlock motion={false} class="hero__spec">
      <p data-motion="reveal-text">{home.hero.specialization}</p>
    </ProseBlock>

    {/*
      Право на работу. Максимум две строки на 360 px — единственная строка
      сайта с жёстким лимитом по числу строк (ia/wireframes/mobile-home.md).
    */}
    <p class="ds-body-base hero__authorization" data-motion="reveal-text">
      {home.hero.authorization}
    </p>

    <div class="hero__actions" data-motion="fade" data-motion-at="0.4">
      <TextLink href="#work" type="arrow">{home.hero.caseEntry}</TextLink>
      <TextLink href={locale === 'ru' ? '/cv-ru.pdf' : '/cv.pdf'}>{home.hero.cv}</TextLink>
      <CopyEmail
        email={site.contact.email}
        appearance="action"
        label={site.contact.copyLabel}
        hint={site.contact.copyHint}
        copiedLabel={site.contact.copiedLabel}
        announce={site.contact.announce}
        fallbackAnnounce={site.contact.fallbackAnnounce}
      />
    </div>
  </section>

  {/*
    FeaturedCase — паттерн FeaturedCaseCover. Кликабелен блок целиком:
    один <a> вокруг обложки, заголовка, строки исхода, меты и CTA.
    Вложенных ссылок внутри нет — иначе фокус ловит две цели подряд.

    ds-pressable — плоскостная форма нажатия (ds/motion-concept.md §3.4).
    Главная цель продукта, и на телефоне единственный отклик на тап: hover
    там не существует, а до начала перехода проходит сетевой запрос.
  */}
  <section class="ds-container ds-section featured" id="work">
    <p class="ds-meta-xs featured__eyebrow ds-flow-eyebrow">{home.featured.eyebrow}</p>

    {
      home.featured.items.map((item, index) => (
        <a class="featured__link ds-pressable" href={item.href} data-motion-group>
          {/*
            eager только у первой обложки: она стоит в первом экране,
            остальные уходят за сгиб и грузятся по умолчанию.
          */}
          <ScreenStack
            screens={item.cover}
            alt={item.coverAlt}
            loading={index === 0 ? 'eager' : 'lazy'}
            class="featured__cover"
          />

          <h2 class="ds-heading-3xl featured__title" data-motion="reveal-text">
            {item.title}
          </h2>

          <ProseBlock variant="lead" class="featured__outcome">
            <p>{item.outcome}</p>
          </ProseBlock>

          <MetaList items={item.meta} layout="inline" class="featured__meta" />

          <span class="featured__cta ds-body-base">
            {item.cta}
            <span class="featured__cta-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </section>

  {/*
    Секция WorksList снята 2026-08-27 вместе с `home.works` — обоснование
    там же и в ds/screens/case-agent-ops.md. В ней оставалась одна запись,
    RUUN, чей кейс решено не писать; секция без записей теряет предмет, а
    пустая секция ради компонента не заводится (TECH-15). `WorkRow` живёт
    в каталоге и в /kit, носителей на страницах продукта у него больше нет.
  */}

  {/*
    DevelopmentStrip. Ниже всех продуктовых блоков, заголовок заметно мельче
    заголовка Selected work — это вес блока, а не оформление (DEV-03).
    Мобильная форма — не та же карточка в другом размере, а горизонтальная
    строка с миниатюрой: перенос десктопной сетки даёт 87% площади обложки
    против лимита в четверть (арифметика в ds/patterns.md §DevelopmentCard).

    Описания сборок в полосу не выложены, и это не экономия места: четыре
    описания здесь ломают DEV-03. Они живут в ProjectDialog ниже — вес
    страницы от них не меняется ни на пиксель. Замерено после сборки:
    21,8% на 1440, 14,7% на 375, 16,1% на 360.
  */}
  <section class="ds-container ds-section dev">
    <div class="dev__head" data-motion-group data-motion-stagger="tight">
      <SectionHead size="sm">{home.development.heading}</SectionHead>
      <ProseBlock class="dev__lead">
        <p>{home.development.lead}</p>
      </ProseBlock>
    </div>

    <ul class="dev__list" data-motion-group data-motion-stagger="tight">
      {
        home.development.items.map((item) => (
          <li>
            {/*
              Карточка — кнопка, а не ссылка: она открывает разбор, а не
              уводит на сайт. Живая ссылка стоит внутри ProjectDialog —
              вложить её сюда нельзя, это две цели фокуса подряд (запрет
              ds/patterns.md §FeaturedCaseCover). Название кнопки собрано
              из надписи и имени сборки: четыре «Details» подряд в списке
              ссылок скринридера не различаются между собой.
            */}
            <button
              class="dev__link ds-pressable"
              type="button"
              data-dialog-open={`dev-${item.slug}`}
              aria-label={`${home.development.openLabel} ${home.development.openHint} ${item.name}`}
            >
              {/*
                ratio=wide — вариант ДС под Webflow-сборки. Кадры сняты в
                16:9 нормой scripts/shoot-webflow-frames.mjs: рамка ничего
                не режет, потому что режет уже съёмка — по границе первого
                экрана сборки, а не по краю окна. До 2026-08-25 здесь стоял
                natural под кадры 16:10, и он прятал ошибку съёмки, а не
                решал её. Alt пустой намеренно: описание кадра живёт в
                разборе, а сама карточка названа целиком.
              */}
              <MediaFrame
                src={item.preview}
                ratio="wide"
                alt=""
                counterScale={false}
                class="dev__preview"
              />

              <div class="dev__body">
                <h3 class="ds-heading-xl dev__name">{item.name}</h3>

                <MetaList
                  items={[
                    {
                      term: home.development.roleLabel,
                      value: home.development.roleValue,
                      tone: 'strong',
                    },
                  ]}
                  layout="stacked"
                  class="dev__role"
                />
              </div>

              <span class="dev__cta ds-meta-xs" aria-hidden="true">
                {home.development.openLabel}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    Разборы сборок — по узлу на сборку, вне полосы. Стоят после секции, а не
    внутри <ul>: showModal() уводит окно в top layer независимо от места в
    DOM, а список из четырёх строк остаётся списком из четырёх строк.
    Обоснование самого окна — ds/components.md §ProjectDialog.
  */}
  {
    home.development.items.map((item) => (
      <ProjectDialog
        id={`dev-${item.slug}`}
        title={item.name}
        lead={item.summary}
        body={item.body}
        meta={[
          { term: home.development.roleLabel, value: home.development.roleValue, tone: 'strong' },
          { term: home.development.builtLabel, value: item.stack },
        ]}
        media={{ src: item.preview, alt: item.previewAlt }}
        action={{ href: item.href, label: home.development.liveLabel }}
        closeLabel={home.development.closeLabel}
      />
    ))
  }

  {/* AboutShort. Портрета здесь нет: он живёт на /about и не на первом экране. */}
  <section class="ds-container ds-section about" data-motion="fade">
    <SectionHead size="lg" reveal={false}>{home.about.heading}</SectionHead>

    <ProseBlock motion={false} class="about__body">
      <p>{home.about.body}</p>
    </ProseBlock>

    <TextLink href={home.about.href} type="arrow">{home.about.link}</TextLink>
  </section>
</PageShell>

<style>
  /* ---------------------------------------------------------------- *
   * Hero                                                              *
   * ---------------------------------------------------------------- */

  /* Вертикаль экрана идёт шкалой ДС и пишется одним направлением —
     margin-block-start на нижнем узле. Шаг принадлежит промежутку, и
     смешение направлений (margin-bottom у одного, margin-top у соседа)
     складывало бы их. Умолчание секции — flow-block; здесь перебиты три
     пары, у которых связь теснее. */

  .hero__name {
    color: var(--text-default);
  }

  /* Имя и роль — одна пара, а не два узла. */
  .hero > .hero__role {
    margin-block-start: var(--flow-pair);
    color: var(--text-subtle);
  }

  /* Роль → специализация: шаг задаёт ds-flow-heading на роли. Правила
     здесь нет намеренно — до 2026-08-24 на этом месте стоял
     `.hero > :global(.hero__spec)`, ровно тот случай, ради которого
     :global() и заводился. */

  .hero > .hero__authorization {
    margin-block-start: var(--flow-text);
    color: var(--text-subtle);
    max-width: var(--measure-text);
  }

  /* Мобильная раскладка базовая: три цели в столбик, каждая во всю ширину.
     В ряд на 327 px они дают по 101 px — надписи ломаются. */
  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }

  /* :global обязателен: корни TextLink и CopyEmail несут собственный
     data-astro-cid, скоуп страницы до них не достаёт, и правило без
     :global молча не применяется — цель нажатия остаётся 26 px. */
  .hero__actions > :global(*) {
    display: flex;
    align-items: center;
    min-height: var(--space-12);
  }

  /* CopyEmail сам является flex-контейнером: общее центрирование цели
     выше не должно центрировать кнопку и адрес внутри его мобильной
     колонки. */
  .hero__actions > :global(.copy-email--action) {
    align-items: flex-start;
  }

  @media (--bp-md) {
    .hero__actions {
      flex-direction: row;
      align-items: baseline;
      /* На нижней границе tablet три действия и адрес занимают почти всю
         колонку. Узкий системный шаг сохраняет ряд без переноса подписей;
         desktop возвращает исходный простор ниже. */
      gap: var(--space-4);
    }

    .hero__actions > :global(*) {
      min-height: 0;
    }

    .hero__actions > :global(.copy-email--action) {
      align-items: baseline;
    }
  }

  @media (--bp-lg) {
    .hero__actions {
      gap: var(--space-8);
    }
  }

  /* ---------------------------------------------------------------- *
   * FeaturedCase                                                      *
   * ---------------------------------------------------------------- */

  /* Отступ под eyebrow задаёт ds-flow-eyebrow на нём самом. */
  .featured__eyebrow {
    color: var(--text-meta);
  }

  .featured__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Кейс к кейсу — секционный шаг, а не узловой. Умолчание секции
     (`--flow-block`, 64) ставило следующую обложку почти вплотную к CTA
     предыдущей, и соседние карточки читались одной. Каждая здесь — целый кейс,
     промежуток между ними того же порядка, что между секциями. */
  .featured__link + .featured__link {
    margin-block-start: var(--section-gap);
  }

  /* Фокус-кольцо на обёртке, не на картинке. */
  .featured__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--space-2);
  }

  /* Обложка → заголовок: узловой шаг. Ниже карточка идёт теснее шкалы
     по умолчанию — это одна композиция, а не перечень узлов, и её
     собственная плотность держит вход в кейс в первом экране (SCR-02). */
  .featured__link > :global(.featured__title) {
    margin-block-start: var(--flow-node);
  }

  .featured__title {
    color: var(--text-default);
  }

  /* Заголовок и строка исхода — пара. */
  .featured__link > :global(.featured__outcome) {
    margin-block-start: var(--flow-pair);
  }

  /* Перебивает ds-flow-lead на строке исхода: в карточке шаг текстовый. */
  .featured__link > :global(.featured__meta) {
    margin-block-start: var(--flow-text);
  }

  /* CTA — часть той же ссылки, не вторая ссылка рядом. Как у TextLink,
     подчёркивание приходит слева и уходит вправо, стрелка сдвигается. */
  .featured__cta {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    position: relative;
    margin-block-start: var(--flow-text);
    color: var(--text-link);
  }

  .featured__cta-arrow {
    display: inline-block;
    transition: transform var(--motion-hover-duration) var(--motion-hover-ease);
  }

  .featured__cta::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: calc(var(--space-1) * -1);
    height: var(--border-width);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition:
      transform var(--motion-hover-duration) var(--motion-hover-ease);
  }

  .featured__link:focus-visible .featured__cta::after,
  .featured__link:active .featured__cta::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (--can-hover) {
    .featured__link:hover .featured__cta::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .featured__link:hover .featured__cta-arrow {
      transform: translateX(var(--space-1));
    }
  }

  /* ---------------------------------------------------------------- *
   * WorksList                                                         *
   * ---------------------------------------------------------------- */

  /* Заголовок → лид внутри обёртки каскада и обёртка → перечень идут
     шкалой: ds-flow-heading на SectionHead и умолчание секции. Двух
     правил, стоявших здесь до 2026-08-24, не осталось — они и давали
     на главной 64 там, где на /about выходило 48. */

  /* ---------------------------------------------------------------- *
   * DevelopmentStrip                                                  *
   * ---------------------------------------------------------------- */

  /* Мобильная форма — четыре строки с миниатюрой. */
  .dev__list {
    display: flex;
    flex-direction: column;
  }

  /* Карточка — кнопка, и вид контрола с неё снимается целиком: она обязана
     выглядеть карточкой, а не кнопкой с картинкой внутри. Что она
     нажимается, говорят курсор и ds-pressable, клавиатуре — фокус-кольцо
     глобального слоя. Ширина 100% и выравнивание влево нужны потому, что
     кнопка по умолчанию сжимается по содержимому и центрует его. */
  .dev__link {
    display: grid;
    grid-template-columns: var(--space-16) 1fr auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding-inline: 0;
    padding-block: var(--space-2);
    min-height: var(--space-12);
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .dev__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .dev__name {
    color: var(--text-default);
  }

  .dev__cta {
    color: var(--text-meta);
    white-space: nowrap;
  }

  /* Десктоп: четыре карточки в ряд, превью сверху. */
  @media (--bp-md) {
    .dev__list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }

    .dev__link {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding-block: 0;
      min-height: 0;
    }
  }

  /* Наведение на карточку — только цвет имени. Фона под курсором у мобильной
     строки больше нет: подсветка ряда целиком читается как выделение в списке,
     а не как переход, и на десктопе четыре карточки её всё равно не получали.
     Отклик на тап даёт ds-pressable. */
  @media (--can-hover) {
    .dev__link:hover .dev__name {
      color: var(--text-link-hover);
    }
  }

  /* ---------------------------------------------------------------- *
   * AboutShort                                                        *
   * ---------------------------------------------------------------- */

  /* Ссылка принадлежит абзацу над ней, а не стоит отдельным узлом:
     текстовый шаг вместо умолчания секции. Та же цель нажатия, что в
     ряду Hero, и тот же :global по той же причине — ссылка это корень
     TextLink. */
  .about > :global(.ds-link) {
    margin-block-start: var(--flow-text);
    display: inline-flex;
    align-items: center;
    min-height: var(--space-12);
  }

  @media (--bp-md) {
    .about > :global(.ds-link) {
      min-height: 0;
    }
  }
</style>
