---
/**
 * NotFound — Site-portfolio, маршрут /404
 *
 * Composition map: ds/screens/service.md. Инвентарь: ia/screens-inventory.md
 * №31, TECH-06. Тексты — src/copy/service.ts.
 *
 * Настоящий HTTP 404 отдаёт хостинг: статическая сборка кладёт в dist
 * файл 404.html, Vercel отвечает им с кодом 404. Клиентского редиректа
 * нет и быть не должно — редирект теряет и код ответа, и адрес, по
 * которому человек пришёл.
 *
 * Оболочка без навигации и без движения вовсе (ds/patterns.md §PageShell,
 * ds/motion-concept.md §7). ContactBlock остаётся: у пришедшего сюда
 * сломалась ссылка, а email и CV — то, за чем он шёл (IA-06, US-03).
 */
import PageShell from '../layouts/PageShell.astro';
import ProseBlock from '../components/ProseBlock.astro';
import ServiceRoutes from '../components/ServiceRoutes.astro';
import { notFound, serviceRoutes, serviceContactLead } from '../copy/service.ts';
import { notFoundRu, serviceRoutesRu, serviceContactLeadRu } from '../copy/ru/service.ts';
import { site } from '../copy/site.ts';
import { siteRu } from '../copy/ru/site.ts';

interface Props { locale?: 'en' | 'ru'; }
const { locale = 'en' } = Astro.props;
const ruFirst = locale === 'ru';
const primary = ruFirst ? notFoundRu : notFound;
const blocks = [
  { lang: 'en', heading: notFound.heading, lead: notFound.lead, routesHeading: notFound.routesHeading, routes: serviceRoutes },
  { lang: 'ru', heading: notFoundRu.heading, lead: [notFoundRu.lead], routesHeading: notFoundRu.routesHeading, routes: serviceRoutesRu },
];
if (ruFirst) blocks.reverse();
---

<PageShell
  title={primary.meta.title}
  description={primary.meta.description}
  lang={locale}
  siteCopy={ruFirst ? siteRu : site}
  nav={false}
  motion={false}
  noindex
  canonical={false}
  contactLead={ruFirst ? serviceContactLeadRu : serviceContactLead}
>
  {blocks.map((block, index) => {
    const Heading = index === 0 ? 'h1' : 'h2';
    const RoutesHeading = index === 0 ? 'h2' : 'h3';
    return <section class="ds-container ds-section" lang={block.lang} aria-labelledby={`not-found-${block.lang}`}>
      {index === 0 && <p class="ds-meta-xs code ds-flow-eyebrow">{notFound.code}</p>}
      <Heading class="ds-heading-4xl ds-flow-heading" id={`not-found-${block.lang}`}>{block.heading}</Heading>
      <ProseBlock variant="lead" motion={false}>
        {block.lead.map(paragraph => <p>{paragraph}</p>)}
      </ProseBlock>
      <RoutesHeading class="ds-heading-3xl ds-flow-heading">{block.routesHeading}</RoutesHeading>
      <ServiceRoutes items={block.routes} />
    </section>;
  })}
</PageShell>

<style>
  /* Вертикали на служебных маршрутах не осталось ни одной строки: код
     ответа — eyebrow над заголовком (ds-flow-eyebrow), «заголовок → лид»
     и «заголовок → перечень маршрутов» идут той же шкалой ДС, что на
     продуктовых экранах, лид → перечень — ступенью ds-flow-lead.
     Четыре правила, стоявшие здесь до 2026-08-24, держали свои числа —
     16, 32, 64 и 32 — и совпадали с продуктовыми только случайно. */
  .code {
    color: var(--text-meta);
  }
</style>
