---
/**
 * LocaleRU — Site-portfolio, маршрут /ru/
 *
 * Composition map: ds/screens/service.md §LocaleRU. Механика локалей —
 * src/copy/routes.ts, тексты — src/copy/service.ts.
 *
 * Каркас локали, а не перевод сайта (TECH-13). Решение владельца от
 * 24.08.2026 закрывает вопрос №6 ia/open-questions.md: механизм написан
 * на все четыре маршрута, материализована одна страница. Добавление
 * /ru/about — строка в реестре маршрутов плюс файл страницы; hreflang,
 * sitemap и вёрстка не трогаются.
 *
 * noindex стоит собственным пропом и от превью-режима не зависит: пока
 * RU_PUBLISHED === false, страница отвечает и несёт hreflang, но в индекс
 * не идёт. Непереведённая версия в выдаче хуже её отсутствия.
 *
 * Navbar остаётся английским: русских маршрутов, кроме этого, нет, и
 * русская подпись поверх английских адресов была бы обещанием перевода,
 * которого не существует.
 */
import PageShell from '../../layouts/PageShell.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProseBlock from '../../components/ProseBlock.astro';
import TextLink from '../../components/TextLink.astro';
import { ru } from '../../copy/service.ts';
---

<PageShell
  title={ru.meta.title}
  description={ru.meta.description}
  lang={ru.lang}
  noindex
  contactHeading={ru.contact.heading}
  contactLead={ru.contact.lead}
  contactCopy={ru.contact}
>
  {/*
    Один каскад из трёх участников, как на /about: заголовок и ведущий
    абзац — Набор, тело — opacity целым блоком.
  */}
  <section class="ds-container ds-section intro" data-motion-group data-motion-stagger="tight">
    <SectionHead as="h1" size="lg" eyebrow={ru.eyebrow} class="intro__heading">
      {ru.heading}
    </SectionHead>

    <ProseBlock variant="lead" class="intro__lead">
      <p>{ru.lead}</p>
    </ProseBlock>

    <ProseBlock class="intro__body">
      {ru.body.map((paragraph) => <p>{paragraph}</p>)}
    </ProseBlock>
  </section>

  {/*
    Право на работу отдельным блоком, как на /about: сюда приходят за
    ответом на формальный фильтр, и он не должен теряться в теле текста.
  */}
  <section class="ds-container ds-section authorization">
    <SectionHead as="h2" size="sm" class="authorization__heading">
      {ru.authorization.heading}
    </SectionHead>

    <ProseBlock>
      <p>{ru.authorization.body}</p>
    </ProseBlock>
  </section>

  {/*
    Ссылка на английскую версию — после текста, а не первой строкой:
    сначала ответы, потом выбор. Первой строкой она читалась бы как
    «вам сюда нельзя».
  */}
  <section class="ds-container english">
    <TextLink href={ru.toEnglish.href} type="arrow">{ru.toEnglish.label}</TextLink>
  </section>
</PageShell>

<style>
  /* :global обязателен: корни SectionHead и ProseBlock несут собственный
     data-astro-cid (ds/components.md §Реализация). */
  .intro > :global(.intro__heading) {
    margin-bottom: var(--space-8);
  }

  .intro > :global(.intro__lead) {
    margin-bottom: var(--space-12);
  }

  .authorization > :global(.authorization__heading) {
    margin-bottom: var(--space-6);
  }

  .english {
    padding-block: var(--space-8);
  }
</style>
