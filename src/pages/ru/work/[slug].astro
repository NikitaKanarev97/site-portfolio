---
import CasePage from '../../work/[slug].astro';
import { casesRu } from '../../../copy/ru/cases/index.ts';

export function getStaticPaths() {
  return casesRu.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<CasePage entry={entry} locale="ru" />
