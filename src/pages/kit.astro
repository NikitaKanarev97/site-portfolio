---
/**
 * Витрина компонентов — Site-portfolio, маршрут /kit
 *
 * Это НЕ главная страница продукта: маршрут / занят Home. Витрина съехала
 * с корня 2026-08-24, при переходе к сборке финальных экранов — экраны
 * собираются боевыми маршрутами, а не песочницей, и корень принадлежит
 * продукту. Здесь каждый из одиннадцати компонентов
 * каталога показан во всех вариантах — поверхность визуального QA
 * после переноса ДС в код, замена Storybook, который на статичном
 * каталоге не окупается (ds/motion-concept.md §2).
 *
 * Четыре компонента и два варианта добавлены расширением каталога
 * 2026-08-24: ProseBlock, NoteBlock, DecisionBlock, Footer,
 * MetaList layout=statements, CopyEmail appearance.
 *
 * Diagram — четыре вида нотации, 2026-10-03 (PLAN-CHATS.md, этап 1).
 * Каждый образец дважды: светлая тема на EN и тёмная на RU, чтобы обе
 * темы и обе локали проверялись одним проходом.
 *
 * Модули страницы кейса — 2026-10-03 (PLAN-CHATS.md, этап 2, карта
 * ds/screens/case.md): демо-кейс целиком на варианте обложки «видео» и
 * тёмной плашке, затем три обложки «экран на цвете» со светлой плашкой.
 * Демо-кейс помечен data-h="case" — по нему scripts/harmony-check.mjs
 * считает бюджет слов.
 *
 * Содержимое — заглушки. Ни одна строка отсюда в продукт не переносится.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ScreenStack from '../components/ScreenStack.astro';
import MediaZoom from '../components/MediaZoom.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import MetaList from '../components/MetaList.astro';
import SectionHead from '../components/SectionHead.astro';
import TextLink from '../components/TextLink.astro';
import WorkRow from '../components/WorkRow.astro';
import ProseBlock from '../components/ProseBlock.astro';
import NoteBlock from '../components/NoteBlock.astro';
import DecisionBlock from '../components/DecisionBlock.astro';
import Footer from '../components/Footer.astro';
import Diagram from '../components/Diagram.astro';
import CaseSpecimen from '../components/CaseSpecimen.astro';
import { portalSpecimen } from '../copy/common/partner-portal';
import { portalMap } from '../data/diagrams/common/portal-map';
import { portalFlow } from '../data/diagrams/common/portal-flow';
import diagramMap from '../data/diagrams/kit/map.ts';
import diagramFlow from '../data/diagrams/kit/flow.ts';
import diagramPrototype from '../data/diagrams/kit/prototype.ts';
import diagramLibrary from '../data/diagrams/kit/library.ts';
import CaseCover from '../components/CaseCover.astro';
import { agentOpsPilot } from '../copy/pilot/agent-ops';
import CaseSheet from '../components/CaseSheet.astro';
import CaseThesis from '../components/CaseThesis.astro';
import CaseNumbers from '../components/CaseNumbers.astro';
import CaseArtifact from '../components/CaseArtifact.astro';
import CaseCallout from '../components/CaseCallout.astro';
import CaseShot from '../components/CaseShot.astro';
import CaseCarousel from '../components/CaseCarousel.astro';
import CaseSteps from '../components/CaseSteps.astro';
import CaseImpact from '../components/CaseImpact.astro';
import CaseNext from '../components/CaseNext.astro';
import { kitStory as story, kitCovers } from '../copy/kit-case.ts';
/* Кадры стопки берутся из продуктового слоя текстов, а не копируются сюда
   третьим списком: витрина обязана показывать ровно то, что стоит на
   главной, иначе она перестаёт быть поверхностью QA. */
import { home } from '../copy/home.ts';

const works = [
  {
    title: 'Vet Clinic OS',
    type: 'Внутренний продукт',
    year: '2024',
    role: 'Product designer',
    description: ['Первая строка описания проекта.', 'Вторая строка описания проекта.'],
    reason: 'Кейс не раскрыт: результаты закрыты соглашением.',
  },
  {
    title: 'Pawly',
    type: 'Мобильное приложение',
    year: '2023',
    role: 'Product designer',
    description: ['Первая строка описания проекта.', 'Вторая строка описания проекта.'],
    reason: 'Кейс не раскрыт: продукт не дошёл до релиза.',
  },
  {
    title: 'Ruun',
    type: 'Веб-сервис',
    year: '2023',
    role: 'Product designer',
    description: ['Первая строка описания проекта.', 'Вторая строка описания проекта.'],
    reason: 'Кейс не раскрыт: роль ограничена одним этапом.',
  },
];

const compromise = [
  {
    term: 'Solved',
    value:
      'Повторные заказы проходят без менеджера. Коммерческий отдел перестал быть узким местом рутинных закупок.',
  },
  {
    term: 'Sacrificed',
    value:
      'Возвраты остались частично ручными, а публичный каталог потерял цены и поисковый трафик вместе с ними.',
  },
  {
    term: 'Почему цена правильная',
    value:
      'Оба отреза защищают то, что интерфейс не гарантирует сам: условие договора и складскую проверку, которой не существует.',
  },
  {
    term: 'Что изменилось в подходе',
    value:
      'Сначала читаю данные, которые система уже производит, и только потом бриф. Журнал заказов сказал о задаче больше, чем кикофф.',
  },
];

const decisions = [
  {
    decision: 'Персональные цены видны только после входа, в публичном каталоге — никогда.',
    why: 'Контрактное условие: цена партнёра — часть его договора, публичный показ ломает договорённости самого клиента.',
    cost: 'Публичный каталог перестал быть точкой входа, SEO-трафик на него потерян сознательно.',
  },
  {
    decision: 'Легаси-артикулы остались на экране рядом с человеческими названиями.',
    why: 'Партнёры ищут по кодам: в журнале заказов поиск по артикулу встречался чаще, чем по названию. Это их рабочий язык, а не наследие системы.',
    cost: 'Интерфейс выглядит плотнее и техничнее, чем хотел клиент.',
  },
];

const caseMeta = [
  { term: 'Role', value: 'Product designer' },
  { term: 'Year', value: '2024' },
  { term: 'Platform', value: 'Web' },
  { term: 'Type', value: 'B2B-портал' },
];
---

<BaseLayout
  title="Витрина компонентов — Site-portfolio"
  description="Семь компонентов дизайн-системы во всех вариантах: поверхность визуального QA."
  lang="ru"
  current="/"
  noindex
>
  <section class="ds-container ds-section" data-motion-intro>
    <p class="ds-meta-xs kit__eyebrow ds-flow-eyebrow" data-motion="fade" data-motion-at="0">Витрина компонентов</p>
    <h1 class="ds-display-6xl kit__h1 ds-flow-heading" data-motion="reveal-text">Набор, раскрытие, строка</h1>
    <p class="ds-body-lg kit__lead" data-motion="reveal-text">
      Вступительный такт: заголовок идёт первым, следующие строки подхватывают каскад с шагом
      stagger-base.
    </p>
    <p class="ds-body-base kit__lead" data-motion="reveal-text">
      Третья строка того же каскада — проверка того, что порядок читается сверху вниз.
    </p>
    <p class="ds-body-base kit__row" data-motion="fade" data-motion-at="0.4">
      Ряд действий приходит одной opacity на +400 мс: <TextLink href="/#work" type="arrow"
        >К перечню работ</TextLink
      >
    </p>
  </section>

  <section class="ds-container ds-section" id="work">
    <SectionHead eyebrow="SectionHead · size=lg" size="lg">Перечень работ</SectionHead>
    <ul class="kit__works" data-motion-group data-motion-stagger="base">
      {works.map((work) => <WorkRow {...work} />)}
    </ul>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MediaFrame · ratio=wide" size="lg">Раскрытие с контр-масштабом</SectionHead>
    <MediaFrame src="/media/placeholder-wide.svg" alt="" ratio="wide">
      <Fragment slot="caption">Полный такт 700 мс: обложка featured-кейса</Fragment>
    </MediaFrame>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MediaFrame · framed" size="sm">Подложка вокруг реального скриншота</SectionHead>
    <MediaFrame src="/media/placeholder-wide.svg" alt="" framed>
      <Fragment slot="caption">
        16/10 держит рамка: поля space-8 / space-12, обводка border-default, тень shadow-md
      </Fragment>
    </MediaFrame>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MediaFrame · ratio=natural + zoom" size="sm">Кадр в собственном соотношении</SectionHead>
    <MediaFrame src={home.featured.items[0].cover[0]} alt="Кадр экрана в собственном соотношении" ratio="natural" zoom />
    <p class="ds-meta-sm kit__note">
      Соотношение читается из файла на сборке, кадр не режется и не растягивается крупнее
      исходника. Нажатие открывает его в полный размер — MediaZoom, один диалог на маршрут.
    </p>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="ProjectDialog" size="sm">Разбор работы в модальном окне</SectionHead>
    <button class="ds-pressable kit__dialog-trigger" type="button" data-dialog-open="kit-project">
      Открыть разбор
    </button>
    <p class="ds-meta-sm kit__note">
      Нативный dialog с showModal(): ловушка фокуса, Escape, возврат фокуса на кнопку и inert
      на остальной странице приходят от платформы. Ниже bp-md одна колонка, кадр первым.
    </p>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="ScreenStack · паттерн" size="sm">Обложка-стопка из трёх кадров</SectionHead>
    <ScreenStack screens={home.featured.items[0].cover} alt="" />
    <p class="ds-meta-sm kit__note">
      Сдвиг вправо-вниз на шаг и два шага, каждый следующий слой у́же и приглушённее.
      Ни поворота, ни перспективы, ни тени — глубину держат сдвиг, обводка и opacity.
    </p>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MediaFrame · ratio=portrait" size="sm">Раскрытие без контр-масштаба</SectionHead>
    <div class="kit__portrait">
      <MediaFrame
        src="/media/placeholder-portrait.svg"
        alt=""
        ratio="portrait"
        counterScale={false}
      >
        <Fragment slot="caption">Медиа внутри кейса: тот же токен, без контр-масштаба</Fragment>
      </MediaFrame>
    </div>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MediaFrame · каскад" size="sm">Четыре сборки, stagger-tight</SectionHead>
    <div class="kit__strip" data-motion-group data-motion-stagger="tight">
      {
        ['Common', 'Synk', 'Scrib3', 'Bloomblex'].map((name) => (
          <article class="kit__card">
            <MediaFrame
              src="/media/placeholder-wide.svg"
              alt=""
              ratio="wide"
              counterScale={false}
            />
            <h3 class="ds-heading-xl kit__card-title">{name}</h3>
            <MetaList
              layout="stacked"
              items={[{ term: 'Role', value: 'Webflow development', tone: 'strong' }]}
            />
            <TextLink href="https://example.com" type="arrow" external>
              Открыть сайт
            </TextLink>
          </article>
        ))
      }
    </div>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MetaList · layout=inline" size="sm">Шапка кейса</SectionHead>
    <MetaList items={caseMeta} layout="inline" />
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="TextLink · три типа" size="sm">Строка</SectionHead>
    <div class="kit__links" data-motion="fade">
      <p class="ds-body-base">
        Ссылка <TextLink href="/about">внутри текста</TextLink> — постоянное подчёркивание, цвет
        не единственный различитель.
      </p>
      <p class="ds-body-base">
        <TextLink href="/about" type="arrow">Переход к кейсу</TextLink>
      </p>
      <p class="ds-body-base">
        <TextLink href="https://example.com" type="nav" external>Внешняя ссылка</TextLink>
      </p>
    </div>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="ProseBlock · variant=lead" size="sm">Ведущий абзац</SectionHead>
    <ProseBlock variant="lead">
      <p>
        Одна мысль о подходе на ведущей мере: колонка ограничена measure-lead, кегль —
        ds-heading-2xl. Ниже 1024 px ступень едет сама, правило живёт в tokens.css.
      </p>
    </ProseBlock>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="ProseBlock · variant=body" size="sm">Тело блока</SectionHead>
    <ProseBlock>
      <p>
        Основная колонка чтения: measure-text, ds-body-lg. Мера ставится на колонку, а не на
        секцию — секция держит контейнер и поля, мера отвечает только за длину строки.
      </p>
      <p>
        Второй абзац проверяет ритм: между абзацами flow-text, и это единственное, за что
        компонент отвечает помимо меры. Всё остальное — роли из tokens.css.
      </p>
    </ProseBlock>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="NoteBlock · три варианта" size="sm">Вынутое из потока</SectionHead>
    <div class="kit__notes">
      <NoteBlock variant="emphasis">
        Партнёры заказывают сами — поверх легаси-системы, которую нельзя было заменить.
      </NoteBlock>

      <NoteBlock variant="flagged" label="Не в продакшене — как я собрал бы это сейчас">
        <p>
          Блок переработки: рамка, заливка surface-subtle и метка сверху. Метка — часть текста,
          а не только рамка: выделение цветом ничего не сообщает скринридеру.
        </p>
      </NoteBlock>

      <NoteBlock variant="muted">
        Цифры проекта закрыты NDA и не публикуются. Выше — компромисс целиком, и это та часть,
        которую можно показать.
      </NoteBlock>
    </div>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="DecisionBlock · со слотом и без" size="sm">Решения и их цена</SectionHead>
    <div class="kit__decisions" data-motion-group data-motion-stagger="base">
      <DecisionBlock {...decisions[0]}>
        <MediaFrame slot="artifact" src="/media/placeholder-wide.svg" alt="" ratio="wide" counterScale={false} />
      </DecisionBlock>
      <DecisionBlock {...decisions[1]} />
    </div>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="MetaList · layout=statements" size="sm">Четыре строки компромисса</SectionHead>
    <div class="kit__compromise" data-motion-group data-motion-stagger="base">
      <MetaList items={compromise} layout="statements" />
      <NoteBlock variant="muted">
        Строка NDA идёт последней строкой того же каскада — ds/motion-concept.md §7.
      </NoteBlock>
    </div>
  </section>

  <section class="ds-container ds-section" id="contact">
    <SectionHead eyebrow="CopyEmail · appearance=address" size="sm">Контакт</SectionHead>
    <div data-motion="fade">
      <CopyEmail email="hello@example.com" />
    </div>
  </section>

  <section class="ds-container ds-section">
    <SectionHead eyebrow="CopyEmail · appearance=action" size="sm">Ряд действий</SectionHead>
    <div class="kit__actions" data-motion="fade">
      <TextLink href="/work/partner-portal" type="arrow">Читать кейс: B2B Partner Portal</TextLink>
      <TextLink href="/cv.pdf">Скачать CV (PDF)</TextLink>
      <CopyEmail email="hello@example.com" appearance="action" />
    </div>
  </section>

  <section class="ds-container ds-section" id="common-contract">
    <SectionHead eyebrow="CaseStory · ordered blocks" size="sm">Разные истории, один контракт</SectionHead>
    <p class="ds-body-lg">Стабильные id, evidence/media, разрешённые motion variants. EN/RU — одинаковая структура. <a class="ds-link" href="/preview/common/">Открыть пару preview</a></p>
    <CaseArtifact artifact={{data:portalMap,caption:'HA-MAP-01 · editorial Portal MVP selection'}} />
    <CaseArtifact artifact={{data:portalFlow,caption:'HA-FLOW-01 · actual conditions, editorial geometry'}} />
    <CaseSpecimen specimen={portalSpecimen('en')} />
    <CaseImpact outcome={{result:{label:'Outcome',thesis:'The commercial redesign shipped'},evidence:{label:'Evidence',text:'Owner-confirmed delivery of the original commercial work.'},tradeoff:{label:'Trade-off',text:'Buyers resolve ambiguity manually; business results remain confidential.'}}} />
  </section>

  <section class="ds-container ds-section" id="diagram-map">
    <SectionHead eyebrow="Diagram · kind=map" size="sm">Карта экранов</SectionHead>
    <Diagram data={diagramMap} lang="en" />
    <div class="kit__dark" data-theme="dark">
      <Diagram data={diagramMap} lang="ru" />
    </div>
  </section>

  <section class="ds-container ds-section" id="diagram-flow">
    <SectionHead eyebrow="Diagram · kind=flow" size="sm">User flow с ромбами и бледным префиксом</SectionHead>
    <Diagram data={diagramFlow} lang="en" />
    <div class="kit__dark" data-theme="dark">
      <Diagram data={diagramFlow} lang="ru" />
    </div>
  </section>

  <section class="ds-container ds-section" id="diagram-prototype">
    <SectionHead eyebrow="Diagram · kind=prototype" size="sm">Карта прототипа</SectionHead>
    <Diagram data={diagramPrototype} lang="en" />
    <div class="kit__dark" data-theme="dark">
      <Diagram data={diagramPrototype} lang="ru" />
    </div>
  </section>

  <section class="ds-container ds-section" id="diagram-library">
    <SectionHead eyebrow="Diagram · kind=library" size="sm">Лист библиотеки компонентов</SectionHead>
    <Diagram data={diagramLibrary} lang="en" />
    <div class="kit__dark" data-theme="dark">
      <Diagram data={diagramLibrary} lang="ru" />
    </div>
  </section>

  <section class="ds-container ds-section" id="case-modules">
    <SectionHead eyebrow="Модули кейса · ds/screens/case.md" size="sm">Страница кейса из 10 блоков</SectionHead>
    <p class="kit__lead ds-body-lg">
      Ниже демо-кейс целиком: обложка «видео», белый лист, блоки 02–09 на тёмной плашке и переход к
      следующему кейсу. За ним три обложки «экран на цвете» — по одной на раскладку — со светлой плашкой.
    </p>
  </section>

  <CaseCover theme={agentOpsPilot.theme} title={agentOpsPilot.cover.title} outcome={agentOpsPilot.cover.outcome} media={agentOpsPilot.cover.media} as="h2" />

  <div class="kit-case" data-h="case" id="case-demo">
    <CaseCover
      theme={story.theme}
      title={story.cover.title}
      outcome={story.cover.outcome}
      media={story.cover.media}
      as="h2"
      pauseLabel="Остановить ролик"
      playLabel="Запустить ролик"
    />
    <CaseSheet>
      <div class="ds-container">
        <MetaList layout="facts" items={story.facts} />
      </div>

      <section class="ds-container ds-section" aria-label="02 Задача">
        <CaseThesis label={story.challenge.label} thesis={story.challenge.thesis} body={story.challenge.body} />
        <CaseNumbers items={story.challenge.numbers} />
      </section>

      <section class="ds-container ds-section" aria-label="03 Как устроено">
        <CaseThesis label={story.system.label} thesis={story.system.thesis} body={story.system.body} />
        {story.system.diagrams.map((artifact) => (
          <CaseArtifact artifact={artifact} tone={story.plate} lang="ru" />
        ))}
      </section>

      <section class="ds-container ds-section" aria-label="04 Было и стало">
        <CaseThesis label={story.before.label} thesis={story.before.thesis} body={story.before.body} />
        <CaseCallout callout={story.before.issue} tone="issue" plate={story.plate} />
        <CaseShot shot={story.before.after} tone={story.plate} />
      </section>

      <section class="ds-container ds-section" aria-label="05 Процесс">
        <CaseThesis label={story.process.label} thesis={story.process.thesis} body={story.process.body} />
        <CaseCarousel
          slides={story.process.slides}
          captions={story.process.captions}
          label="Артефакты процесса"
          prevLabel="Предыдущий артефакт"
          nextLabel="Следующий артефакт"
          tone={story.plate}
          lang="ru"
        />
      </section>

      <section class="ds-container ds-section" aria-label="06 Продукт по шагам">
        <CaseSteps label={story.steps.label} items={story.steps.items} tone={story.plate} />
      </section>

      <section class="ds-container ds-section" aria-label="07 Телефон">
        <CaseThesis label={story.moments.label} thesis={story.moments.thesis} body={story.moments.body} />
        <CaseShot shot={story.moments.shot} tone={story.plate} />
      </section>

      <section class="ds-container ds-section" aria-label="08 Детали и система">
        <CaseThesis label={story.details.label} thesis={story.details.thesis} body={story.details.body} />
        <CaseCallout callout={story.details.callout} plate={story.plate} />
        <CaseArtifact artifact={story.details.library} tone={story.plate} lang="ru" />
      </section>

      <section class="ds-container ds-section" aria-label="09 Итог">
        <CaseThesis label={story.result.label} thesis={story.result.thesis} />
        <CaseImpact cards={story.result.cards} quote={story.result.quote} cost={story.result.cost} />
      </section>
    </CaseSheet>
    <CaseNext
      href="/preview/partner-portal-pilot/"
      transitionKey="case-portal"
      title="Partner Portal"
      theme="portal"
      label="Следующий кейс"
      prototype={story.prototype}
    />
  </div>

  {
    kitCovers.map((cover) => (
      <div class="kit-case">
        <CaseCover theme={cover.theme} title={cover.title} outcome={cover.outcome} media={cover.media} as="h2" />
        <CaseSheet>
          <div class="ds-container">
            <MetaList layout="facts" items={story.facts.slice(0, 4)} />
          </div>
          <div class="ds-container">
            <CaseShot shot={cover.shot} />
          </div>
        </CaseSheet>
      </div>
    ))
  }

  {/* Footer стоит внутри main только здесь: витрина показывает компонент,
      на экранах продукта он живёт под main. */}
  <section class="ds-container ds-section">
    <SectionHead eyebrow="Footer · локальное время" size="sm">Подвал</SectionHead>
  </section>
  <Footer location="Armenia" utcLabel="UTC+4" timeZone="Asia/Yerevan" copyright="© 2026" />

  {/* MediaZoom — один узел на маршрут, здесь он обслуживает кадр выше. */}
  <ProjectDialog
    id="kit-project"
    title="Заглушка"
    lead="Одна строка сути: что это за работа и для кого."
    body="Два-три предложения о том, в чём была работа. Ни одна строка витрины в продукт не переносится — содержимое здесь заглушечное."
    meta={[
      { term: 'Role', value: 'Design and build', tone: 'strong' },
      { term: 'Stack', value: 'Webflow · GSAP · Client-First' },
    ]}
    media={{ src: home.featured.items[0].cover[0], alt: 'Кадр заглушки' }}
    action={{ href: 'https://example.com', label: 'Live site' }}
    closeLabel="Закрыть"
  />

  <MediaZoom />
</BaseLayout>

<style>
  /* Тёмный образец диаграммы: тема кейса задаётся атрибутом на предке. */
  .kit__dark {
    padding: var(--space-6);
    background: var(--surface-inverse);
  }

  /* Витрина идёт на той же шкале, что продукт: eyebrow и заголовок несут
     ds-flow-eyebrow и ds-flow-heading, остальные промежутки — умолчание
     секции. Иначе поверхность визуального QA расходится с тем, что она
     проверяет. */
  .kit__eyebrow {
    color: var(--text-meta);
  }

  .kit__h1 {
    color: var(--text-default);
  }

  .kit__lead {
    color: var(--text-subtle);
    max-width: var(--measure-text);
  }

  /* Первая строка после заголовка идёт узловым шагом, вторая — текстовым:
     это один абзац за другим, а не два узла. */
  .kit__lead + .kit__lead {
    margin-block-start: var(--flow-text);
  }

  .kit__row {
    color: var(--text-subtle);
  }

  .kit__works {
    display: block;
  }

  /* То же ограничение, что у паттерна AboutPortrait на /about: половина
     колонки чтения. Витрина обязана показывать продуктовую ширину, иначе
     поверхность QA расходится с продуктом. */
  .kit__portrait {
    max-width: calc(var(--measure-text) / 2);
  }

  .kit__strip {
    display: grid;
    gap: var(--flow-node);
  }

  .kit__card {
    display: flex;
    flex-direction: column;
    gap: var(--flow-pair);
    align-items: flex-start;
  }

  .kit__card-title {
    color: var(--text-default);
  }

  .kit__note {
    color: var(--text-meta);
    margin-block-start: var(--flow-text);
  }

  /* Кнопка витрины: в продукте разбор открывает карточка DevelopmentStrip,
     здесь носителя нет — нужна отдельная цель. Вид у неё служебный. */
  .kit__dialog-trigger {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-12);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--border-default);
    background: var(--surface-subtle);
    font: inherit;
    color: var(--text-default);
    cursor: pointer;
  }

  .kit__notes,
  .kit__decisions,
  .kit__compromise {
    display: flex;
    flex-direction: column;
    gap: var(--flow-group);
  }

  .kit__compromise {
    gap: var(--flow-node);
  }

  .kit__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  @media (--bp-md) {
    .kit__actions {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-8);
    }
  }

  .kit__links {
    display: flex;
    flex-direction: column;
    gap: var(--flow-text);
    color: var(--text-subtle);
  }

  @media (--bp-md) {
    .kit__strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (--bp-lg) {
    .kit__strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gutter);
    }
  }
</style>
