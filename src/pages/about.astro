---
/** About — ds/patterns.md §AboutChapters; facts remain in localized copy. */
import PageShell from '../layouts/PageShell.astro';
import AuthorPortrait from '../components/AuthorPortrait.astro';
import ProseBlock from '../components/ProseBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import IconArrow from '../components/IconArrow.astro';
import { about as aboutEn } from '../copy/about.ts';
import { aboutRu } from '../copy/ru/about.ts';
import { site as siteEn, type SiteCopy } from '../copy/site.ts';
import { siteRu } from '../copy/ru/site.ts';

interface Props { locale?: 'en' | 'ru'; }
const { locale = 'en' } = Astro.props;
const about = locale === 'ru' ? aboutRu : aboutEn;
const site: SiteCopy = locale === 'ru' ? siteRu : siteEn;
const chapters = [
  { id: 'approach', heading: about.approach.heading, body: [about.intro.principle] },
  ...(about.authorization ? [{ id: 'authorization', heading: about.authorization.heading, body: [about.authorization.body] }] : []),
  { id: 'evidence', heading: about.evidence.heading, body: about.evidence.body },
  { id: 'ai', heading: about.ai.heading, body: about.ai.body },
];
---

<PageShell title={about.meta.title} description={about.meta.description}
  ogCard={locale === 'ru' ? 'about-ru' : 'about'}
  current={locale === 'ru' ? '/ru/about' : '/about'}
  contactLead={about.contactLead} lang={locale} siteCopy={site}>
  <section class="ds-container intro" data-motion-group data-motion-stagger="tight">
    <p class="ds-meta-sm intro__meta" data-motion="fade">
      <span>{site.brand}</span><span>{about.intro.heading}</span>
    </p>
    <h1 class="ds-display-6xl intro__heading">
      {about.intro.headline.map(line => <span data-motion="reveal-text">{line}</span>)}
    </h1>
    <nav class="chapter-index" aria-label={about.contentsLabel} style={`--about-chapter-count: ${chapters.length}`}>
      {chapters.map((chapter, index) => <a href={`#${chapter.id}`} class="ds-body-sm">
        {about.chapterLabels[index]}<span aria-hidden="true"><IconArrow direction="down" /></span>
      </a>)}
    </nav>
    <AuthorPortrait src={about.portrait.src} srcMobile={about.portrait.srcMobile} alt={about.portrait.alt}
      lines={about.profile.headline} action={{ href: about.profile.cvHref, label: about.profile.cv }}
      class="intro__profile" />
    <ProseBlock variant="lead" class="intro__lead"><p>{about.intro.lead}</p></ProseBlock>
  </section>

  {chapters.map(chapter => <section id={chapter.id} class="ds-container chapter" data-motion="fade">
    <div class="chapter__head">
      <SectionHead size="lg" reveal={false}>{chapter.heading}</SectionHead>
    </div>
    <ProseBlock motion={false} class="chapter__body">
      {chapter.body.map(paragraph => <p>{paragraph}</p>)}
    </ProseBlock>
  </section>)}
</PageShell>

<style>
  :global(main:has(> .intro)) { padding-block-start: var(--flow-text); }
  .intro { display: grid; gap: var(--space-4); }
  .intro > :global(*) { margin-block-start: 0; }
  .intro__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-4); color: var(--text-meta); }
  .intro__heading { color: var(--text-default); }
  .intro__heading > span { display: block; }
  .intro__heading > span:last-child { color: var(--text-link); }
  .chapter-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-4); border-block: var(--border-width) solid var(--border-default); }
  .chapter-index a { display: flex; align-items: center; gap: var(--space-2); min-block-size: var(--space-12); color: var(--text-default); text-decoration: none; }
  .chapter-index a > span:last-child { margin-inline-start: auto; }
  .chapter-index a:active { color: var(--text-link-pressed); }
  .chapter { display: grid; gap: var(--flow-node); padding-block-start: var(--flow-group); position: relative; }
  .chapter::before { content: ''; position: absolute; inset-block-start: 0; inset-inline: var(--margin-sm); border-block-start: var(--border-width) solid var(--border-default); }
  .chapter__head { display: grid; align-content: start; gap: var(--flow-text); }
  .chapter__head > :global(*) { margin-block-start: 0; }
  @media (--can-hover) { .chapter-index a:hover { color: var(--text-link-hover); } }
  @media (--bp-md) {
    .chapter-index { grid-template-columns: repeat(var(--about-chapter-count), minmax(0, 1fr)); gap: var(--space-4); }
    .chapter::before { inset-inline: var(--margin-md); }
  }
  @media (--bp-lg) {
    .intro { grid-template-columns: 4fr 6fr; gap: var(--space-6) var(--space-16); }
    .intro__meta, .intro__heading, .chapter-index { grid-column: 1 / -1; }
    .intro__heading { padding-block: var(--space-4); font-size: var(--size-5xl); }
    .intro__heading > span:last-child { text-align: right; }
    .intro > :global(.intro__lead) { grid-column: 1; grid-row: 4; }
    .intro > :global(.intro__profile) { grid-column: 2; grid-row: 4; align-self: start; }
    .chapter { grid-template-columns: 4fr 6fr; column-gap: var(--space-16); }
    .chapter::before { inset-inline: var(--margin-lg); }
  }
  @media (--bp-xl) { .intro__heading { font-size: var(--size-6xl); } }
</style>
