---
/**
 * About — Site-portfolio, маршрут /about
 *
 * Composition map: ds/screens/about.md, редакция 2, апрувнута 2026-08-24.
 * Вайрфрейм: ia/wireframes/about.md. Блок авторизации — дословно из
 * ia/authorization-copy.md, решение владельца №1.
 *
 * Экран не изобретает сущностей: всё из каталога ds/components.md и
 * паттернов ds/patterns.md. Тексты — src/copy/about.ts, сквозные —
 * src/copy/site.ts. Оболочка, ContactBlock и Footer — PageShell.
 *
 * Портрет — часть вступления: рядом с тезисом на desktop, между лидом
 * и подробным примером на mobile. Право на работу идёт после вступления.
 *
 * Движение — карта ds/motion-concept.md §7. Вступительного такта на этом
 * маршруте нет вовсе: он живёт только на Hero главной (§5, §7), прямой
 * вход отдаёт конечное состояние. Анимаций здесь нет — экран объявляет
 * движение атрибутами.
 */
import PageShell from '../layouts/PageShell.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProseBlock from '../components/ProseBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import { about as aboutEn } from '../copy/about.ts';
import { aboutRu } from '../copy/ru/about.ts';
import { site as siteEn, type SiteCopy } from '../copy/site.ts';
import { siteRu } from '../copy/ru/site.ts';

interface Props {
  locale?: 'en' | 'ru';
}

const { locale = 'en' } = Astro.props;
const about = locale === 'ru' ? aboutRu : aboutEn;
const site: SiteCopy = locale === 'ru' ? siteRu : siteEn;
---

<PageShell
  title={about.meta.title}
  description={about.meta.description}
  ogCard={locale === 'ru' ? 'about-ru' : 'about'}
  current={locale === 'ru' ? '/ru/about' : '/about'}
  contactLead={about.contactLead}
  lang={locale}
  siteCopy={site}
>
  {/* AboutIntro: лицо и подход видны вместе; пример следует за лидом. */}
  <section class="ds-container intro" data-motion-group data-motion-stagger="tight">
    <div class="ds-section intro__copy">
      <h1 class="ds-heading-4xl intro__heading ds-flow-heading" data-motion="reveal-text">
        {about.intro.heading}
      </h1>

      <ProseBlock variant="lead" class="intro__lead">
        <p>{about.intro.lead}</p>
      </ProseBlock>
    </div>

    <MediaFrame
      src={about.portrait.src}
      alt={about.portrait.alt}
      ratio="portrait"
      loading="eager"
      counterScale={false}
      reveal={false}
      class="intro__portrait"
    />

    <ProseBlock class="intro__body">
      <p>{about.intro.principle}</p>
    </ProseBlock>
  </section>

  {/*
    Здесь место AboutExperience — годы практики и тип опыта (SCR-05).
    Блок ждёт решения владельца №3 (ia/open-questions.md §3) и в v1 не
    рисуется, а не рисуется пустым. Место именно тут, а не ниже: годы
    практики отвечают на тот же формальный фильтр, что и право на работу,
    и читаются одним заходом. Когда решение будет «указывать» — сюда
    встаёт SectionHead size="sm" + ProseBlock, всё ниже сдвигается,
    порядок блоков не меняется.
  */}

  {/*
    AboutAuthorization. Текст дословно из ia/authorization-copy.md: порядок
    фактов внутри абзаца зафиксирован, подача — одна траектория, а не
    перечисление вариантов через «или». NoteBlock здесь не стоит намеренно:
    рамка и метка читаются как оговорка, а это не оговорка, а факт.
  */}
  {about.authorization && <section class="ds-container ds-section authorization" data-motion-group data-motion-stagger="tight">
    <SectionHead size="lg">{about.authorization.heading}</SectionHead>

    <ProseBlock>
      <p>{about.authorization.body}</p>
    </ProseBlock>
  </section>}

  {/*
    AboutEvidence. Два абзаца про ошибки и измерение вынесены из Intro:
    это один смысловой блок о том, какие утверждения автор готов защищать.
    Перенос не добавляет фактов и делает формальный фильтр доступным раньше.
  */}
  <section class="ds-container ds-section evidence" data-motion-group data-motion-stagger="tight">
    <SectionHead size="lg">{about.evidence.heading}</SectionHead>

    <ProseBlock>
      {about.evidence.body.map((paragraph) => <p>{paragraph}</p>)}
    </ProseBlock>
  </section>

  {/*
    AboutAI. Блок фактический, а не декларативный: названные этапы
    проверяемы, «использую ИИ как инструмент» — заполнитель. Позиции «за»
    или «против» нет ни в одном абзаце.
  */}
  <section class="ds-container ds-section ai" data-motion-group data-motion-stagger="tight">
    <SectionHead size="lg">{about.ai.heading}</SectionHead>

    <ProseBlock>
      {about.ai.body.map((paragraph) => <p>{paragraph}</p>)}
    </ProseBlock>
  </section>
</PageShell>

<style>
  /* ---------------------------------------------------------------- *
   * AboutIntro — текст                                                *
   * ---------------------------------------------------------------- */

  .intro__heading {
    color: var(--text-default);
  }

  .intro {
    display: grid;
    gap: var(--flow-group);
    grid-template-areas: 'copy' 'portrait' 'body';
  }

  .intro__copy { grid-area: copy; min-inline-size: 0; }
  .intro > :global(.intro__portrait) { grid-area: portrait; }
  .intro > :global(.intro__body) { grid-area: body; }

  @media (--bp-md) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, calc(var(--measure-text) / 2 - var(--space-16)));
      grid-template-areas: 'copy portrait' 'body portrait';
      column-gap: var(--space-12);
      align-items: start;
      align-content: start;
    }
  }

  @media (--bp-lg) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, calc(var(--measure-text) / 2));
      column-gap: var(--space-16);
    }
  }

  /* ---------------------------------------------------------------- *
   * AboutAuthorization, AboutEvidence и AboutAI                       *
   * ---------------------------------------------------------------- */

  /* Три блока — заголовок и колонка текста, одинаковая пара. Шаг между
     ними задаёт ds-flow-heading, и он тот же, что в шапке кейса и на
     главной: с 2026-08-24 у пары «заголовок → тело» одно значение на
     весь продукт. */
</style>
