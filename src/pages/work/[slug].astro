---
/**
 * Страница кейса — маршрут /work/<slug>
 *
 * Composition map: ds/screens/case-dssl.md. Вайрфрейм: ia/wireframes/case-dssl.md.
 * Тексты — src/copy/cases/<slug>.ts, реестр — src/copy/cases/index.ts.
 *
 * Шаблон с первого кейса, а не после второго (US-20, IA-02): новый кейс
 * добавляется файлом и строкой в реестре, эта страница не меняется.
 *
 * Три ограничения, которые держат экран:
 *   1. Самодостаточен как точка входа (CASE-17). Половина читателей
 *      приходит прямой ссылкой и главную не видит. Хлебной крошки
 *      «назад на главную» нет — назад им некуда.
 *   2. Шапка читается за 5 секунд (US-07): исход стоит в ней, не в конце.
 *   3. Заголовки — утверждения (CASE-14). Пересказ по заголовкам и
 *      подписям обязан собираться без чтения тел.
 *
 * Блок CaseRework отсутствует: решение владельца №2 (CASE-18), вариант
 * (в) — страница целиком есть пересборка, и оговорка о ней стоит в
 * шапке помеченным блоком. Обоснование — ds/screens/case-dssl.md §1–2.
 *
 * Движение — карта ds/motion-concept.md §7. Анимаций здесь нет: экран
 * объявляет движение атрибутами, хореография в src/scripts/animations.js.
 */
import PageShell from '../../layouts/PageShell.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProseBlock from '../../components/ProseBlock.astro';
import MetaList from '../../components/MetaList.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ScreenStack from '../../components/ScreenStack.astro';
import MediaZoom from '../../components/MediaZoom.astro';
import NoteBlock from '../../components/NoteBlock.astro';
import DecisionBlock from '../../components/DecisionBlock.astro';
import TextLink from '../../components/TextLink.astro';
import { cases } from '../../copy/cases/index.ts';
import { casesRu } from '../../copy/ru/cases/index.ts';
import { site as siteEn, type SiteCopy } from '../../copy/site.ts';
import { siteRu } from '../../copy/ru/site.ts';

export function getStaticPaths() {
  return cases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, locale: 'en' as Props['locale'] },
  }));
}

interface Props {
  entry: any;
  locale?: 'en' | 'ru';
}

const { entry, locale = 'en' } = Astro.props as Props;
const site: SiteCopy = locale === 'ru' ? siteRu : siteEn;
const { header, cover, context, reframe, process, failure, decisions, system, result, outro } =
  entry;

/*
  Переход к следующему кейсу (CASE-16). Требование само описывает две
  редакции: «в версии 1 роль „дальше“ играет контакт, с появлением второго
  кейса возвращается Next case без возврата на главную». Кейсов четыре, и
  контакт эту роль сдаёт: ContactBlock печатает PageShell сразу за этим
  блоком на всех маршрутах (IA-06), поэтому связь никуда не девается — она
  перестаёт быть единственным, что предлагает конец страницы.

  Следующий берётся из реестра по порядку, с замыканием: последний кейс
  ведёт на первый. Тупика не остаётся ни у одного из четырёх, а замыкание
  отправляет дочитавшего самый слабый по доказательствам кейс к самому
  сильному — порядок реестра идёт по её убыванию.

  Адрес не пишется в тексте кейса: реестр — единственный носитель порядка
  (US-20). Новый кейс добавляется файлом и строкой там, и переходы у
  соседей перестраиваются сами.
*/
const registry = locale === 'ru' ? casesRu : cases;
const index = registry.findIndex((item: any) => item.slug === entry.slug);
const nextEntry = registry[(index + 1) % registry.length];
const nextHref = `${locale === 'ru' ? '/ru' : ''}/work/${nextEntry.slug}`;
---

<PageShell
  title={entry.meta.title}
  description={entry.meta.description}
  ogCard={`work-${entry.slug}${locale === 'ru' ? '-ru' : ''}`}
  lang={locale}
  current={locale === 'ru' ? '/ru/work' : '/work'}
  siteCopy={site}
>
  {/*
    CaseHeader (ds/patterns.md). Порядок не переставляется: суть → мета →
    исход → команда → оговорка. Весь блок — Набор одним каскадом, поэтому
    части своих тактов не объявляют.
  */}
  <header class="ds-container ds-section case-header" data-motion-intro>
    <SectionHead as="h1" size="lg" reveal={false} class="case-header__title">
      {header.title}
    </SectionHead>

    <ProseBlock variant="lead" motion={false} class="case-header__lead">
      <p data-motion="reveal-text">{header.lead}</p>
    </ProseBlock>

    <MetaList items={header.meta} layout="inline" class="case-header__meta" />

    {/*
      Строка исхода объявляет Набор сама, корнем. Обёртка с внутренним
      <p data-motion> стояла здесь до 2026-08-24 и была невалидной: корень
      NoteBlock варианта emphasis — тоже <p>, и парсер разрывал абзац в
      абзаце на три узла. Оговорка получала рамку emphasis пустой, текст
      исхода терял и кегль, и меру, а поток секции считал обломки
      отдельными узлами и разводил их шагом. Как в CaseReframe ниже.
    */}
    <NoteBlock variant="emphasis" class="case-header__outcome">
      {header.outcome}
    </NoteBlock>

    <MetaList items={header.team} layout="stacked" class="case-header__team" />

    {/*
      Оговорка о пересборке (CASE-04). Вариант flagged, не muted: в схеме
      без отдельного блока переработки она осталась единственным, что
      отделяет пересборку от отгруженного продукта. Место прежнее —
      последней в шапке.
    */}
    <NoteBlock
      variant="flagged"
      label={header.rework.label}
      as="aside"
      class="case-header__rework"
    >
      <p>{header.rework.text}</p>
    </NoteBlock>
  </header>

  {/*
    CaseCover — обложка-стопка ScreenStack, тот же набор кадров, что на
    главной. Экран показывается как экран: ни рамки устройства, ни
    перспективы, ни наклона (CASE-20). Три кадра вместо одного отвечают на
    первый вопрос страницы — что это за продукт целиком, а не какой у него
    один экран.

    Full-bleed снят 2026-08-24 вместе с переходом на стопку. Он работал,
    пока обложка была одним снимком: изображение без краёв читается как
    продолжающееся за экран. У стопки края — это и есть содержание,
    правый нижний угол несёт всё сообщение, и full-bleed резал левый край
    объекта, чтобы показать правый. Обложка встаёт в ту же колонку, что и
    на главной: один объект в двух местах, а не два разных кадрирования.
  */}
  <figure class="ds-container case-cover">
    <ScreenStack screens={cover.screens} alt={cover.alt} loading="eager" counterScale />
    <figcaption class="ds-meta-sm case-caption">{cover.caption}</figcaption>
  </figure>

  {/*
    CaseContext. Поле под артефакт пусто намеренно: единственное «до» —
    экраны реального портала заказчика, они под NDA. CASE-13 разрешает
    пустое поле, TECH-15 запрещает серую заглушку вместо него.
  */}
  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{context.heading}</SectionHead>
    <ProseBlock>
      {context.body.map((paragraph: string) => <p>{paragraph}</p>)}
    </ProseBlock>

    {/*
      Пара «было → стало». Необязательна: носитель один — DSSL, единственный
      кейс, где старый продукт существовал (находка L3-4, вопрос ИА №12).
      Кадры идут друг под другом во всю ширину колонки, а не парой в ряд:
      сравнение работает, только если обе стороны читаются, а в половине
      колонки полный экран нечитаем — тот же замер, что в L2-5.
    */}
    {
      context.comparison && (
        <div class="case-comparison">
          {context.comparison.map((shot: any) => (
            <figure class="case-artifact">
              <MediaFrame src={shot.src} alt={shot.alt} ratio="natural" zoom />
              <figcaption class="ds-meta-sm case-caption">{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </section>

  {/* CaseReframe — отдельный блок, не абзац внутри контекста (CASE-06). */}
  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{reframe.heading}</SectionHead>
    <ProseBlock>
      {reframe.body.map((paragraph: string) => <p>{paragraph}</p>)}
    </ProseBlock>
    <NoteBlock variant="emphasis">{reframe.statement}</NoteBlock>

    {/*
      Кадр диапазона. Стоит во всех четырёх кейсах, но диапазон у него не
      один и тот же: у трёх десктопных — по ширинам, у мобильного Pawly —
      по времени сервиса. Ширина у Pawly одна, 390 px, и диапазон ширин там
      доказывал бы то, чего продукт не обещает; три момента одного заказа
      доказывают ровно тезис этого кейса.

      Место выбрано замером, а не вкусом. От подписи обложки до первого
      артефакта в `CaseProcess` шло 679–786 слов без единого кадра — самый
      длинный текстовый прогон страницы, и стоял он ровно там, где читатель
      решает, оставаться ли (`audit/visual-density-2026-08-31.md` §2). Конец
      `CaseReframe` — середина этого прогона: разрыв разваливается пополам,
      а не сдвигается.

      Обёртка нужна: `.case-artifact` несёт `margin: 0`, и figure прямым
      ребёнком секции потеряла бы шаг вертикали. Ту же роль играют
      `.case-artifacts` и `.case-comparison` у соседей.
    */}
    {
      reframe.range && (
        <div class="case-range">
          <figure class="case-artifact">
            <MediaFrame src={reframe.range.src} alt={reframe.range.alt} ratio="natural" zoom />
            <figcaption class="ds-meta-sm case-caption">{reframe.range.caption}</figcaption>
          </figure>
        </div>
      )
    }
  </section>

  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{process.heading}</SectionHead>
    <ProseBlock>
      {process.body.map((paragraph: string) => <p>{paragraph}</p>)}
    </ProseBlock>

    {/*
      Ссылка на живой прототип. Стоит сразу за абзацем, который его
      называет, и перед артефактами: подпись объясняет, что откроется, —
      без неё ↗ обещал бы продукт заказчика, а не прототип на синтетике.
      Подпись стоит над ссылкой, потому что читается раньше неё.
    */}
    <div class="case-prototype" data-motion-group data-motion-stagger="tight">
      <p class="ds-meta-sm case-prototype__note">{process.prototype.note}</p>
      {/*
        type=inline, а не arrow: у arrow своя стрелка →, и рядом с
        маркером внешней ссылки ↗ на одной строке вставали два разных
        указателя. → в этом продукте значит движение вперёд по сайту,
        ↗ — уход с него; здесь верен второй.
      */}
      <TextLink href={process.prototype.href} external>
        {process.prototype.label}
      </TextLink>
    </div>

    {/*
      Клип взаимодействия. Стоит сразу за ссылкой на прототип и перед
      статичными артефактами: подпись обещает работающую консоль, ролик
      показывает её работающей, а решение «нажать ↗ или читать дальше»
      читатель принимает уже увидев продукт в движении.

      Зума нет намеренно: MediaZoom открывает изображение, а не ролик, и
      кнопка увеличения на видео обещала бы то, чего диалог не умеет.
      Обёртка — по той же причине, что у .case-range выше.
    */}
    {
      process.clip && (
        <div class="case-clip">
          <figure class="case-artifact">
            <MediaFrame
              src={process.clip.src}
              video={process.clip.video}
              alt={process.clip.alt}
              ratio="natural"
            />
            <figcaption class="ds-meta-sm case-caption">{process.clip.caption}</figcaption>
          </figure>
        </div>
      )
    }

    <div class="case-artifacts" data-motion-group data-motion-stagger="tight">
      {
        process.artifacts.map((artifact: any) => (
          <figure class="case-artifact">
            <MediaFrame src={artifact.src} alt={artifact.alt} ratio="natural" zoom />
            <figcaption class="ds-meta-sm case-caption">{artifact.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/*
    CaseFailure. Самостоятельный блок со своим заголовком и тем же кеглем,
    что у остальных (CASE-08): приглушённый блок «что не получилось»
    читается как отписка.
  */}
  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{failure.heading}</SectionHead>
    <ProseBlock>
      {failure.body.map((paragraph: string) => <p>{paragraph}</p>)}
    </ProseBlock>
  </section>

  {/* CaseDecisions. Каскад ставит экран, не компонент. */}
  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{decisions.heading}</SectionHead>

    <div class="case-decisions" data-motion-group data-motion-stagger="base">
      {
        decisions.items.map((item: any) => (
          <DecisionBlock
            decision={item.decision}
            why={item.why}
            cost={item.cost}
            artifactLayout={item.artifact?.layout}
            whyLabel={locale === 'ru' ? 'Почему' : 'Why'}
            costLabel={locale === 'ru' ? 'Цена' : 'Cost'}
          >
            {item.artifact && (
              <figure slot="artifact" class="case-artifact">
                <MediaFrame
                  src={item.artifact.src}
                  zoomSrc={item.artifact.zoomSrc}
                  alt={item.artifact.alt}
                  ratio="natural"
                  rounded={entry.slug === 'pawly' || item.artifact.rounded}
                  fill={entry.slug === 'pawly'}
                  zoom
                />
                <figcaption class="ds-meta-sm case-caption">{item.artifact.caption}</figcaption>
              </figure>
            )}
          </DecisionBlock>
        ))
      }
    </div>
  </section>

  {/*
    CaseSystem (паттерн CaseSystemGrid). В подписи — имя компонента и
    перечень показанных состояний: компонент без состояний доказывает
    вкус, а не системную работу (CASE-10, US-18).
  */}
  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{system.heading}</SectionHead>
    <ProseBlock>
      {system.body.map((paragraph: string) => <p>{paragraph}</p>)}
    </ProseBlock>

    <div class="case-system" data-motion-group data-motion-stagger="tight">
      {
        system.grid.map((cell: any) => (
          <figure class="case-artifact">
            <MediaFrame src={cell.src} alt={cell.alt} ratio="natural" zoom />
            <figcaption class="ds-meta-sm case-caption">
              <span class="case-system__name">{cell.component}</span>
              {' — '}
              {cell.states}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/*
    CaseResult. Четыре строки компромисса занимают место метрики, которой
    нет (CASE-11), строка NDA закрывает их последней строкой того же
    каскада (CASE-12) — не в шапке и не в подвале.
  */}
  <section class="ds-container ds-section case-block">
    <SectionHead size="sm">{result.heading}</SectionHead>

    <div class="case-result" data-motion-group data-motion-stagger="base">
      <MetaList items={result.statements} layout="statements" motion={false} />
      <NoteBlock variant="muted" class="case-nda">{result.nda}</NoteBlock>
    </div>
  </section>

  {/* CaseOutro — переход к контакту, не тупик (CASE-16). */}
  <section class="ds-container ds-section case-outro">
    <SectionHead size="sm">{outro.heading}</SectionHead>
    <ProseBlock motion={false}>
      <p data-motion="reveal-text">{outro.lead}</p>
    </ProseBlock>
    <TextLink href={nextHref} type="arrow">{`${site.nextCase}: ${nextEntry.header.title}`}</TextLink>
  </section>

  {/*
    MediaZoom — один диалог на маршрут. Кадры кейса плотные: очередь разбора
    на сорок восемь строк и матрица состояний в колонке 411–628 px не
    читаются, а зумить страницу колесом никто не станет. Открывают его
    кнопки, которые рисует MediaFrame при zoom.
  */}
  <MediaZoom zoomCopy={site.zoom} />
</PageShell>

<style>
  /* Шапка идёт потоком секции, а не своим flex-gap. Gap складывался с
     margin компонентов: SectionHead приносил 48, gap добавлял 32, и под
     заголовком шапки стояло 80 — против 48 на /about у той же пары.
     Теперь пять узлов шапки идут шкалой, а две меты перебиты ниже.

     Отступы на корнях компонентов пишутся через родителя и :global().
     Класс, переданный пропом, приземляется на корень компонента, а тот несёт
     свой data-astro-cid: правило `.класс { … }` компилируется в
     `.класс[cid-страницы]` и не совпадает ни с чем. Ошибки нет — отступ молча
     пропадает. **Найдено аудитом экранов 2026-08-24**, проверяется
     `npm run check:css`. */

  /* Мета идёт строкой под тем, к чему относится: пара, не узел. */
  .case-header > :global(.case-header__meta),
  .case-header > :global(.case-header__team) {
    margin-block-start: var(--flow-pair);
  }

  /* Обложка встаёт в колонку контейнера, кадр и подпись — пара.

     Собственные поля <figure> снимаются по отдельности, а не шорткатом
     `margin: 0`. Шорткат обнулял и margin-block-start, которым главный
     ритм разводит секции (`main > * + *`), и скоупленный селектор
     страницы перебивал его по весу: обложка вставала вплотную к рамке
     оговорки о пересборке — кромка серой подложки продолжалась обводкой
     скриншота, и стопка читалась частью помеченного блока.
     **Найдено 2026-08-25.** Шаг между шапкой и обложкой принадлежит
     промежутку и приходит сверху; здесь снимается только нижнее поле UA.

     Боковые поля намеренно не сбрасываются: `ds-container` центрируется
     через margin-inline:auto. `margin-inline:0` незаметен до 1440 px, но
     на более широком окне прижимает обложку к левому краю viewport, тогда
     как все соседние секции остаются в центре контейнера. */
  .case-cover {
    margin-block-end: 0;
    display: flex;
    flex-direction: column;
    gap: var(--flow-pair);
  }

  .case-caption {
    color: var(--text-meta);
  }

  .case-system__name {
    color: var(--text-default);
  }

  /* Блоки кейса своей вертикали не держат вовсе: заголовок → тело даёт
     ds-flow-heading, тело → врезка и тело → сетка артефактов — умолчание
     секции. Девять секций страницы шли на одном flex-gap, который у
     каждой складывался с margin SectionHead по-своему. */

  .case-decisions {
    display: flex;
    flex-direction: column;
    gap: var(--flow-group);
  }

  /* Строка NDA закрывает компромиссы последней строкой того же каскада,
     но не впритык к ним: до 2026-08-24 отступа между ними не было вовсе —
     обёртка каскада не участвовала ни в одном правиле вертикали. */
  .case-result > :global(.case-nda) {
    margin-block-start: var(--flow-group);
  }

  .case-artifact {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--flow-pair);
  }

  /* Мобильная раскладка базовая, десктопная надстраивается: на 360 px
     два артефакта в ряд дают по 160 px, на них ничего не видно. */
  .case-artifacts,
  .case-system {
    display: grid;
    gap: var(--flow-node);
  }

  /* Ссылка на прототип и её подпись — одна пара, а не два узла, и вся
     пара принадлежит абзацу процесса над ней: текстовый шаг вместо
     умолчания секции. :global по той же причине, что у выхода к контакту
     ниже — ссылка это корень TextLink со своим data-astro-cid. */
  .case-prototype {
    margin-block-start: var(--flow-text);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--flow-pair);
    max-width: var(--measure-text);
  }

  .case-prototype__note {
    color: var(--text-meta);
  }

