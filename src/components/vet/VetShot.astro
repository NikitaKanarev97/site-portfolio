---
import CaseScreen from '../CaseScreen.astro';
import media from '../../data/vet-v2-media.json';
import type { VetShotCopy } from '../../copy/cases/vet-v2';
interface Props { shot: VetShotCopy; locale: 'en' | 'ru'; loading?: 'eager' | 'lazy'; href?: string; linkLabel?: string; mode?: 'responsive' | 'desktop' | 'mobile'; }
const { shot, locale, loading = 'lazy', href, linkLabel, mode = 'responsive' } = Astro.props;
const pick = (key: string) => {
  const value = (media as Record<string, { src: string; width: number; height: number; cssWidth: number }>)[`${locale}/${key}`];
  if (!value) throw Error(`VetShot missing ${locale}/${key}`);
  return value;
};
const desktop = pick(mode === 'mobile' ? shot.mobile : shot.desktop);
const mobile = pick(shot.mobile);
const fullDesktop = shot.fullDesktop ? pick(shot.fullDesktop) : undefined;
const fullMobile = shot.fullMobile ? pick(shot.fullMobile) : undefined;
const fullLabel = locale === 'ru' ? 'Рассмотреть полный экран' : 'Inspect the complete screen';
---
<figure class:list={['vet-shot', `vet-shot--${mode}`]} style={`--vet-native: ${desktop.cssWidth}px; --vet-native-mobile: ${mobile.cssWidth}px`} data-vet-shot={mode === 'mobile' ? shot.mobile : shot.desktop}>
  <CaseScreen item={{ src: desktop.src, srcNarrow: mode === 'responsive' ? mobile.src : undefined, alt: mode === 'mobile' ? shot.altMobile ?? shot.alt : shot.alt, altNarrow: shot.altMobile, device: 'panel' }} native narrowAt="lg" loading={loading} href={href} linkLabel={linkLabel} />
  {(shot.caption || (!href && (fullDesktop || fullMobile))) && <figcaption class="vet-shot__caption ds-body-sm">
    {shot.caption && <span class:list={[shot.captionDesktop && 'vet-shot__caption--mobile']} data-h="caption">{shot.caption}</span>}
    {shot.captionDesktop && <span class="vet-shot__caption--desktop" data-h="caption">{shot.captionDesktop}</span>}
    {!href && fullDesktop && <a class="vet-shot__full vet-shot__full--desktop" href={fullDesktop.src} data-astro-reload data-zoom-trigger data-zoom-fixed="true" data-zoom-src={fullDesktop.src} data-zoom-native="true" data-zoom-alt={shot.altFull ?? shot.alt}>{fullLabel}<span aria-hidden="true"> +</span></a>}
    {!href && fullMobile && <a class="vet-shot__full vet-shot__full--mobile" href={fullMobile.src} data-astro-reload data-zoom-trigger data-zoom-fixed="true" data-zoom-src={fullMobile.src} data-zoom-native="true" data-zoom-alt={shot.altMobile ?? shot.alt}>{fullLabel}<span aria-hidden="true"> +</span></a>}
  </figcaption>}
</figure>
<style>
  .vet-shot { display: grid; gap: var(--flow-pair); min-inline-size: 0; inline-size: 100%; max-inline-size: var(--vet-native); margin: 0; }
  .vet-shot__caption { display: grid; gap: var(--space-2); max-inline-size: var(--measure-case); color: var(--text-subtle); }
  .vet-shot__full { display: inline-flex; justify-self: start; align-items: center; gap: var(--space-2); min-block-size: var(--space-12); color: var(--text-subtle); text-decoration: none; }
  .vet-shot__full--desktop, .vet-shot__caption--desktop { display: none; }
  .vet-shot__full:focus-visible { text-decoration: underline; text-underline-offset: var(--space-1); }
  .vet-shot__full:active { color: var(--text-default); text-decoration: underline; text-underline-offset: var(--space-1); }
  @media (--can-hover) { .vet-shot__full:hover { color: var(--text-default); text-decoration: underline; text-underline-offset: var(--space-1); } }
  @media (--below-bp-lg) { .vet-shot--responsive { max-inline-size: var(--vet-native-mobile); } }
  @media (--bp-lg) { .vet-shot__full--desktop { display: inline-flex; } .vet-shot__caption--desktop { display: block; } .vet-shot__full--mobile, .vet-shot__caption--mobile { display: none; } }
</style>
