---
import CaseScreen from './CaseScreen.astro';
import { caseArt } from '../copy/case-art';
const {locale, loading = 'lazy', href, linkLabel} = Astro.props as {locale:'en'|'ru';loading?:'eager'|'lazy';href?:string;linkLabel?:string};
const ru = locale === 'ru';
const art = caseArt('learn',locale);
const material = {src:'/media/art-direction/learn/material-desktop.png',srcNarrow:'/media/art-direction/learn/material-mobile.png',device:'panel' as const,alt:ru?'Тот же материал ONVIF: версия, заголовок, введение и целый первый шаг диагностики; справа — связанные программы.':'The same ONVIF material: version, title, introduction and complete first diagnostic step; related learning paths at right.'};
const unit = {src:'/media/art-direction/learn/current-unit.png',device:'panel' as const,alt:ru?'Тот же материал об ONVIF выбран как текущий ресурс 03 в программе.':'The same ONVIF material selected as current resource 03 in the learning path.'};
const passport = {src:'/media/art-direction/learn/passport-desktop.png',srcNarrow:'/media/art-direction/learn/passport-mobile.png',device:'panel' as const,alt:ru?'Целый паспорт программы: объём, правила зачёта, демонстрационный документ и действие старта.':'Whole programme passport: workload, assessment rules, demonstration document and start action.'};
---
<div class="learn-stage" data-motion-group data-motion-stagger="tight">
  <div class="learn-stage__heading"><p class="ds-heading-2xl">{art.label}</p><p class="ds-body-sm">{art.detail}</p></div>
  <figure class="learn-stage__material">
    <figcaption class="ds-meta-xs">{ru?'Справочник · материал ONVIF':'Reference · ONVIF material'}</figcaption>
    <CaseScreen item={material} loading={loading} href={href} linkLabel={linkLabel} narrowAt="lg" />
  </figure>
  <figure class="learn-stage__unit">
    <figcaption class="ds-meta-xs">{ru?'Программа · тот же ресурс 03':'Learning path · same resource 03'}<span aria-hidden="true">↙</span></figcaption>
    <CaseScreen item={unit} loading={loading} href={href} linkLabel={linkLabel} />
  </figure>
  <figure class="learn-stage__passport">
    <CaseScreen item={passport} loading={loading} href={href} linkLabel={linkLabel} narrowAt="lg" />
  </figure>
</div>
<style>
  .learn-stage { display:grid; gap:var(--space-6); min-inline-size:0; }
  .learn-stage__heading { display:flex; flex-wrap:wrap; align-items:baseline; gap:var(--space-3) var(--space-8); padding-block-end:var(--space-4); border-block-end:var(--border-width) solid currentColor; }
  .learn-stage__heading p { margin:0; }
  .learn-stage figure { margin:0; min-inline-size:0; display:grid; align-content:start; gap:var(--space-3); }
  .learn-stage figcaption { display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); }
  .learn-stage__unit { grid-row:2; }
  .learn-stage__passport { inline-size:100%; }
  @media (--bp-lg) {
    .learn-stage { grid-template-columns:minmax(0,3fr) minmax(0,2fr); grid-template-rows:auto auto 1fr; gap:var(--space-6); align-items:start; }
    .learn-stage__heading { grid-column:1 / -1; }
    .learn-stage__material { grid-column:1; grid-row:2 / 4; }
    .learn-stage__unit { grid-column:2; grid-row:2; }
    .learn-stage__passport { grid-column:2; grid-row:3; }
  }
</style>
