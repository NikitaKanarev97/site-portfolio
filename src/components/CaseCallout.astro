---
/**
 * CaseCallout — ds/components.md, карта ds/screens/case.md §8
 *
 * Один элемент крупно, с нумерованными выносками (блоки 04 и 08). Донор —
 * Alex Dyakov: тонкая линия от номера на элементе к подписи сбоку.
 *
 *   tone=note   номер ink — что значит каждая часть элемента (блок 08)
 *   tone=issue  номер красный — что было сломано, кадр «было» (блок 04)
 *
 * Деталь показывается отдельным кадром, а не увеличенной копией поверх
 * экрана (правило 1). Кадр режется по границе смыслового блока (правило 2)
 * — это забота съёмки, компонент кадр не обрезает.
 *
 * Геометрия без JS. Номер стоит на кадре по координатам x, y в процентах.
 * Подпись стоит в колонке справа на той же высоте y, линия идёт только
 * снаружи, от края кадра до подписи. Подписи
 * у близких по y номеров наедут друг на друга: разводить их — забота
 * данных, не компонента.
 *
 * Ниже bp-md линий нет: номера на кадре, список подписей под кадром
 * внутри той же плашки.
 *
 * Движение: data-motion="draw" на линиях, исполнитель — этап 3.
 */
import CasePlate from './CasePlate.astro';
import { frameSize } from '../lib/media';
import type { Callout } from '../copy/cases/story';
import { px } from '../lib/tokens';

interface Props {
  callout: Callout;
  tone?: 'note' | 'issue';
  plate?: 'light' | 'dark';
  class?: string;
}

const { callout, tone = 'note', plate = 'light', class: className } = Astro.props;
const size = await frameSize(callout.src);
const narrowSize = callout.srcNarrow ? await frameSize(callout.srcNarrow) : size;
const narrowMedia = `(max-width: ${px('bp-md') - 1}px)`;
---

<figure class:list={['case-callout', `case-callout--${tone}`, className]}>
  <CasePlate tone={plate}>
    <div class="case-callout__body">
      <div class="case-callout__shot">
        <picture>
        {callout.srcNarrow && <source media={narrowMedia} srcset={callout.srcNarrow} width={narrowSize?.width} height={narrowSize?.height} />}
        <img
          src={callout.src}
          alt={callout.altNarrow ?? callout.alt}
          width={size?.width}
          height={size?.height}
          loading="lazy"
          decoding="async"
          data-motion="fade-image"
        />
        </picture>
        {
          callout.marks.map((mark, i) => (
            <>
              <span
                class="case-callout__line"
                style={`--x: ${mark.x}%; --y: ${mark.y}%`}
                data-motion="draw"
                aria-hidden="true"
              />
              <span
                class="ds-meta-xs case-callout__dot"
                style={`--x: ${mark.x}%; --y: ${mark.y}%`}
                aria-hidden="true"
              >
                {i + 1}
              </span>
            </>
          ))
        }
      </div>
      <ol class="case-callout__list">
        {
          callout.marks.map((mark, i) => (
            <li class="case-callout__item" style={`--y: ${mark.y}%`}>
              <span class="ds-meta-xs case-callout__dot case-callout__dot--list" aria-hidden="true">
                {i + 1}
              </span>
              <span class="ds-body-sm" data-h="caption">
                {mark.text}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </CasePlate>
  <figcaption class="ds-body-sm case-callout__caption" data-h="caption">{callout.caption}</figcaption>
</figure>

<style>
  .case-callout {
    --mark: var(--callout-mark);
    --mark-text: var(--callout-mark-text);
    /* Верх не сбрасывается: его задаёт поток (ds-flow-lead → flow-group).
       margin: 0 в скоупленном правиле перебивал шаг потока по специфичности. */
    margin-inline: 0;
    margin-block-end: 0;
  }

  .case-callout--issue {
    --mark: var(--callout-issue);
    --mark-text: var(--callout-issue-text);
  }

  .case-callout__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    inline-size: 100%;
  }

  .case-callout__shot {
    position: relative;
  }

  .case-callout__shot img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }

  .case-callout__dot {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    border-radius: 50%;
    background: var(--mark);
    color: var(--mark-text);
    letter-spacing: 0;
    flex: none;
  }

  .case-callout__shot > .case-callout__dot {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    translate: -50% -50%;
  }

  .case-callout__line {
    display: none;
  }

  .case-callout__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-callout__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .case-callout__caption {
    margin-block-start: var(--flow-pair);
    color: var(--text-muted);
  }

  @media (--bp-md) {
    .case-callout__body {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--space-12);
    }

    /* Линия только в межколонном поле; интерфейс не перечёркивается. */
    .case-callout__line {
      display: block;
      position: absolute;
      inset-inline-start: 100%;
      inset-inline-end: calc(-1 * var(--space-12));
      inset-block-start: var(--y);
      block-size: var(--border-width);
      background: var(--mark);
    }

    .case-callout__list {
      position: relative;
      display: block;
    }

    .case-callout__item {
      position: absolute;
      inset-inline: 0;
      inset-block-start: var(--y);
      translate: 0 -50%;
    }

    .case-callout__dot--list {
      display: none;
    }
  }
</style>
