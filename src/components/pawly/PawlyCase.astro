---
/**
 * PawlyCase — case-scoped renderer for Pawly Case V2 (map: audit/pawly-portfolio-case-v2/v2/SECTION_MAP.md).
 *
 * One walk, told on its own clock: 13:20 choosing → 14:05 handoff → exceptions → 14:52 return → settlement.
 * The cover opens on the open question (pickup received, return expected); the sand Return band answers it.
 * Shares the site's grammar with the other V3 cases (label rail + thesis, hairline rules, 12 columns,
 * caption under media) but not their compositions: phone slices stay at native width, never miniatures.
 * V2.1: every screen sits on a plate (PawlyShot); screens side by side share label, plate and caption tracks
 * through subgrid, so plates in one row end on one line and the screen is centred in its own field.
 *
 * Motion only through registered data-motion names (lines, fade, fade-image, rise); reduced motion and
 * no-JS keep everything visible. The shared CaseStory and the Home cover are not touched.
 */
import MetaList from '../MetaList.astro';
import CaseNext from '../CaseNext.astro';
import IconArrow from '../IconArrow.astro';
import PawlyShot from './PawlyShot.astro';
import media from '../../data/pawly-case-v2-media.json';
import type { PawlyCaseCopy, PawlyChapter } from '../../copy/cases/pawly-v2';
import type { CaseTheme } from '../../copy/cases/story';

interface Props {
  copy: PawlyCaseCopy;
  locale: 'en' | 'ru';
  next: { href: string; title: string; theme: CaseTheme; label: string };
}
const { copy, locale, next } = Astro.props;
const { cover, match, roles, branches, proof, settle, outcome, zoom } = copy;
const chapters: PawlyChapter[] = [match, roles, branches, proof, settle];
const photo = media['photo/pickup'];
const index = (i: number) => String(i + 1).padStart(2, '0');
---
<div class="pawly-case" id="case-pawly" data-h="case" data-story-version="pawly-v2">
  <section class="pawly-cover" aria-labelledby="pawly-title" data-case-cover="case-pawly"
    transition:name="case-pawly" transition:animate="initial">
    <div class="ds-container pawly-cover__inner" data-motion-intro>
      <header class="pawly-cover__head">
        <p class="ds-meta-sm pawly-cover__eyebrow">{cover.eyebrow}</p>
        <h1 id="pawly-title" class="ds-display-5xl pawly-cover__title" data-motion="lines">{cover.title}</h1>
        <p class="ds-heading-3xl pawly-cover__thesis" data-h="lead" data-motion="fade">{cover.thesis}</p>
        <p class="ds-body-lg pawly-cover__role" data-motion="fade">{cover.role}</p>
      </header>
      <div class="pawly-stage" data-motion="fade-image">
        {/* Wide screens: the received pickup frame large, beside the owner's screen that cites it.
            Phones show only the screen, which already carries the same photo. */}
        <PawlyShot class="pawly-stage__status" shot={cover.status} locale={locale} zoomLabel={zoom} plate="none" loading="eager" />
        <div class="pawly-stage__story">
        <figure class="pawly-stage__photo">
          <img src={photo.src} width={photo.width} height={photo.height} alt={cover.photoAlt} loading="eager" decoding="async" />
        </figure>
        <p class="ds-body-sm pawly-stage__caption">{cover.caption}</p>
        <nav class="pawly-clock" aria-label={cover.clockLabel}>
          <ol class="pawly-clock__list">
            {chapters.map((c, i) => (
              <li><a class="pawly-clock__link" href={`#${c.id}`}>
                <span class="ds-meta-xs pawly-clock__index" aria-hidden="true">{index(i)}</span>
                <span class="ds-body-base pawly-clock__time">{c.time}</span>
                <span class="ds-body-base pawly-clock__name">{c.label}</span>
              </a></li>
            ))}
          </ol>
        </nav>
        </div>
      </div>
    </div>
  </section>

  <div class="pawly-sheet">
    <div class="ds-container pawly-facts"><MetaList layout="facts" items={copy.facts} /></div>

    {/* ---------- 13:20 Choosing ---------- */}
    <section class="ds-container pawly-module" id={match.id} aria-labelledby={`${match.id}-title`}>
      <div class="pawly-head">
        <p class="ds-meta-sm pawly-label"><span class="pawly-label__time">{match.time}</span> · {match.label}</p>
        <div class="pawly-head__text">
          <h2 id={`${match.id}-title`} class="ds-heading-3xl pawly-thesis" data-motion="fade">{match.thesis}</h2>
          <p class="ds-body-lg pawly-body">{match.body}</p>
        </div>
      </div>
      <ol class="pawly-steps" data-motion-group data-motion-stagger="base">
        {match.steps.map((step, i) => (
          <li class="pawly-steps__item" data-motion="rise">
            <PawlyShot shot={step.shot} locale={locale} zoomLabel={zoom} label={`${index(i)} · ${step.label}`} caption={step.caption} />
          </li>
        ))}
      </ol>
      <p class="ds-heading-xl pawly-rule">{match.rule}</p>
    </section>

    {/* ---------- 14:05 Handoff ---------- */}
    <section class="ds-container pawly-module" id={roles.id} aria-labelledby={`${roles.id}-title`}>
      <div class="pawly-head">
        <p class="ds-meta-sm pawly-label"><span class="pawly-label__time">{roles.time}</span> · {roles.label}</p>
        <div class="pawly-head__text">
          <h2 id={`${roles.id}-title`} class="ds-heading-3xl pawly-thesis" data-motion="fade">{roles.thesis}</h2>
          <p class="ds-body-lg pawly-body">{roles.body}</p>
        </div>
      </div>
      <div class="pawly-roles">
        <PawlyShot class="pawly-roles__owner" shot={roles.owner.shot} locale={locale} zoomLabel={zoom} label={roles.owner.label} />
        <div class="pawly-roles__compare">
          <dl class="pawly-compare" data-motion-group data-motion-stagger="tight">
            {roles.rows.map(row => (
              <div class="pawly-compare__row" data-motion="rise">
                <dt class="ds-meta-xs pawly-compare__term">{row.term}</dt>
                <dd class="pawly-compare__pair">
                  <span class="ds-meta-xs pawly-compare__who">{roles.owner.label.split(' · ')[0]}</span>
                  <span class="ds-body-base">{row.owner}</span>
                  <span class="ds-meta-xs pawly-compare__who">{roles.walker.label.split(' · ')[0]}</span>
                  <span class="ds-body-base">{row.walker}</span>
                </dd>
              </div>
            ))}
          </dl>
          <p class="ds-body-sm pawly-note">{roles.note}</p>
        </div>
        <PawlyShot class="pawly-roles__walker" shot={roles.walker.shot} locale={locale} zoomLabel={zoom} label={roles.walker.label} />
      </div>
    </section>

    {/* ---------- Exceptions ---------- */}
    <section class="ds-container pawly-module" id={branches.id} aria-labelledby={`${branches.id}-title`}>
      <div class="pawly-head">
        <p class="ds-meta-sm pawly-label">{branches.label}</p>
        <div class="pawly-head__text">
          <h2 id={`${branches.id}-title`} class="ds-heading-3xl pawly-thesis" data-motion="fade">{branches.thesis}</h2>
          <p class="ds-body-lg pawly-body">{branches.body}</p>
        </div>
      </div>
      <div class="pawly-branches" data-motion-group data-motion-stagger="base">
        {branches.items.map(item => (
          <article class="pawly-branch" data-motion="rise">
            <div class="pawly-branch__text">
              <p class="ds-meta-xs pawly-branch__kicker">{item.kicker}</p>
              <h3 class="ds-heading-xl pawly-branch__title">{item.title}</h3>
              <p class="ds-body-base pawly-branch__refuses">{item.refuses}</p>
            </div>
            <PawlyShot class="pawly-branch__shot" shot={item.shot} action={item.action} locale={locale} zoomLabel={zoom} />
          </article>
        ))}
      </div>
      <p class="ds-body-sm pawly-note">{branches.note}</p>
    </section>

    {/* ---------- 14:52 Return: the sand band answers the cover's open question ---------- */}
    <section class="pawly-band" id={proof.id} aria-labelledby={`${proof.id}-title`}>
      <div class="ds-container pawly-module">
        <div class="pawly-head">
          <p class="ds-meta-sm pawly-label"><span class="pawly-label__time">{proof.time}</span> · {proof.label}</p>
          <div class="pawly-head__text">
            <h2 id={`${proof.id}-title`} class="ds-heading-3xl pawly-thesis" data-motion="fade">{proof.thesis}</h2>
            <p class="ds-body-lg pawly-body">{proof.body}</p>
          </div>
        </div>
        <div class="pawly-proof">
          <dl class="pawly-vocab" data-motion-group data-motion-stagger="tight">
            {proof.vocabulary.map((v, i) => (
              <div class="pawly-vocab__item" data-motion="rise">
                <dt class="ds-heading-xl"><span class="ds-meta-xs pawly-vocab__index" aria-hidden="true">{index(i)}</span>{v.term}</dt>
                <dd class="ds-body-sm pawly-vocab__text">{v.text}</dd>
              </div>
            ))}
          </dl>
          <ol class="pawly-proof__grid" data-motion-group data-motion-stagger="base">
            {proof.steps.map(step => (
              <li class="pawly-proof__item" data-motion="rise">
                <PawlyShot shot={step.shot} locale={locale} zoomLabel={zoom} label={step.label} caption={step.caption} plate="canvas" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/* ---------- Settlement ---------- */}
    <section class="ds-container pawly-module" id={settle.id} aria-labelledby={`${settle.id}-title`}>
      <div class="pawly-head">
        <p class="ds-meta-sm pawly-label">{settle.label}</p>
        <div class="pawly-head__text">
          <h2 id={`${settle.id}-title`} class="ds-heading-3xl pawly-thesis" data-motion="fade">{settle.thesis}</h2>
          <p class="ds-body-lg pawly-body">{settle.body}</p>
        </div>
      </div>
      <div class="pawly-settle">
        <div class="pawly-sum" data-motion="fade">
          <ol class="pawly-sum__lines">
            {settle.lines.map(line => (
              <li class="pawly-sum__line">
                <span class="ds-heading-3xl pawly-sum__amount">{line.amount}</span>
                <span class="ds-body-sm pawly-sum__text">{line.text}</span>
              </li>
            ))}
          </ol>
          <p class="ds-body-base pawly-sum__balance">{settle.balance}</p>
        </div>
        <PawlyShot shot={settle.owner.shot} locale={locale} zoomLabel={zoom} label={settle.owner.label} />
        <PawlyShot shot={settle.walker.shot} locale={locale} zoomLabel={zoom} label={settle.walker.label} />
      </div>
    </section>

    {/* ---------- Outcome ---------- */}
    <section class="ds-container" id="outcome" aria-labelledby="outcome-title">
      <div class="pawly-outcome">
        <div class="pawly-outcome__lead">
          <p class="ds-meta-sm pawly-label">{outcome.label}</p>
          <h2 id="outcome-title" class="ds-heading-4xl pawly-outcome__thesis" data-motion="fade">{outcome.thesis}</h2>
          <p class="ds-body-lg pawly-body">{outcome.body}</p>
        </div>
        <dl class="pawly-outcome__evidence" data-motion-group data-motion-stagger="tight">
          {outcome.evidence.map(item => (
            <div class="pawly-outcome__item" data-motion="rise">
              <dt class="ds-heading-xl">{item.term}</dt>
              <dd class="ds-body-base pawly-outcome__text">{item.text}</dd>
            </div>
          ))}
        </dl>
        <div class="pawly-outcome__cta">
          <a class="ds-body-lg ds-pressable pawly-cta" href={outcome.cta.href} target="_blank" rel="noopener">
            {outcome.cta.label}<IconArrow direction="up-right" class="pawly-cta__icon" />
          </a>
          <p class="ds-body-sm pawly-cta__note">{outcome.cta.note}</p>
        </div>
      </div>
    </section>
  </div>

  <CaseNext {...next} transitionKey={`case-${next.theme}`} />
</div>

<style>
  :global(main:has(> .pawly-case)) { padding-block-start: 0; }

  /* ---------- Cover: thesis, then the open question on the sand stage ---------- */
  .pawly-cover { background: var(--surface-default); color: var(--text-default); }
  .pawly-cover__inner { display: grid; gap: var(--flow-node); padding-block: var(--flow-text) var(--flow-node); }
  .pawly-cover__head { display: grid; gap: var(--flow-pair); }
  .pawly-cover__eyebrow { margin: 0; color: var(--text-meta); }
  .pawly-cover__title, .pawly-cover__thesis, .pawly-cover__role { margin: 0; }
  .pawly-cover__thesis { max-inline-size: 22ch; text-wrap: balance; }
  .pawly-cover__role { max-inline-size: var(--measure-case); color: var(--text-subtle); }

  .pawly-stage {
    display: grid; gap: var(--space-4);
    padding: var(--space-8) var(--space-3);
    background: var(--surface-cover-pawly);
    border-radius: var(--radius-lg);
  }
  .pawly-stage > :global(.pawly-stage__status) { justify-self: center; }
  /* The product's square pickup frame, shown whole: dog, lead and walker are never cropped. */
  .pawly-stage__photo { display: none; margin: 0; min-inline-size: 0; inline-size: 100%; max-inline-size: 520px; }
  .pawly-stage__photo img { display: block; inline-size: 100%; block-size: auto; border-radius: var(--radius-md); }
  .pawly-stage__story { display: grid; gap: var(--space-4); justify-items: center; align-content: start; min-inline-size: 0; }
  .pawly-stage__caption { margin: 0; inline-size: 100%; max-inline-size: 390px; color: var(--text-subtle); text-wrap: pretty; }

  .pawly-clock { justify-self: center; inline-size: 100%; max-inline-size: 390px; }
  .pawly-clock__list { display: grid; margin: 0; padding: 0; list-style: none; border-block-start: var(--border-width) solid var(--border-strong); }
  .pawly-clock__list > li { border-block-end: var(--border-width) solid var(--border-default); }
  .pawly-clock__link {
    display: grid; grid-template-columns: var(--space-8) 4.5rem minmax(0, 1fr); align-items: baseline;
    min-block-size: var(--space-12); padding-block: var(--space-3);
    color: var(--text-default); text-decoration: none;
  }
  .pawly-clock__index { color: var(--text-subtle); }
  .pawly-clock__time { font-variant-numeric: tabular-nums; color: var(--text-subtle); }
  .pawly-clock__link:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: calc(var(--focus-ring-width) * -1); }
  @media (--can-hover) {
    .pawly-clock__link:hover .pawly-clock__name { text-decoration: underline; text-underline-offset: 0.2em; }
  }

  /* ---------- Sheet + shared module grammar (same family as Portal/Agent V3) ---------- */
  .pawly-sheet { --pawly-step: var(--space-24); --pawly-shot-col: calc(390px + 2 * var(--space-6)); position: relative; z-index: 1; padding-block-end: var(--pawly-step); background: var(--surface-default); }
  .pawly-sheet > * + * { margin-block-start: var(--pawly-step); }
  .pawly-facts { padding-block-start: var(--flow-node); }
  .pawly-label { margin: 0; color: var(--text-meta); }
  .pawly-label__time { color: var(--text-default); font-variant-numeric: tabular-nums; }
  .pawly-thesis { margin: 0; max-inline-size: 22ch; text-wrap: balance; }
  .pawly-body { margin: 0; max-inline-size: var(--measure-case); color: var(--text-subtle); }
  .pawly-head, .pawly-head__text { display: grid; gap: var(--flow-text); }
  .pawly-module > * + * { margin-block-start: var(--flow-group); }
  .pawly-note { margin: 0; max-inline-size: var(--measure-case); color: var(--text-muted); }

  /* ---------- 13:20 Choosing: three decisions in reading order ---------- */
  /* 26rem: one screen per row in the 672 px tablet column, two in the 864 px one at 1024. */
  .pawly-steps {
    display: grid; gap: var(--flow-node) var(--gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    margin-block-end: 0; padding: 0; list-style: none;
  }
  .pawly-steps__item { display: grid; min-inline-size: 0; }
  .pawly-rule {
    margin-block-end: 0; max-inline-size: 30ch;
    padding-block-start: var(--space-4);
    border-block-start: var(--border-width) solid var(--border-strong);
    text-wrap: balance;
  }

  /* ---------- 14:05 Handoff: owner · what differs · walker ---------- */
  .pawly-roles { display: grid; gap: var(--flow-node); }
  .pawly-roles__compare { display: grid; gap: var(--flow-text); align-content: start; }
  .pawly-compare { display: grid; gap: var(--flow-text); margin: 0; }
  .pawly-compare__row { display: grid; gap: var(--space-2); padding-block-start: var(--space-4); border-block-start: var(--border-width) solid var(--border-strong); }
  .pawly-compare__term { color: var(--text-meta); }
  .pawly-compare__pair { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-2) var(--space-4); align-items: baseline; margin: 0; }
  .pawly-compare__who { color: var(--text-meta); }

  /* ---------- Exceptions: two branches, each with what the product refuses to do ---------- */
  .pawly-branches { display: grid; gap: var(--flow-group) var(--gutter); }
  .pawly-branch { display: grid; gap: var(--flow-text); align-content: start; min-inline-size: 0; padding-block-start: var(--space-4); border-block-start: var(--border-width) solid var(--border-strong); }
  .pawly-branch__text { display: grid; gap: var(--space-2); align-content: start; }
  .pawly-branch > :global(.pawly-branch__shot) { align-self: stretch; }
  .pawly-branch__kicker, .pawly-branch__title, .pawly-branch__refuses { margin: 0; }
  .pawly-branch__kicker { color: var(--text-meta); }
  .pawly-branch__refuses { max-inline-size: 44ch; color: var(--text-subtle); }

  /* ---------- 14:52 Return: full-bleed sand band ---------- */
  .pawly-band { padding-block: var(--space-16); background: var(--surface-cover-pawly); color: var(--text-default); }
  .pawly-band .pawly-label, .pawly-band .pawly-body { color: var(--text-subtle); }
  .pawly-band :global(.pawly-shot__label), .pawly-band :global(.pawly-shot__caption) { color: var(--text-subtle); }
  .pawly-proof { display: grid; gap: var(--flow-group); }
  .pawly-vocab { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--flow-text) var(--gutter); margin: 0; }
  .pawly-vocab__item { display: grid; gap: var(--space-1); align-content: start; padding-block-start: var(--space-3); border-block-start: var(--border-width) solid var(--border-strong); }
  .pawly-vocab__index { display: block; margin-block-end: var(--space-1); color: var(--text-subtle); }
  .pawly-vocab__text { margin: 0; color: var(--text-subtle); }
  .pawly-proof__grid {
    display: grid; gap: var(--flow-node) var(--gutter);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    margin: 0; padding: 0; list-style: none;
  }
  .pawly-proof__item { display: grid; min-inline-size: 0; }

  /* ---------- Settlement ---------- */
  .pawly-settle { display: grid; gap: var(--flow-node) var(--gutter); }
  .pawly-sum { display: grid; gap: var(--flow-text); align-content: start; }
  .pawly-sum__lines { display: grid; margin: 0; padding: 0; list-style: none; }
  .pawly-sum__line { display: grid; gap: var(--space-1); padding-block: var(--space-3); border-block-start: var(--border-width) solid var(--border-default); }
  .pawly-sum__line:last-child { border-block-end: var(--border-width) solid var(--border-strong); }
  .pawly-sum__amount { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pawly-sum__text { color: var(--text-subtle); }
  .pawly-sum__balance { margin: 0; color: var(--text-subtle); font-variant-numeric: tabular-nums; }

  /* ---------- Outcome ---------- */
  .pawly-outcome { display: grid; gap: var(--flow-group); padding: var(--space-6); background: var(--surface-subtle); border-radius: var(--radius-lg); }
  .pawly-outcome__lead { display: grid; gap: var(--flow-text); align-content: start; }
  .pawly-outcome__thesis { margin: 0; max-inline-size: 16ch; }
  .pawly-outcome__evidence { display: grid; gap: var(--flow-text); margin: 0; }
  .pawly-outcome__item { display: grid; gap: var(--flow-pair); padding-block-start: var(--space-4); border-block-start: var(--border-width) solid var(--border-strong); }
  .pawly-outcome__text { margin: 0; color: var(--text-subtle); }
  .pawly-outcome__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--flow-pair) var(--flow-text); }
  .pawly-cta {
    display: inline-flex; align-items: center; gap: var(--space-3);
    min-block-size: var(--space-16); padding-inline: var(--space-8);
    background: var(--surface-action-primary); color: var(--text-on-action);
    border-radius: var(--radius-full); text-decoration: none;
    transition: background-color var(--motion-hover-duration) var(--motion-hover-ease);
  }
  .pawly-cta:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-width); }
  .pawly-cta__note { margin: 0; color: var(--text-muted); }
  @media (--can-hover) {
    .pawly-cta:hover { background: var(--surface-action-primary-hover); }
  }

  /* Below 360 the longest RU word («подтверждённых») is wider than the 288 px column even at the phone step (2xl); xl, the heading floor, keeps it whole. */
  @media not (--bp-sm) {
    .pawly-cover__thesis { font-size: var(--size-xl); }
  }

  /* ---------- Phones: product evidence inside the first screen ---------- */
  @media (--below-bp-md) {
    /* Role moves under the stage, so the status card follows the thesis directly. */
    .pawly-cover__inner { display: flex; flex-direction: column; gap: var(--flow-pair); padding-block-start: var(--space-4); }
    .pawly-cover__head { display: contents; }
    /* Full-bleed sand on phones: the screen gets the whole column, like every other screen on the page. */
    .pawly-stage { order: 1; row-gap: var(--space-6); margin-block-start: var(--space-3); margin-inline: calc(var(--margin-sm) * -1); border-radius: 0; }
    .pawly-cover__role { order: 2; margin-block-start: var(--space-3); }
  }
  /* 320: the stage keeps its 32 px field; the 16 px it adds come out of the space above it, so the screen still
     starts in the upper 45% of a 640 px viewport. */
  @media not (--bp-sm) {
    .pawly-cover__inner { padding-block-start: var(--space-3); }
    .pawly-stage { margin-block-start: 0; }
  }

  /* Same fields as a PawlyShot plate: 40 above and below, 16 at the sides from 360. */
  @media (--bp-sm) {
