---
/**
 * PawlyShot — case-scoped (Pawly Case V2.1). One measured slice of a real 390 px product screen, on its plate.
 *
 * Slices are full-width DOM-box crops of DPR 2 captures (audit/pawly-portfolio-case-v2/v2/tools/crops.py):
 * cards keep their own rounded corners on the product's page surface, so this frame only rounds that surface.
 * The slice never grows past its capture width (390 px, or the card interior), so phone type stays at native size or slightly below.
 * The image is a real link to the file; the site script upgrades it to MediaZoom at its natural size.
 *
 * V2.1 media spacing (audit/pawly-portfolio-case-v2/v2.1/REPORT.md §2): every screen sits on a plate whose vertical
 * field is larger than its side field, because width is what phones lack and air above and below is what the slices lacked.
 * - plate="neutral" (default): surface-plate on the white sheet, as CasePlate; the screen reads as a panel by tone alone.
 * - plate="canvas": on sand, the plate is the product's own page surface (gray-50 ≈ the slices' #FBF9F7, ≤ 4/255 apart),
 *   so the slice's crop edges disappear and the cards float in a wider canvas.
 * - plate="none": the parent is the plate (the cover's sand stage).
 * Phones: plates run full-bleed to the screen edge, so the field is gained without shrinking the screen.
 * In rows, a parent may set grid-row: span 3 + subgrid on the figure: label, plate and caption then share tracks
 * with their neighbours, and plates in one row end on one line.
 * `action` is the same screen's fixed bottom bar, cut as its own slice: shown under the main slice, apart from it.
 */
import media from '../../data/pawly-case-v2-media.json';
import type { PawlyShot as Shot } from '../../copy/cases/pawly-v2';

interface Props {
  shot: Shot;
  action?: Shot;
  locale: 'en' | 'ru';
  label?: string;
  caption?: string;
  zoomLabel: string;
  plate?: 'neutral' | 'canvas' | 'none';
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { shot, action, locale, label, caption, zoomLabel, plate = 'neutral', loading = 'lazy', class: className } = Astro.props;
const entries = media as Record<string, { src: string; width: number; height: number }>;
const slices = [shot, ...(action ? [action] : [])].map(s => {
  const entry = entries[`${locale}/${s.key}`];
  if (!entry) throw new Error(`PawlyShot: no media ${locale}/${s.key}`);
  return { ...s, ...entry };
});
---
<figure class:list={['pawly-shot', `pawly-shot--${plate}`, className]} style={`--shot-native: ${slices[0].width / 2}px`}>
  {label && <p class="ds-meta-sm pawly-shot__label">{label}</p>}
  <div class="pawly-shot__plate" data-h="plate">
    {slices.map((s, i) => (
      <a class="pawly-shot__frame" href={s.src} data-astro-reload data-zoom-trigger data-zoom-src={s.src}
        data-zoom-native="true" data-zoom-alt={s.alt} aria-label={`${zoomLabel}: ${s.alt}`}>
        <img src={s.src} width={s.width} height={s.height} alt={s.alt}
          loading={loading} decoding="async" fetchpriority={loading === 'eager' && i === 0 ? 'high' : undefined} />
      </a>
    ))}
  </div>
  {caption && <figcaption class="ds-body-sm pawly-shot__caption">{caption}</figcaption>}
</figure>
<style>
  .pawly-shot {
    --plate-y: var(--space-8);
    --plate-x: var(--space-3);
    display: grid; grid-template-rows: auto 1fr auto;
    min-inline-size: 0; inline-size: 100%; margin: 0;
  }
  .pawly-shot__label { grid-row: 1; margin: 0 0 var(--space-4); color: var(--text-meta); }
  .pawly-shot__plate {
    grid-row: 2;
    display: grid; align-content: center; justify-items: center; gap: var(--space-4);
    min-inline-size: 0;
    padding: var(--plate-y) var(--plate-x);
    background: var(--surface-plate);
  }
  .pawly-shot--canvas .pawly-shot__plate { background: var(--surface-subtle); }
  .pawly-shot--none .pawly-shot__plate { padding: 0; background: none; }
  .pawly-shot__frame {
    display: block; inline-size: 100%; max-inline-size: var(--shot-native);
    overflow: hidden;
    border-radius: var(--radius-md);
  }
  .pawly-shot__frame img { display: block; inline-size: 100%; block-size: auto; }
  .pawly-shot__frame:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-width); }
  .pawly-shot__caption { grid-row: 3; margin-block-start: var(--space-4); max-inline-size: 36ch; color: var(--text-muted); text-wrap: pretty; }

  /* Phones: the plate takes the whole screen width; label and caption keep the text column. */
  @media (--below-bp-md) {
    .pawly-shot:not(.pawly-shot--none) .pawly-shot__plate { margin-inline: calc(var(--margin-sm) * -1); }
  }
  @media (--bp-sm) {
    .pawly-shot { --plate-y: calc(var(--space-8) + var(--space-2)); --plate-x: var(--space-4); }
  }
  @media (--bp-md) {
    .pawly-shot { --plate-y: var(--space-12); }
    .pawly-shot__plate { border-radius: var(--radius-lg); }
  }
  @media (--bp-lg) {
    .pawly-shot { --plate-y: var(--space-16); --plate-x: var(--space-6); }
  }
</style>
