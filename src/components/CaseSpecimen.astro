---
/** Documentary foundation + actual domain matrices, composed from existing Case modules. */
import CasePlate from './CasePlate.astro';
import CaseScreen from './CaseScreen.astro';
import type { Specimen } from '../copy/cases/story';
import '../styles/specimen-fonts.css';
interface Props { specimen: Specimen; tone?: 'light' | 'dark'; lang?: 'en' | 'ru' }
const { specimen, tone = 'light', lang = 'en' } = Astro.props;
const t = (value: { en: string; ru: string }) => value[lang];
---
<figure class="case-specimen">
  <CasePlate tone={tone}>
    <div class="case-specimen__sheet" style={`--specimen-group-count:${specimen.groups.length}`} data-story-document>
      <h3 class="ds-heading-3xl case-specimen__title">{specimen.title}</h3>
      <section class="case-specimen__foundation" aria-label={lang === 'ru' ? 'Основа системы' : 'Foundation'} data-specimen-part="foundation">
        <table class="case-specimen__type ds-body-sm">
          <colgroup><col span="3" style="width:20%" /><col style="width:40%" /></colgroup>
          <thead class="ds-meta-xs"><tr>{(lang === 'ru' ? ['Стиль', 'Применение', 'Параметры', 'Образец'] : ['Style', 'Use', 'Metrics', 'Sample']).map(v => <th scope="col">{v}</th>)}</tr></thead>
          <tbody>{specimen.type.map(row => <tr>
            <th scope="row">{row.style}</th><td>{t(row.usage)}</td>
            <td class="ds-meta-xs">{row.size}/{row.lineHeight}<br />{row.weight}</td>
            <td class="case-specimen__sample" style={`font-family: ${specimen.fontFamily}; font-size:${row.size}px; line-height:${row.lineHeight}px; font-weight:${row.weight};`}>{t(row.sample)}</td>
          </tr>)}</tbody>
        </table>
        <div class="case-specimen__colors" aria-label={lang === 'ru' ? 'Палитра продукта' : 'Product palette'}>
          {specimen.colors.map(color => <div class="case-specimen__swatch">
            <span class="case-specimen__paint" style={`background-color:${color.hex}`} aria-hidden="true" />
            <span class="ds-meta-xs">{color.hex}</span><span class="ds-body-sm">{color.name}</span>
          </div>)}
        </div>
      </section>
      {specimen.groups.map(group => <section class="case-specimen__sets" data-specimen-part={group.id} aria-label={group.title}>
        {specimen.sets.filter(set => set.group === group.id).map(set => <div class:list={['case-specimen__set', set.wide && 'case-specimen__set--wide']} data-specimen-set={set.id}>
          <h4 class="ds-meta-xs">{set.title}</h4>
          <ol class="case-specimen__states">{set.states.map(state => <li data-specimen-state={state.id} data-media-id={state.mediaId}>
            <p class="ds-body-sm case-specimen__state-label">{state.label}</p>
            <CaseScreen item={state.shot} native />
          </li>)}</ol>
        </div>)}
      </section>)}
    </div>
  </CasePlate>
  <figcaption class="ds-body-sm case-specimen__caption" data-h="caption">{specimen.caption}</figcaption>
</figure>
<style>
  .case-specimen { margin-inline: 0; margin-block-end: 0; }
  .case-specimen__sheet { display: grid; gap: var(--flow-group); inline-size: 100%; min-inline-size: 0; }
  .case-specimen__title { grid-column: 1 / -1; }
  .case-specimen__foundation { min-inline-size: 0; }
  .case-specimen__type { inline-size: 100%; border-collapse: collapse; table-layout: fixed; }
  .case-specimen__type th, .case-specimen__type td { text-align: start; padding: var(--space-3) var(--space-1); border-block-end: var(--border-width) solid var(--border-default); overflow-wrap: anywhere; vertical-align: middle; }
  .case-specimen__type th { font-weight: var(--weight-semibold); }
  .case-specimen__sample { color: var(--text-default); }
  .case-specimen__colors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-block-start: var(--flow-group); }
  .case-specimen__swatch { display: flex; flex-direction: column; gap: var(--space-1); }
  .case-specimen__paint { block-size: var(--space-12); border: var(--border-width) solid var(--border-default); }
  .case-specimen__sets { display: grid; align-items: start; gap: var(--space-6); min-inline-size: 0; }
  .case-specimen__set { min-inline-size: 0; padding: var(--space-4); border: var(--border-width) dashed var(--diagram-proto); border-radius: var(--radius-md); }
  .case-specimen__states { display: grid; gap: var(--space-6); padding: 0; margin: var(--flow-node) 0 0; list-style: none; }
  .case-specimen__state-label { margin-block-end: var(--flow-pair); color: var(--text-muted); }
  .case-specimen__states :global(.case-screen) { max-inline-size: 100%; }
  .case-specimen__caption { margin-block-start: var(--flow-pair); color: var(--text-muted); }
  @media (--below-bp-md) {
    .case-specimen__type, .case-specimen__type tbody { display: block; inline-size: 100%; }
    .case-specimen__type colgroup { display: none; }
    .case-specimen__type thead { display: none; }
    .case-specimen__type tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block: var(--space-3); border-block-end: var(--border-width) solid var(--border-default); }
    .case-specimen__type th, .case-specimen__type td { border: 0; }
    .case-specimen__type .case-specimen__sample { grid-column: 1 / -1; }
    .case-specimen__set { padding: var(--space-2); }
  }
  @media (--bp-md) {
    .case-specimen__sets { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (--bp-xl) {
    .case-specimen__sheet { grid-template-columns: 35fr 65fr; align-items: start; }
    .case-specimen__foundation { grid-column: 1; grid-row: 2 / span var(--specimen-group-count); }
    .case-specimen__sets { grid-column: 2; }
    .case-specimen__set--wide { grid-column: 1 / -1; }
  }
</style>
