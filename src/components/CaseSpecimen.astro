---
/** Selected domain states; native disclosure keeps the mobile story compact. */
import CasePlate from './CasePlate.astro';
import CaseScreen from './CaseScreen.astro';
import type { Specimen } from '../copy/cases/story';
import { px } from '../lib/tokens';
interface Props { specimen: Specimen; tone?: 'light' | 'dark'; lang?: 'en' | 'ru' }
const { specimen, tone = 'light', lang = 'en' } = Astro.props;

---
<figure class="case-specimen">
  <details class="case-specimen__disclosure" data-specimen-disclosure data-case-route data-breakpoint={px('bp-md')}><summary class="ds-body-base case-specimen__summary">{lang === 'ru' ? 'Состояния продукта' : 'Product states'}</summary>
  <CasePlate tone={tone}>
    <div class="case-specimen__sheet" data-story-document>
      <h3 class="ds-heading-3xl case-specimen__title">{specimen.title}</h3>
      {specimen.groups.map(group => <section class="case-specimen__sets" data-specimen-part={group.id} aria-label={group.title}>
        <h4 class="ds-meta-sm case-specimen__group-title">{group.title}</h4>
        {specimen.sets.filter(set => set.group === group.id).map(set => <div class:list={['case-specimen__set', set.states.length === 1 && 'case-specimen__set--single', set.states.length === 3 && set.states.every(state => state.shot.nativeWidth) && 'case-specimen__set--triple']} style={`--specimen-width:${Math.max(...set.states.map(state => state.shot.nativeWidth ?? 0))}px`} data-specimen-set={set.id}>
          <h5 class="ds-heading-xl">{set.title}</h5>
          <ol class="case-specimen__states">{set.states.map(state => <li data-specimen-state={state.id} data-media-id={state.mediaId}>
            <p class="ds-body-sm case-specimen__state-label">{state.label}</p>
            <CaseScreen item={state.shot} native />
          </li>)}</ol>
        </div>)}
      </section>)}

    </div>
  </CasePlate>
  </details>
  <figcaption class="ds-body-sm case-specimen__caption" data-h="caption">{specimen.caption}</figcaption>
</figure>
<style>
  .case-specimen { margin-inline: 0; margin-block-end: 0; }
  .case-specimen__summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-block-size: var(--space-12); cursor: pointer; list-style: none; color: var(--text-link); }
  .case-specimen__summary::-webkit-details-marker { display: none; }
  .case-specimen__summary::after { content: '+'; }
  .case-specimen__disclosure[open] > .case-specimen__summary::after { content: '−'; }
  .case-specimen__disclosure[open] > :global(.case-plate) { margin-block-start: var(--flow-node); }
  .case-specimen__sheet { display: grid; gap: var(--flow-group); inline-size: 100%; min-inline-size: 0; }
  .case-specimen__title { margin: 0; }
  .case-specimen__sets { display: grid; align-items: start; gap: var(--space-6); min-inline-size: 0; }
  .case-specimen__set { min-inline-size: 0; }
  .case-specimen__set h5 { margin: 0; }
  .case-specimen__group-title { margin: 0; color: var(--text-muted); }
  .case-specimen__states { display: grid; gap: var(--space-6); padding: 0; margin: var(--flow-pair) 0 0; list-style: none; }
  .case-specimen__states > li { min-inline-size: 0; }
  .case-specimen__state-label { margin: 0; color: var(--text-muted); }
  .case-specimen__states :global(.case-screen) { max-inline-size: 100%; margin-block-start: var(--flow-pair); }
  .case-specimen__caption { margin-block-start: var(--flow-pair); color: var(--text-muted); }
  @media (--bp-md) {
    .case-specimen__sets { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case-specimen__group-title, .case-specimen__set { grid-column: 1 / -1; }
    .case-specimen__set--single { grid-column: auto; }
    .case-specimen__states { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case-specimen__set--single .case-specimen__states { grid-template-columns: minmax(0, 1fr); }
  }
  @media (--bp-xl) {
    .case-specimen__set--triple .case-specimen__states { grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--specimen-width)), 1fr)); }
  }
</style>
<script>
  function setupSpecimens() {
    document.querySelectorAll<HTMLDetailsElement>('[data-specimen-disclosure]').forEach(details => {
      if (details.dataset.ready) return;
      details.dataset.ready = 'true';
      const wide = window.matchMedia('(min-width: ' + details.dataset.breakpoint + 'px)');
      const update = () => { details.open = wide.matches; };
      update();
      wide.addEventListener('change', update);
      document.addEventListener('astro:before-swap', () => wide.removeEventListener('change', update), { once: true });
    });
  }
  document.addEventListener('astro:page-load', setupSpecimens);
</script>
