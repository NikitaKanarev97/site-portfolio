---
/**
 * TextLink — ds/components.md
 *
 * Варианты: type=inline | arrow | nav.
 *
 * Доступность: цвет не единственный различитель — у inline постоянное
 * подчёркивание, у arrow стрелка, у nav подчёркивание по hover и постоянное
 * у активного пункта.
 *
 * Движение: Строка (motion-hover, ds/motion-concept.md §3.3). Подчёркивание
 * приходит слева (transform-origin: left), уходит вправо (origin: right) —
 * иначе движение выглядит отменённым, а не завершённым. У arrow сдвигается
 * только стрелка: размер текста не меняется, иначе строка дёргается.
 *
 * Наведение живёт под @media (--can-hover): на тач-устройстве :hover
 * залипает после тапа. Отклик там даёт нажатие — строчная форма Состояния
 * (§3.4): цвет уходит в text-link-pressed, подчёркивание встаёт целиком.
 * Масштаба у строчной цели нет: буква, меняющая кегль под пальцем, дёргает
 * строку.
 *
 * Внешние ссылки помечаются в тексте — маркер и скрытая подсказка здесь
 * дополняют формулировку, а не заменяют её.
 */
import IconArrow from './IconArrow.astro';

interface Props {
  href: string;
  type?: 'inline' | 'arrow' | 'nav';
  external?: boolean;
  /** Активный пункт навигации: подчёркивание постоянно, на hover не двигается. */
  active?: boolean;
  /** Ссылка на тёмной поверхности — text-link-on-inverse. */
  onInverse?: boolean;
  class?: string;
  /** Скрытая подпись внешней ссылки; по умолчанию определяется из URL. */
  externalLabel?: string;
}

const {
  href,
  type = 'inline',
  external = false,
  active = false,
  onInverse = false,
  class: className,
  externalLabel = Astro.url.pathname.startsWith('/ru')
    ? '(внешняя ссылка, откроется в новой вкладке)'
    : '(external link, opens in a new tab)',
} = Astro.props;
---

<a
  class:list={[
    'ds-link',
    `ds-link--${type}`,
    { 'is-active': active, 'is-inverse': onInverse },
    className,
  ]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-current={active && type === 'nav' ? 'page' : undefined}
>
  <span class="ds-link__label">
    <slot />
    {(type === 'nav' || type === 'arrow') && <span class="ds-link__rule" aria-hidden="true"></span>}
  </span>
  {external && <IconArrow direction="up-right" size="small" class="ds-link__external" />}
  {external && <span class="ds-visually-hidden">{externalLabel}</span>}
  {type === 'arrow' && !external && <IconArrow direction="right" class="ds-link__arrow" />}
</a>

<style>
  .ds-link {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--text-link);
    text-decoration: none;
    transition: color var(--motion-hover-duration) var(--motion-hover-ease);
  }

  .ds-link.is-inverse {
    color: var(--text-link-on-inverse);
  }

  .ds-link.is-inverse:focus-visible {
    outline-color: currentColor;
  }

  .ds-link__label {
    position: relative;
  }

  /* Нажатие. Ступень ниже hover — иначе на десктопе, где ссылка под курсором
     уже держит hover-цвет, нажатие не видно вовсе. Быстрее наведения:
     motion-press перебивает длительность только на время приёма. */
  .ds-link:active {
    color: var(--text-link-pressed);
    transition-duration: var(--motion-press-duration);
    transition-timing-function: var(--motion-press-ease);
  }

  .ds-link.is-inverse:active {
    color: var(--text-link-pressed-on-inverse);
  }

  /* Отступ подчёркивания — тот же space-1, что у подчёркивания Строки ниже
     и у CopyEmail. До аудита здесь стояло 0.2em: три одинаковых по смыслу
     подчёркивания продукта сидели на трёх разных отступах. */
  .ds-link--inline .ds-link__label {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: var(--space-1);
  }

  .ds-link--nav {
    color: var(--text-default);
  }

  /* Подчёркивание Строки. Приходит слева, уходит вправо. */
  .ds-link__rule {
    position: absolute;
    inset-inline: 0;
    bottom: calc(var(--space-1) * -1);
    height: var(--border-width);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--motion-hover-duration) var(--motion-hover-ease);
  }

  .ds-link:focus-visible .ds-link__rule,
  .ds-link.is-active .ds-link__rule {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Нажатие ставит подчёркивание целиком и сразу: на тач-устройстве это
     единственный отклик до того, как страница начнёт уходить. */
  .ds-link:active .ds-link__rule {
    transform: scaleX(1);
    transform-origin: left;
    transition-duration: var(--motion-press-duration);
    transition-timing-function: var(--motion-press-ease);
  }

  /* Активный пункт держит подчёркивание постоянно и на hover не двигается. */
  .ds-link.is-active .ds-link__rule {
    transition: none;
  }

  .ds-link :global(.ds-link__arrow),
  .ds-link :global(.ds-link__external) {
    align-self: center;
    transition: transform var(--motion-hover-duration) var(--motion-hover-ease);
  }

  /* Наведение — только там, где курсор действительно есть. Тач-устройство
     эмулирует :hover на тапе и держит его до следующего касания в стороне:
     подчёркивание залипает на уже покинутой ссылке. */
  @media (--can-hover) {
    .ds-link:hover {
      color: var(--text-link-hover);
    }

    .ds-link--nav:hover {
      color: var(--text-link-hover);
    }

    .ds-link.is-inverse:hover {
      color: var(--text-link-on-inverse);
    }

    .ds-link:active {
      color: var(--text-link-pressed);
    }

    .ds-link.is-inverse:active {
      color: var(--text-link-pressed-on-inverse);
    }

    .ds-link:hover .ds-link__rule {
      transform: scaleX(1);
      transform-origin: left;
    }

    @media (prefers-reduced-motion: no-preference) {
      .ds-link:hover :global(.ds-link__arrow) {
        transform: translateX(var(--space-1));
      }

      .ds-link:hover :global(.ds-link__external) {
        transform: translate(var(--space-1), calc(var(--space-1) * -1));
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-link,
    .ds-link__rule,
    .ds-link :global(.ds-link__arrow),
    .ds-link :global(.ds-link__external) {
      transition: none;
    }
  }

</style>
