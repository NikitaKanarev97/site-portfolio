---
/**
 * CaseNumbers — ds/components.md, карта ds/screens/case.md §8
 *
 * Масштаб задачи цепочкой чисел со стрелками (блок 02): «1 770 → 71 →
 * 2,4 h». Число показано крупно, потому что в абзаце оно теряется.
 *
 * Значение — строка как есть, с единицей и разделителем локали. Режим
 * count этапа 3 разбирает число из строки и досчитывает; без JS и при
 * reduced-motion число стоит сразу.
 *
 * Стрелка стоит перед каждым пунктом, кроме первого, в той же роли, что
 * число, и не озвучивается: порядок несёт сам список <ol>. Ниже bp-md
 * цепочка встаёт столбиком, стрелка поворачивается вниз.
 */
interface Props {
  items: { value: string; caption: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['case-numbers', className]}>
  {
    items.map((item, i) => (
      <li class="case-numbers__item">
        {i > 0 && (
          <span class="ds-display-5xl case-numbers__arrow" aria-hidden="true">
            →
          </span>
        )}
        <span class="case-numbers__body">
          <span class="ds-display-5xl case-numbers__value" data-motion="count" aria-label={item.value}>
            {item.value}
          </span>
          <span class="ds-body-sm case-numbers__caption" data-h="caption">
            {item.caption}
          </span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .case-numbers {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    /* Верх не сбрасывается: его задаёт поток (ds-flow-lead → flow-group).
       margin: 0 в скоупленном правиле перебивал шаг потока по специфичности. */
    margin-inline: 0;
    margin-block-end: 0;
    padding: 0;
    list-style: none;
  }

  .case-numbers__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-numbers__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .case-numbers__arrow {
    align-self: flex-start;
    color: var(--text-muted);
    transform: rotate(90deg);
  }

  .case-numbers__value {
    color: var(--text-default);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .case-numbers__caption {
    max-inline-size: calc(var(--measure-text) / 3);
    color: var(--text-muted);
    text-wrap: balance;
  }

  @media (--bp-md) {
    .case-numbers {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-8);
    }

    .case-numbers__item {
      flex-direction: row;
      gap: var(--space-8);
    }

    .case-numbers__arrow {
      transform: none;
    }
  }
</style>
