---
import LearnShot from './LearnShot.astro';
import { makeLearnCase } from '../../copy/cases/learn-v2';
interface Props { locale: 'en' | 'ru'; loading?: 'eager' | 'lazy' }
const { locale, loading = 'lazy' } = Astro.props;
const copy = makeLearnCase(locale);
---
<div class="learn-home">
  <div class="learn-home__copy"><p class="ds-meta-sm">{copy.eyebrow}</p><p class="ds-heading-3xl learn-home__promise">{copy.promise}</p><p class="ds-body-base">{copy.lead}</p></div>
  <LearnShot shot={copy.hero.home} loading={loading} presentation="canvas" href={`${locale === 'ru' ? '/ru' : ''}/work/learn/`} linkLabel={locale === 'ru' ? 'Читать кейс TRASSIR Learn' : 'Read the TRASSIR Learn case'} />
  <p class="ds-body-sm learn-home__language">{locale === 'ru' ? 'Главная по рабочей задаче · актуальный интерфейс' : 'Task-led Home · current interface'}</p>
</div>
<style>
  .learn-home { --focus-ring-color: var(--border-focus); display: grid; gap: var(--flow-node); padding: var(--stage-inset); background: var(--surface-subtle); color: var(--text-default); border-radius: var(--radius-media); }
  .learn-home__copy { display: grid; gap: var(--flow-text); }
  .learn-home__copy > p:first-child, .learn-home__copy > p:last-child, .learn-home__language { color: var(--text-subtle); }
  .learn-home__promise { white-space: pre-line; }
  .learn-home :global(.case-screen__open--case) { position: relative; z-index: 1; }
  @media (--bp-lg) {
    .learn-home { grid-template-columns: minmax(0, 2fr) minmax(0, 5fr); gap: var(--flow-text) var(--space-12); align-items: center; }
    .learn-home__language { grid-column: 2; }
  }
</style>
