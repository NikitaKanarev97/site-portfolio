---
import LearnShot from './LearnShot.astro';
import CaseScreen from '../CaseScreen.astro';
import Diagram from '../Diagram.astro';
import CaseNext from '../CaseNext.astro';
import TextLink from '../TextLink.astro';
import { learnContentModel } from '../../data/diagrams/learn/content-model';
import type { LearnPremiumCopy } from '../../copy/cases/learn-v3';
import type { CaseTheme } from '../../copy/cases/story';
interface Props { copy: LearnPremiumCopy; locale: 'en' | 'ru'; next: { href: string; title: string; theme: CaseTheme; label: string } }
const { copy: c, locale, next } = Astro.props;
const { problem, shared, reference, guided, workspace, assessment, outcome } = c;
const externalLabel = locale === 'ru' ? 'Откроется в новой вкладке' : 'Opens in a new tab';
---
<article class="learn-case" id="case-learn" data-h="case" data-word-budget="1150" data-story-version="blocks-v1" data-learn-version="learn-v3">
  <section class="learn-cover" id="learn-cover" aria-labelledby="learn-title" data-case-cover="case-learn" transition:name="case-learn" transition:animate="initial">
    <div class="ds-container learn-cover__inner" data-motion-intro>
      <header class="learn-cover__head">
        <div class="learn-cover__thesis">
          <p class="ds-meta-sm learn-muted">{c.eyebrow}</p>
          <h1 id="learn-title"><span class="ds-heading-2xl learn-cover__name">{c.title}</span><span class="ds-display-5xl learn-cover__promise" data-motion="fade">{c.promise}</span></h1>
        </div>
        <div class="learn-cover__authorship">
          <p class="ds-heading-xl">{c.role}</p>
          <p class="ds-body-sm learn-muted">{c.origin}</p>
          <TextLink type="arrow" href={c.previewHref} external externalLabel={externalLabel}>{c.preview}</TextLink>
        </div>
      </header>
      <div class="learn-cover__stage">
        <div class="learn-cover__home"><LearnShot shot={c.hero.home} loading="eager" presentation="canvas" /></div>
        <div class="learn-cover__answer"><LearnShot shot={c.hero.answer} loading="eager" /></div>
      </div>
      <p class="ds-body-lg learn-muted learn-cover__lead">{c.lead}</p>
      <nav class="learn-index" aria-label={c.navLabel}>{['problem', 'shared-material', 'reference-path', 'workspace', 'assessment'].map((id, i) => <a class="ds-body-sm" href={`#${id}`}><span aria-hidden="true">0{i + 1}</span>{c.nav[i]}</a>)}</nav>
    </div>
  </section>
  <div class="learn-sheet">
    <section class="ds-container learn-section" id="problem" aria-labelledby="problem-title">
      <header class="learn-head"><p class="ds-meta-sm learn-muted">{problem.label}</p><div class="learn-copy"><h2 id="problem-title" class="ds-heading-4xl" data-motion="fade">{problem.title}</h2><p class="ds-body-lg learn-muted">{problem.body}</p></div></header>
      <div class="learn-problem">
        <figure class="learn-archive"><p class="ds-body-sm learn-muted">{problem.archive}</p><CaseScreen item={{ src: '/media/case-learn/before-catalog.webp', alt: problem.archiveAlt, device: 'panel' }} appearance="frame" /><figcaption class="ds-body-sm learn-muted">{problem.caption}</figcaption></figure>
        <div class="learn-jobs">{problem.jobs.map((job, i) => <div class="learn-job"><p class="ds-meta-sm learn-muted">0{i + 1} / {job.label}</p><h3 class="ds-heading-2xl">{job.title}</h3><p class="ds-body-base learn-muted">{job.text}</p></div>)}</div>
      </div>
    </section>
    <section class="learn-system" id="shared-material" aria-labelledby="shared-title">
      <div class="ds-container learn-section">
        <header class="learn-head"><p class="ds-meta-sm learn-muted">{shared.label}</p><div class="learn-copy"><h2 id="shared-title" class="ds-heading-4xl" data-motion="fade">{shared.title}</h2><p class="ds-body-lg learn-muted">{shared.body}</p></div></header>
        <div class="learn-model" data-story-document><p class="ds-body-sm learn-muted">{shared.diagram}</p><Diagram data={learnContentModel} lang={locale} /></div>
        <div class="learn-system__rule"><h3 class="ds-heading-3xl">{shared.rule}</h3><p class="ds-body-base learn-muted">{shared.consequence}</p></div>
      </div>
    </section>
    <section class="ds-container learn-section" id="reference-path" aria-labelledby="reference-title">
      <header class="learn-head"><p class="ds-meta-sm learn-muted">{reference.label}</p><div class="learn-copy"><h2 id="reference-title" class="ds-heading-4xl" data-motion="fade">{reference.title}</h2><p class="ds-body-lg learn-muted">{reference.body}</p></div></header>
      <div class="learn-reference"><LearnShot shot={reference.shot} presentation="canvas" /></div>
    </section>
    <section class="ds-container learn-section" id="guided-path" aria-labelledby="guided-title">
      <header class="learn-head"><p class="ds-meta-sm learn-muted">{guided.label}</p><div class="learn-copy"><h2 id="guided-title" class="ds-heading-4xl" data-motion="fade">{guided.title}</h2><p class="ds-body-lg learn-muted">{guided.body}</p></div></header>
      <div class="learn-programme"><LearnShot shot={{ ...guided.path, caption: guided.pathCaption }} presentation="canvas" /></div>
      <div class="learn-completion" id="completion">
        <div class="learn-copy"><h3 class="ds-heading-3xl">{guided.actionTitle}</h3><p class="ds-body-lg learn-muted">{guided.actionBody}</p><p class="ds-body-sm learn-muted learn-access">{guided.access}</p></div>
        <LearnShot shot={{ desktop: 'completion-mobile', alt: guided.actionAlt }} />
      </div>
    </section>
    <section class="learn-workspace" id="workspace" aria-labelledby="workspace-title">
      <div class="ds-container learn-section">
        <header class="learn-head"><p class="ds-meta-sm learn-muted">{workspace.label}</p><div class="learn-copy"><h2 id="workspace-title" class="ds-heading-4xl" data-motion="fade">{workspace.title}</h2><p class="ds-body-lg learn-muted">{workspace.body}</p></div></header>
        <div class="learn-learner"><LearnShot shot={workspace.learner} /></div>
        <div class="learn-counterexample"><div class="learn-copy"><h3 class="ds-heading-3xl">{workspace.counterTitle}</h3><p class="ds-body-lg learn-muted">{workspace.counterBody}</p></div><LearnShot shot={workspace.reader} /></div>
      </div>
    </section>
    <section class="ds-container learn-section" id="assessment" aria-labelledby="assessment-title">
      <header class="learn-head"><p class="ds-meta-sm learn-muted">{assessment.label}</p><div class="learn-copy"><h2 id="assessment-title" class="ds-heading-4xl" data-motion="fade">{assessment.title}</h2><p class="ds-body-lg learn-muted">{assessment.body}</p></div></header>
      <div class="learn-assessment__evidence"><LearnShot shot={assessment.failed} /><div class="learn-recovery" id="recovery"><h3 class="ds-heading-2xl">{assessment.reviewTitle}</h3><p class="ds-body-base learn-muted">{assessment.reviewBody}</p><LearnShot shot={assessment.review} /></div></div>
      <p class="ds-body-sm learn-muted learn-assessment__rules">{assessment.rules}</p>
      <div class="learn-passed"><div class="learn-copy"><p class="ds-meta-sm learn-muted">{assessment.scoreNote}</p><h3 class="ds-heading-3xl">{assessment.passTitle}</h3><p class="ds-body-base learn-muted">{assessment.passBody}</p></div><LearnShot shot={assessment.passed} /></div>
    </section>
    <section class="ds-container learn-section learn-outcome" id="outcome" aria-labelledby="outcome-title">
      <header class="learn-head"><p class="ds-meta-sm learn-muted">{outcome.label}</p><div class="learn-copy"><h2 id="outcome-title" class="ds-heading-4xl" data-motion="fade">{outcome.title}</h2><p class="ds-body-lg learn-muted">{outcome.body}</p></div></header>
      <dl class="learn-delivery">{outcome.proof.map(item => <div><dt class="ds-heading-2xl">{item.label}</dt><dd class="ds-body-base learn-muted">{item.text}</dd></div>)}</dl>
      <div class="learn-outcome__limits"><div class="learn-copy"><h3 class="ds-heading-xl">{outcome.tradeLabel}</h3><p class="ds-body-base learn-muted">{outcome.trade}</p></div><div class="learn-copy"><h3 class="ds-heading-xl">{outcome.nextLabel}</h3><p class="ds-body-base learn-muted">{outcome.next}</p></div></div>
      <div class="learn-outcome__links"><TextLink type="arrow" href={c.previewHref} external externalLabel={externalLabel}>{outcome.cta}</TextLink><TextLink type="arrow" href={outcome.landingHref} external externalLabel={externalLabel}>{outcome.landing}</TextLink><p class="ds-body-sm learn-muted">{outcome.note}</p></div>
    </section>
  </div>
  <CaseNext {...next} transitionKey={`case-${next.theme}`} />
</article>
<style>
  :global(main:has(> .learn-case)) { padding-block-start: 0; }
  .learn-case { min-inline-size: 0; }
  .learn-case :global(.case-next__label) { color: var(--text-default); }
  .learn-cover { background: var(--surface-subtle); }
  .learn-cover__inner { display: grid; gap: var(--flow-node); padding-block: var(--flow-group); }
  .learn-cover__head { display: grid; gap: var(--flow-text); }
  .learn-cover__thesis { display: grid; gap: var(--flow-text); }
  .learn-cover h1 { margin: 0; display: grid; gap: var(--flow-text); }
  .learn-cover__name { display: block; }
  .learn-cover__promise { display: block; white-space: pre-line; max-inline-size: 21ch; text-wrap: balance; }
  .learn-cover__authorship { display: grid; gap: var(--flow-pair); align-content: start; max-inline-size: var(--measure-case); }
  .learn-cover__stage { display: grid; gap: var(--flow-text); align-items: center; }
  .learn-cover__home, .learn-cover__answer { min-inline-size: 0; }
  .learn-cover__answer { max-inline-size: calc(var(--space-48) * 2); }
  .learn-cover__lead { max-inline-size: var(--measure-lead); }
  .learn-index { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); border-block-start: var(--border-width) solid var(--border-default); padding-block-start: var(--flow-pair); }
  .learn-index a { display: flex; gap: var(--space-2); min-block-size: var(--space-12); align-items: center; color: var(--text-default); text-underline-offset: var(--space-1); }
  .learn-index a span { color: var(--text-subtle); font-variant-numeric: tabular-nums; }
  .learn-index a:active { color: var(--text-link-pressed); }
  .learn-muted { color: var(--text-subtle); }
  .learn-sheet { --learn-step: var(--space-24); padding-block: var(--learn-step); }
  .learn-sheet > * + * { margin-block-start: var(--learn-step); }
  .learn-section { scroll-margin-block-start: var(--flow-node); }
  .learn-section > * + * { margin-block-start: var(--flow-group); }
  .learn-head, .learn-copy { display: grid; gap: var(--flow-text); align-content: start; }
  .learn-copy { min-inline-size: 0; max-inline-size: var(--measure-lead); }
  .learn-head h2 { max-inline-size: 24ch; text-wrap: balance; overflow-wrap: anywhere; }
  .learn-problem { display: grid; gap: var(--flow-node); align-items: start; }
  .learn-archive { display: grid; gap: var(--flow-pair); min-inline-size: 0; }
  .learn-jobs { display: grid; gap: var(--flow-node); }
  .learn-job { display: grid; gap: var(--flow-pair); border-block-start: var(--border-width) solid var(--border-strong); padding-block-start: var(--flow-text); }
  .learn-system, .learn-workspace { background: var(--surface-subtle); padding-block: var(--flow-block); }
  .learn-model { display: grid; gap: var(--flow-text); min-inline-size: 0; }
  .learn-system__rule { display: grid; gap: var(--flow-text); border-block-start: var(--border-width) solid var(--border-strong); padding-block-start: var(--flow-text); }
  .learn-system__rule p { max-inline-size: var(--measure-case); }
  .learn-reference, .learn-programme, .learn-learner { min-inline-size: 0; }
  .learn-completion, .learn-counterexample, .learn-passed { display: grid; gap: var(--flow-node); align-items: center; }
  .learn-completion > :last-child, .learn-counterexample > :last-child { max-inline-size: calc(var(--space-48) * 2); }
  .learn-access { border-block-start: var(--border-width) solid var(--border-default); padding-block-start: var(--flow-text); }
  .learn-assessment__evidence { display: grid; gap: var(--flow-node); align-items: start; }
  .learn-recovery { display: grid; gap: var(--flow-text); min-inline-size: 0; }
  .learn-assessment__rules { max-inline-size: var(--measure-lead); border-inline-start: var(--border-width) solid var(--border-strong); padding-inline-start: var(--space-4); }
  .learn-passed { border-block-start: var(--border-width) solid var(--border-default); padding-block-start: var(--flow-group); }
  .learn-delivery { display: grid; gap: var(--flow-node); }
  .learn-delivery > div { display: grid; gap: var(--flow-text); border-block-start: var(--border-width) solid var(--border-strong); padding-block-start: var(--flow-text); }
  .learn-outcome__limits { display: grid; gap: var(--flow-node); }
  .learn-outcome__links { display: flex; flex-wrap: wrap; gap: var(--flow-text) var(--space-8); align-items: center; }
  .learn-outcome__links > p { flex-basis: 100%; }
  @media (--can-hover) { .learn-index a:hover { color: var(--text-link-hover); } }
  @media (--below-bp-lg) {
    .learn-model :global(.dg-responsive__desktop) { display: none; }
    .learn-model :global(.dg-responsive__mobile) { display: block; }
  }
  @media (--bp-md) {
    .learn-cover__stage { grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: var(--space-6); }
    .learn-cover__answer { max-inline-size: none; }
    .learn-jobs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
    .learn-system__rule { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12); }
    .learn-completion, .learn-counterexample { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-12); }
    .learn-completion > :last-child, .learn-counterexample > :last-child { justify-self: end; }
    .learn-delivery { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
    .learn-outcome__limits { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12); }
  }
  @media (--bp-lg) {
    .learn-cover__head { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-16); align-items: end; }
    .learn-cover__stage { grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: var(--space-8); }
    .learn-sheet { --learn-step: var(--space-32); }
    .learn-head { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--gutter); }
    .learn-head > .learn-muted { padding-block-start: var(--space-2); }
    .learn-problem { grid-template-columns: minmax(0, 8fr) minmax(0, 3fr); gap: var(--space-12); align-items: center; }
    .learn-jobs { grid-template-columns: minmax(0, 1fr); }
    .learn-reference { padding-inline-start: var(--space-24); }
    .learn-programme { padding-inline-end: var(--space-24); }
    .learn-completion, .learn-counterexample { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); margin-inline: var(--space-24); }
    .learn-assessment__evidence { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-12); }
    .learn-passed { grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: var(--space-16); }
  }
</style>
