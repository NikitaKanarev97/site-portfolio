---
import AgentShot from './AgentShot.astro';
import { agentCaseEn } from '../../copy/cases/agent-ops-v2';
import { agentCaseRu } from '../../copy/ru/cases/agent-ops-v2';
interface Props { locale: 'en' | 'ru'; loading?: 'eager' | 'lazy' }
const { locale, loading = 'lazy' } = Astro.props;
const copy = (locale === 'ru' ? agentCaseRu : agentCaseEn).home;
---
<div class:list={['agent-home', locale === 'ru' && 'agent-home--ru']}>
  <div class="agent-home__scene">
    <AgentShot locale={locale} loading={loading} zoom={false} href={`${locale === 'ru' ? '/ru' : ''}/work/agent-ops-console`} shot={{ desktop: 'home-consequences-desktop', mobile: 'home-consequences-mobile', alt: copy.alt }} />
  </div>
  <div class="agent-home__story">
    <p class="ds-meta-sm agent-home__label">{copy.label}</p>
    <p class="ds-heading-3xl">{copy.title}</p>
    <p class="ds-body-base agent-home__body">{copy.body}</p>
  </div>
</div>
<style>
  :global(#work-agent-ops-console .featured-case__stage) { padding: 0; background: var(--surface-subtle); color: var(--text-default); }
  .agent-home { --focus-ring-color: var(--border-focus); display: grid; gap: var(--flow-node); padding: var(--space-4); background: var(--surface-subtle); color: var(--text-default); border-radius: var(--radius-media); }
  .agent-home__story { display: grid; gap: var(--flow-pair); align-content: center; }
  .agent-home__story p { margin: 0; }
  .agent-home__body, .agent-home__label { color: var(--text-subtle); }
  .agent-home__scene { display: grid; min-inline-size: 0; align-items: center; justify-items: center; }
  @media (--bp-xl) {
    .agent-home { grid-template-columns: minmax(0, 2fr) minmax(0, 5fr); gap: var(--space-12); padding:var(--space-4) var(--stage-inset); }
    .agent-home--ru { grid-template-columns: minmax(min-content, 2fr) minmax(0, 5fr); }
    .agent-home__story { grid-column:1; grid-row:1; gap:var(--flow-text); }
    .agent-home__scene { grid-column:2; grid-row:1; justify-items:end; }
  }
</style>
