---
/** Ordered composition; Case modules still own their visuals and motion declarations. */
import MetaList from './MetaList.astro';
import CaseCover from './CaseCover.astro';
import CaseSheet from './CaseSheet.astro';
import CaseThesis from './CaseThesis.astro';
import CaseNumbers from './CaseNumbers.astro';
import CaseArtifact from './CaseArtifact.astro';
import CaseCallout from './CaseCallout.astro';
import CaseShot from './CaseShot.astro';
import CaseCarousel from './CaseCarousel.astro';
import CaseSteps from './CaseSteps.astro';
import CaseRoutes from './CaseRoutes.astro';
import CaseSpecimen from './CaseSpecimen.astro';
import CaseImpact from './CaseImpact.astro';
import CaseNext from './CaseNext.astro';
import { defineStory, type CaseStory, type CaseTheme } from '../copy/cases/story';
interface Props {
  story: CaseStory;
  lang?: 'en' | 'ru';
  id?: string;
  next: { href: string; title: string; theme: CaseTheme; label: string };
}
const { story: input, lang = 'en', id = 'case-story', next } = Astro.props;
const story = defineStory(input);
const label = (block: CaseStory['blocks'][number]) => {
  if (block.type === 'steps') return block.payload.label;
  if (block.type === 'outcome') return block.payload.result.thesis;
  if (block.type === 'thesis') return block.payload.thesis;
  if (block.payload.thesis) return block.payload.thesis.thesis;
  if (block.type === 'specimen') return block.payload.specimen.title;
  if (block.type === 'shot') return block.payload.shot.caption;
  if (block.type === 'artifact') return block.payload.artifact.caption;
  return undefined;
};
---
<div class:list={['pilot', 'case-story', `case-story--${story.theme}`]} data-h="case" data-story-version="blocks-v1" data-word-budget="450" id={id}>
  <CaseCover theme={story.theme} title={story.cover.title} outcome={story.cover.outcome} media={story.cover.media} locale={lang} transitionKey={`case-${story.theme}`} />
  <CaseSheet>
    <div class="ds-container"><MetaList layout="facts" items={story.facts} /></div>
    {story.blocks.map(block => (
      <section class:list={['ds-container', 'ds-section', block.type === 'outcome' && block.payload.presentation === 'editorial' && 'case-story__finale']} id={block.id} aria-label={label(block)} data-block-type={block.type} data-evidence-id={block.evidenceId} data-media-id={block.mediaId} data-story-motion={block.motion}>
        {block.type === 'thesis' && <CaseThesis {...block.payload} />}
        {block.type === 'numbers' && <>
          <CaseThesis {...block.payload.thesis} />
          <CaseNumbers items={block.payload.items} />
          {block.payload.note && <p class="ds-body-sm case-story__estimate" data-h="para">{block.payload.note}</p>}
        </>}
        {block.type === 'artifact' && <>
          {block.payload.thesis && <CaseThesis {...block.payload.thesis} />}
          <CaseArtifact artifact={block.payload.artifact} tone={story.plate} lang={lang} />
        </>}
        {block.type === 'comparison' && <>
          <CaseThesis {...block.payload.thesis} />
          <CaseCallout callout={block.payload.issue} tone="issue" plate={story.plate} />
          {block.payload.after && <CaseShot shot={block.payload.after} tone={story.plate} />}
        </>}
        {block.type === 'process' && <>
          <CaseThesis {...block.payload.thesis} />
          <CaseCarousel {...block.payload} label={block.payload.thesis.label} prevLabel={lang === 'ru' ? 'Предыдущий материал' : 'Previous material'} nextLabel={lang === 'ru' ? 'Следующий материал' : 'Next material'} lang={lang} tone={story.plate} />
        </>}
        {block.type === 'steps' && (block.payload.composition === 'routes'
          ? <CaseRoutes {...block.payload} idPrefix={block.id} />
          : <CaseSteps {...block.payload} composition={block.payload.composition} variant={block.motion === 'focus' ? 'focus' : undefined} tone={story.plate} />)}
        {block.type === 'shot' && <>
          {block.payload.thesis && <CaseThesis {...block.payload.thesis} />}
          <CaseShot shot={block.payload.shot} tone={story.plate} />
        </>}
        {block.type === 'detail' && <>
          <CaseThesis {...block.payload.thesis} />
          <CaseCallout callout={block.payload.callout} plate={story.plate} />
        </>}
        {block.type === 'specimen' && <>
          {block.payload.thesis && <CaseThesis {...block.payload.thesis} />}
          <CaseSpecimen specimen={block.payload.specimen} tone={story.plate} lang={lang} />
        </>}
        {block.type === 'outcome' && <>
          <div class:list={['ds-section', 'case-story__result-body', block.payload.presentation === 'editorial' && 'case-story__finale-body']}>
          <CaseThesis {...block.payload.result} variant={block.payload.presentation} />
          <CaseImpact outcome={block.payload} cards={block.payload.cards} quote={block.payload.quote} variant={block.payload.presentation} />
          </div>
        </>}
      </section>
    ))}
  </CaseSheet>
  <CaseNext {...next} transitionKey={`case-${next.theme}`} />
</div>
<style>
  :global(main:has(> .case-story)) { padding-block-start: 0; }
  .case-story { --cover-offset: calc(var(--space-12) + var(--space-6) * 2 + var(--border-width)); }
  .case-story__estimate { max-inline-size: var(--measure-case); color: var(--text-muted); text-wrap: pretty; }
  .case-story [data-story-motion='static'] :global([data-motion]) { opacity: 1; }
  .case-story__result-body {
    display: grid;
    gap: var(--flow-group);
    padding: var(--space-6);
    background: var(--surface-subtle);
    border-radius: var(--radius-media);
  }
  .case-story__result-body > :global(* + *) { margin-block-start: 0; }
  .case-story__finale-body {
    background: var(--surface-cover-agent);
    --text-default: var(--text-on-inverse);
    --text-subtle: var(--text-on-inverse);
    --text-meta: var(--text-on-inverse);
    --text-muted: var(--text-on-inverse);
  }
  .case-story__finale-body > :global(.case-thesis) { display: block; }
  /* Две колонки — с bp-xl. На 1024 половина плашки давала 352 px под
     display-5xl, и заголовок итога шёл по слову в строке. */
  @media (--bp-lg) {
    .case-story__result-body { padding: var(--space-12); }
  }
  @media (--bp-xl) {
    .case-story__finale-body { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); }
    .case-story__finale-body > :global(.case-thesis) { grid-column: 1; }
    .case-story__finale-body > :global(.case-impact--editorial) { display: contents; }
    .case-story__finale-body :global(.case-impact__cards) { grid-column: 1; grid-row: 2; }
    .case-story__finale-body :global(.case-impact__statements) { grid-column: 2; grid-row: 1 / span 2; align-self: start; }
  }
</style>
