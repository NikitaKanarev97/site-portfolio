---
/**
 * Address is a selectable mailto link. Action retains the hero copy API,
 * visible feedback and a polite announcement; a failed copy leaves the
 * real address available for selection. No extra control in ContactBlock.
 */
interface Props {
  email: string;
  appearance?: 'address' | 'action';
  label?: string;
  hint?: string;
  copiedLabel?: string;
  announce?: string;
  fallbackAnnounce?: string;
  class?: string;
}

const {
  email,
  appearance = 'address',
  label = 'Copy email',
  copiedLabel = 'Copied',
  announce = 'Email address copied to clipboard',
  fallbackAnnounce = 'Could not copy — select the email address or open it in your mail app',
  class: className,
} = Astro.props;
const isAddress = appearance === 'address';
const hint = Astro.props.hint ?? email;
const [addressLocal, addressDomain] = email.split('@');
---

<div class:list={['copy-email', `copy-email--${appearance}`, className]} data-copy-email={!isAddress || undefined}>
  {isAddress ? (
    <a class="copy-email__address ds-heading-3xl" href={`mailto:${email}`}>
      {addressDomain ? <Fragment>{addressLocal}<wbr />{`@${addressDomain}`}</Fragment> : email}
    </a>
  ) : (
    <Fragment>
      <button
        class="copy-email__button ds-body-base"
        type="button"
        data-copy-trigger
        data-email={email}
        data-state="default"
        data-hint-default={hint}
        data-hint-copied={copiedLabel}
        data-announce={announce}
        data-announce-fallback={fallbackAnnounce}
      >{label}</button>
      <p class="copy-email__hint ds-body-sm" data-copy-hint>{hint}</p>
      <p class="copy-email__failure ds-body-sm" data-copy-failure hidden>{fallbackAnnounce}</p>
      <p class="ds-visually-hidden" aria-live="polite" aria-atomic="true" data-copy-status></p>
    </Fragment>
  )}
</div>

<style>
  .copy-email {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
  }

  .copy-email__address {
    max-width: 100%;
    min-height: var(--space-12);
    overflow-wrap: anywhere;
    color: var(--text-default);
    text-decoration: none;
    user-select: text;
    transition: color var(--motion-state-duration) var(--motion-state-ease);
  }

  .copy-email__button {
    display: inline-flex;
    align-items: center;
    min-height: var(--space-12);
    padding: 0;
    color: var(--text-link);
    text-align: start;
    transition: color var(--motion-state-duration) var(--motion-state-ease);
  }

  .copy-email__address:active,
  .copy-email__button:active {
    color: var(--text-link-pressed);
  }

  .copy-email__address:focus-visible,
  .copy-email__button:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: var(--space-1);
  }

  .copy-email__hint,
  .copy-email__failure {
    color: var(--text-meta);
    overflow-wrap: anywhere;
  }

  .copy-email__hint {
    user-select: all;
    transition: color var(--motion-state-duration) var(--motion-state-ease);
  }

  .copy-email:has([data-state='copied']) .copy-email__hint {
    color: var(--text-success);
  }

  @media (--bp-md) {
    .copy-email--action {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-3);
    }

    .copy-email__failure {
      flex-basis: 100%;
    }
  }

  @media (--can-hover) {
    .copy-email__address:hover,
    .copy-email__button:hover {
      color: var(--text-link-hover);
      text-decoration: underline;
      text-decoration-thickness: var(--border-width);
      text-underline-offset: var(--space-1);
    }

    .copy-email__address:active,
    .copy-email__button:active {
      color: var(--text-link-pressed);
    }
  }
</style>

<script>
  const RESET_DELAY = 2000;
  const initialized = new WeakSet<HTMLElement>();
  const timers = new Set<number>();

  function initCopyEmail() {
    document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((root) => {
      if (initialized.has(root)) return;
      const button = root.querySelector<HTMLButtonElement>('[data-copy-trigger]');
      const hint = root.querySelector<HTMLElement>('[data-copy-hint]');
      const failure = root.querySelector<HTMLElement>('[data-copy-failure]');
      const status = root.querySelector<HTMLElement>('[data-copy-status]');
      if (!button || !hint || !failure || !status) return;
      initialized.add(root);
      let timer: number | undefined;

      const reset = () => {
        if (timer !== undefined) {
          window.clearTimeout(timer);
          timers.delete(timer);
        }
        button.dataset.state = 'default';
        hint.textContent = button.dataset.hintDefault ?? '';
        status.textContent = '';
        failure.hidden = true;
      };

      button.addEventListener('click', async () => {
        reset();
        try {
          await navigator.clipboard.writeText(button.dataset.email ?? '');
          if (!root.isConnected) return;
          button.dataset.state = 'copied';
          hint.textContent = button.dataset.hintCopied ?? '';
          status.textContent = button.dataset.announce ?? '';
          timer = window.setTimeout(() => {
            reset();
          }, RESET_DELAY);
          timers.add(timer);
        } catch {
          if (!root.isConnected) return;
          failure.hidden = false;
          status.textContent = button.dataset.announceFallback ?? '';
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initCopyEmail);
  document.addEventListener('astro:before-swap', () => {
    timers.forEach(timer => window.clearTimeout(timer));
    timers.clear();
  });
</script>
