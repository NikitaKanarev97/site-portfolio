---
/** Heading and optional body with the shared flow-node rhythm. The data label names its section. */
interface Props {
  label: string;
  thesis: string;
  body?: string;
  /** Уровень заголовка тезиса. В блоках страницы — h2. */
  as?: 'h2' | 'h3';
  class?: string;
  variant?: 'editorial';
}

const { thesis, body, as: Heading = 'h2', class: className, variant } = Astro.props as Props;
/*
 * Список классов вынесен из шаблона намеренно: фронтматтер, который
 * кончается на `as Props;`, компилятор Astro (convertToTSX) склеивает с
 * первым тегом шаблона в generic-сигнатуру, и пропсы компонента теряются
 * для astro check.
 */
const rootClass = ['case-thesis', 'ds-flow-lead', className];
---

<div class:list={rootClass}>
  <div class="case-thesis__text">
    <Heading class:list={[variant === 'editorial' ? 'ds-display-5xl' : 'ds-heading-4xl', 'case-thesis__thesis']} data-h="thesis" data-motion="lines">{thesis}</Heading>
    {body && <p class="ds-body-lg case-thesis__body" data-h="para" data-motion="fade">{body}</p>}
  </div>
</div>

<style>
  .case-thesis__text {
    max-inline-size: var(--measure-lead);
  }

  .case-thesis__thesis {
    margin: 0;
    color: var(--text-default);
    text-wrap: balance;
  }

  .case-thesis__body {
    margin: var(--flow-node) 0 0;
    max-inline-size: var(--measure-case);
    color: var(--text-subtle);
    text-wrap: pretty;
  }

</style>
