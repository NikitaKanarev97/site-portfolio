---
import WorkStage from './WorkStage.astro';
import IconArrow from './IconArrow.astro';
import type { home } from '../copy/home.ts';
interface Props {
  item: (typeof home.featured.items)[number];
  index: number;
  locale: 'en' | 'ru';
}
const { item, index, locale } = Astro.props;
const slug = item.href.split('/').filter(Boolean).at(-1)!;
const proof = item.meta.at(-1)!;
---
<article class:list={['featured-case', `featured-case--${item.theme}`]} id={`work-${slug}`} aria-labelledby={`title-${slug}`} data-case-card={`case-${item.theme}`}>
  <div class="featured-case__head">
    <div class="featured-case__identity">
      <h2 class="ds-display-6xl" id={`title-${slug}`}><a href={item.href}>{item.title}</a></h2>
    </div>
    <p class="ds-heading-xl featured-case__outcome">{item.outcome}</p>
  </div>
  <div class="featured-case__stage" data-focus-tone={item.theme === 'agent' ? 'inverse' : undefined}>
    <WorkStage theme={item.theme} media={item.media} locale={locale} loading={index === 0 ? 'eager' : 'lazy'} href={item.href} linkLabel={`${item.cta}: ${item.title}`} />
  </div>
  <div class="featured-case__foot">
    <div class="featured-case__facts ds-body-sm">
      <span><span class="ds-visually-hidden">{proof.term}: </span>{proof.value}</span>
    </div>
    <a href={item.href} class="featured-case__cta ds-body-base" id={`cta-${slug}`} aria-label={`${item.cta}: ${item.title}`}>
      {item.cta}<IconArrow class="featured-case__arrow" />
    </a>
  </div>
</article>
<style>
  .featured-case { position: relative; }
  .featured-case__cta::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .featured-case :global([data-zoom-trigger]), .featured-case :global(button), .featured-case__identity a { position: relative; z-index: 1; }
  .featured-case:has(.featured-case__cta:focus-visible) { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--space-2); }
  .featured-case { display: grid; gap: var(--flow-node); color: var(--text-default); text-decoration: none; border-radius: var(--radius-lg); scroll-margin-block-start: var(--space-6); }
  .featured-case__stage { min-inline-size: 0; }
  .featured-case--agent .featured-case__stage { padding: var(--stage-inset); border-radius: var(--radius-lg); background: var(--surface-cover-agent); color: var(--text-on-inverse); }
  .featured-case__head { display: grid; gap: var(--flow-text); align-items: end; }
  .featured-case__identity { min-inline-size: 0; }
  .featured-case__identity h2 { margin: 0; }
  .featured-case__identity a { color: inherit; text-decoration: none; }
  .featured-case__outcome { margin: 0; max-inline-size: var(--measure-case); }
  .featured-case__foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--flow-pair) var(--space-6); }
  .featured-case__facts { color: var(--text-meta); }
  .featured-case__cta { display: inline-flex; flex: none; align-items: center; min-block-size: var(--space-12); gap: var(--space-3); color: var(--text-link); text-decoration: none; transition: color var(--motion-hover-duration) var(--motion-hover-ease); }
  .featured-case__cta :global(.featured-case__arrow) { inline-size: var(--space-6); block-size: var(--space-6); flex: none; transition: transform var(--motion-hover-duration) var(--motion-hover-ease); }
  .featured-case__cta:focus-visible { outline-offset: var(--space-2); }
  .featured-case__cta:active { color: var(--text-link-pressed); }
  /* Move the common preview wrapper, including each theme's background.
     Agent's background belongs to this wrapper; the other scenes own theirs.
     Headings and facts stay still while the whole visual preview lifts. */
  .featured-case__stage { transition: transform var(--motion-hover-duration) var(--motion-hover-ease); }
  @media (--can-hover) {
    .featured-case:hover .featured-case__cta { color: var(--text-link-hover); }
    @media (prefers-reduced-motion: no-preference) {
      .featured-case:hover :global(.featured-case__arrow) { transform: translateX(var(--space-1)); }
      .featured-case:hover .featured-case__stage { transform: translateY(calc(var(--space-1) * -1)); }
    }
  }
  @media (--bp-lg) {
    .featured-case__head { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-16); }
  }
  @media (prefers-reduced-motion: reduce) {
    .featured-case__stage,
    .featured-case__cta,
    .featured-case__cta :global(.featured-case__arrow) { transition: none; }
  }
</style>
