---
import type { Artwork, CaseSlug } from '../copy/case-visuals.ts';
import { px } from '../lib/tokens.ts';

interface Props {
  slug: CaseSlug;
  artwork: Artwork;
  variant?: 'cover' | 'hero' | 'thumbnail';
  loading?: 'eager' | 'lazy';
}
const { slug, artwork, variant = 'cover', loading = 'lazy' } = Astro.props;
// One product moment, centred on the canvas instead of layered frames.
const moment = Boolean(artwork.moment);
// Same bp-md boundary as the CSS below; `media` is markup, custom media cannot reach it.
const MOBILE_MEDIA = `(max-width: ${px('bp-md') - 1}px)`;
---

<div
  class:list={['case-artwork', `case-artwork--${slug}`, `case-artwork--${variant}`, { 'case-artwork--moment': moment }]}
  role="img"
  aria-label={artwork.alt}
  data-motion={variant === 'cover' ? 'reveal-media' : undefined}
  data-motion-counter="none"
>
  <div class="case-artwork__canvas ds-media-mask">
    {artwork.images.map((src, index) => (
      <div class:list={['case-artwork__frame', index === 0 ? 'case-artwork__frame--main' : 'case-artwork__frame--detail']} aria-hidden="true">
        {index === 0 && artwork.mobile ? (
          <picture>
            <source media={MOBILE_MEDIA} srcset={artwork.mobile} />
            <img src={src} alt="" loading={loading} decoding="async" draggable="false" />
          </picture>
        ) : (
          <img src={src} alt="" loading={loading} decoding="async" draggable="false" />
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .case-artwork {
    --artwork-surface: var(--surface-media);
    overflow: hidden;
    border-radius: var(--radius-lg);
    isolation: isolate;
  }
  .case-artwork__canvas {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio-cover);
    background: var(--artwork-surface);
  }
  .case-artwork__frame {
    position: absolute;
    overflow: hidden;
    border: var(--border-width) solid var(--border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--elevation-artwork);
  }
  .case-artwork__frame img { width: 100%; height: auto; max-width: none; }
  .case-artwork__frame--main { width: 86%; inset-inline-start: 7%; inset-block-start: 9%; }
  .case-artwork__frame--detail { width: 42%; inset-inline-end: 5%; inset-block-end: 7%; }

  .case-artwork--agent-ops-console { --artwork-surface: var(--surface-cover-agent); }
  .case-artwork--agent-ops-console .case-artwork__frame { border-color: var(--border-inverse); }

  .case-artwork--partner-portal { --artwork-surface: var(--surface-cover-portal); }

  .case-artwork--learn { --artwork-surface: var(--surface-cover-learn); }

  .case-artwork--vet-clinic { --artwork-surface: var(--surface-cover-vet); }

  .case-artwork--pawly { --artwork-surface: var(--surface-cover-pawly); }
  /* Pawly phones are whole devices with their shadow baked in: no window chrome. */
  .case-artwork--pawly .case-artwork__frame { border: 0; border-radius: 0; box-shadow: none; overflow: visible; }

  /* One product moment: the crop is centred and never scaled past the card. */
  .case-artwork--moment .case-artwork__canvas { display: grid; place-items: center; }
  .case-artwork--moment .case-artwork__frame--main { position: relative; inset: auto; width: 88%; }
  /* Widths keep each moment inside the canvas height with an even margin. */
  .case-artwork--moment.case-artwork--vet-clinic .case-artwork__frame--main { width: 63%; }
  .case-artwork--moment.case-artwork--pawly .case-artwork__frame--main { width: 68%; }
  .case-artwork--moment.case-artwork--hero.case-artwork--pawly .case-artwork__frame--main { width: 70%; }

  /* The first image in a case is an independent, inspectable product moment. */
  .case-artwork--hero.case-artwork--agent-ops-console .case-artwork__frame--main { width: 81%; inset-inline-start: 5%; inset-block-start: 6%; }
  .case-artwork--hero.case-artwork--agent-ops-console .case-artwork__frame--detail { width: 58%; inset-inline-end: 4%; inset-block-end: 5%; }
  .case-artwork--hero.case-artwork--partner-portal .case-artwork__frame--main { width: 90%; inset-inline-start: 5%; inset-block-start: 7%; }
  .case-artwork--hero.case-artwork--vet-clinic .case-artwork__frame--main { width: 86%; inset-inline-start: 7%; inset-block-start: 7%; }
  .case-artwork--hero.case-artwork--learn .case-artwork__canvas { aspect-ratio: var(--ratio-screen); }
  .case-artwork--hero.case-artwork--learn .case-artwork__frame--main { width: 90%; inset-inline-start: 5%; inset-block-start: 5%; }

  /* Compact rows use the same composition, with no scroll reveal. */
  .case-artwork--thumbnail { border-radius: var(--radius-md); }
  .case-artwork--thumbnail .case-artwork__frame { border-radius: var(--radius-sm); }

  @media (--below-bp-md) {
    .case-artwork { border-radius: var(--radius-md); }
    .case-artwork__canvas { aspect-ratio: var(--ratio-cover-mobile); }
    .case-artwork__frame { border-radius: var(--radius-sm); }
    .case-artwork--hero .case-artwork__canvas { aspect-ratio: var(--ratio-cover-mobile); }
    .case-artwork--hero.case-artwork--agent-ops-console .case-artwork__frame--main { width: 126%; inset-inline-start: -16%; inset-block-start: 6%; }
    .case-artwork--hero.case-artwork--agent-ops-console .case-artwork__frame--detail { width: 90%; inset-inline-end: 5%; inset-block-end: 5%; }
    /* Разбор: рельс развёрнут, 13,6 % ширины. 117 % / −16 % начинает окно на
       краю рельса и доводит до 99 % — колонка действий в кадре. */
    .case-artwork--hero.case-artwork--partner-portal .case-artwork__frame--main { width: 117%; inset-inline-start: -16%; inset-block-start: 7%; }
    .case-artwork--hero.case-artwork--vet-clinic .case-artwork__frame--main { width: 116%; inset-inline-start: -8%; inset-block-start: 7%; }
    .case-artwork--hero.case-artwork--learn .case-artwork__canvas { aspect-ratio: var(--ratio-cover-mobile); }
    .case-artwork--hero.case-artwork--learn .case-artwork__frame--main { width: 116%; inset-inline-start: 5%; inset-block-start: 6%; }
    .case-artwork--hero.case-artwork--pawly .case-artwork__canvas { aspect-ratio: var(--ratio-cover-phone); }
    .case-artwork--thumbnail .case-artwork__canvas { aspect-ratio: var(--ratio-cover-mobile); }
    /* The phone crop is taller than 4:3 would hold at a readable size. */
    .case-artwork--moment.case-artwork--cover .case-artwork__canvas { aspect-ratio: var(--ratio-cover-moment-mobile); }
    .case-artwork--moment.case-artwork--vet-clinic .case-artwork__frame--main { width: 84%; }
    .case-artwork--moment.case-artwork--pawly .case-artwork__frame--main { width: 90%; }
    .case-artwork--moment.case-artwork--hero.case-artwork--pawly .case-artwork__frame--main { width: 86%; }
  }
</style>
