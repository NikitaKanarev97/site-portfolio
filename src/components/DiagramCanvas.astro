---
/**
 * Diagram — ds/components.md, нотация в ds/patterns.md §Диаграммы
 *
 * Четыре вида артефакта кейса одной нотацией: карта экранов (map),
 * user flow (flow), карта прототипа (prototype), лист библиотеки
 * компонентов (library). Рисует только из файла данных
 * src/data/diagrams/**, ручной вёрстки и растра нет.
 *
 * Первые три — SVG. Геометрию считает src/lib/diagram.ts на сборке,
 * цвета приходят классами из токенов --diagram-*, поэтому тема кейса
 * (`data-theme="dark"` на предке) переключает схему без пересборки.
 * Лист библиотеки — HTML: типографику таблицей обязан читать скринридер,
 * а образцы набираются живым текстом.
 *
 * Ширина. SVG вписан в колонку и не растягивается шире своего поля.
 * Ниже bp-md он держит натуральный размер, и схема прокручивается
 * внутри своего контейнера, а не ломает страницу; выше — может сжаться
 * до кегля 12 px у подписи узла, дальше тоже прокрутка.
 *
 * Движение. Компонент ничего не анимирует: линии связей объявляют
 * data-motion="draw", хореографию ведёт src/scripts/animations.js.
 * Reduce/no-JS оставляют линии в конечном состоянии; responsive
 * Diagram выбирает геометрию тем же renderer.
 *
 * Доступность. Сам SVG скрыт от скринридера, вместо него — область
 * прокрутки с именем схемы и визуально скрытая расшифровка: summary
 * из данных и перечень связей «откуда → куда».
 */
import type { Diagram, GraphDiagram, Label, LibraryDiagram, LibraryItem } from '../data/diagrams/schema';
import { PAD, badgeBox, decisionLines, diamond, layout, measure, parallelogram, pillText, wireframe } from '../lib/diagram';
import { px } from '../lib/tokens';

interface Props {
  data: Diagram;
  lang?: 'en' | 'ru';
  class?: string;
}

const { data, lang = 'en', class: className } = Astro.props;
const t = (label: Label | undefined) => (label ? label[lang] : '');


/* ---------- Граф ---------- */
const graph = data.kind === 'library' ? undefined : layout(data as GraphDiagram);
const minScale = px('diagram-note-size') / px('diagram-label-size');
const graphStyle = graph
  ? `--dg-w: ${graph.width}px; --dg-min: ${Math.round(graph.width * minScale)}px;`
  : undefined;
const nodeName = new Map((data.kind === 'library' ? [] : (data as GraphDiagram).nodes).map((n) => [n.id, t(n.label)]));

/* ---------- Лист библиотеки ---------- */
const lib = data.kind === 'library' ? (data as LibraryDiagram) : undefined;

/** Тёмный ли фон: подпись карточки цвета берёт контрастный текст ДС. */
function isDark(hex: string, alpha = 100): boolean {
  const n = Number.parseInt(hex.replace('#', ''), 16);
  const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
    const c = v / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  const l = 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
  return alpha >= 50 && l < 0.4;
}

function swatchBg(hex: string, alpha?: number): string {
  if (alpha === undefined) return hex;
  const n = Number.parseInt(hex.replace('#', ''), 16);
  const rgba = `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha / 100})`;
  // Полупрозрачный оттенок показан на поверхности продукта, а не на поле
  // схемы: на тёмной теме кейса он иначе сливается с фоном.
  return `linear-gradient(${rgba}, ${rgba}), var(--lib-surface)`;
}

/* Палитра и шрифт продукта — данные чужого продукта, не токены ДС
   (ds/patterns.md §Диаграммы, «Лист библиотеки»). */
const libStyle = lib
  ? [
      `--lib-font: "${lib.fontFamily}", var(--font-body)`,
      `--lib-primary: ${lib.palette.primary}`,
      `--lib-primary-pressed: ${lib.palette.primaryPressed}`,
      `--lib-primary-light: ${lib.palette.primaryLight}`,
      `--lib-ink: ${lib.palette.ink}`,
      `--lib-muted: ${lib.palette.muted}`,
      `--lib-line: ${lib.palette.line}`,
      `--lib-surface: ${lib.palette.surface}`,
      `--lib-error: ${lib.palette.error}`,
      `--lib-radius: ${lib.radius}px`,
    ].join('; ')
  : undefined;

const itemKey = (item: LibraryItem) => `lib-item lib-${item.block} is-${item.state ?? 'default'}`;

/** Соседние вкладки — одна полоса в ряд, остальные блоки — столбиком. */
function rows(items: LibraryItem[]): LibraryItem[][] {
  const out: LibraryItem[][] = [];
  for (const item of items) {
    const last = out[out.length - 1];
    if (item.block === 'tab' && last?.[0].block === 'tab') last.push(item);
    else out.push([item]);
  }
  return out;
}
---

<figure class:list={['dg', `dg--${data.kind}`, className]}>
  {
    graph && (
      <>
        {data.kind !== 'library' && data.heading && (
          <header class="dg__heading ds-heading-2xl">
            <span>{t(data.heading.lead)}</span> <span class="dg__heading-name">{t(data.heading.name)}</span>
          </header>
        )}
        <div class="dg__scroll" role="region" tabindex="0" aria-label={t(data.title)}>
          <svg
            data-motion-group
            data-motion-stagger="tight"
            class="dg__svg"
            viewBox={`${-PAD} ${-PAD} ${graph.width} ${graph.height}`}
            width={graph.width}
            height={graph.height}
            style={graphStyle}
            aria-hidden="true"
            focusable="false"
          >
            {/* Рамки функций и групп — под всем остальным. */}
            {graph.nodes.map(({ node, box, frame }) => (
              <>
                {frame && (
                  <rect class:list={['dg-group', node.dim && 'is-dim']} x={frame.x} y={frame.y} width={frame.w} height={frame.h} rx={px('diagram-corner')} />
                )}
                {node.type === 'group' && (
                  <>
                  <rect class:list={['dg-group', node.dim && 'is-dim']} x={box.x} y={box.y} width={box.w} height={box.h} rx={px('diagram-corner')} />
                  {node.label && <text class:list={['dg-note', node.dim && 'is-dim']} x={box.x + 2 * px('diagram-cell')} y={box.y + 5 * px('diagram-cell')}>{t(node.label)}</text>}
                  </>
                )}
              </>
            ))}

            {/* Экраны прототипа — под связями: кривые идут поверх рамок. */}
            {graph.nodes
              .filter(({ node }) => node.type === 'frame')
              .map(({ node, box }) => (
                <g class:list={['dg-frame', node.dim && 'is-dim']}>
                  <rect class="dg-frame__screen" x={box.x} y={box.y} width={box.w} height={box.h} rx={px('diagram-node-radius')} />
                  {wireframe(box, node.wire).map((s) =>
                    s.kind === 'line' ? (
                      <line class="dg-wire-line" x1={s.x} y1={s.y} x2={s.x + s.w} y2={s.y} />
                    ) : (
                      <rect class={`dg-wire-${s.kind}`} x={s.x} y={s.y} width={s.w} height={s.h} rx={px('diagram-node-radius') / 2} />
                    ),
                  )}
                </g>
              ))}

            {graph.edges.map(({ edge, d, head }) => (
              <g class:list={['dg-edge', `dg-edge--${data.kind}`, edge.dim && 'is-dim']}>
                <path d={d} data-motion="draw" />
                {head && <path class="dg-edge__head" d={head} />}
              </g>
            ))}

            {graph.edges.map(({ edge, hotspot }) =>
              hotspot ? <circle class:list={['dg-hotspot', edge.dim && 'is-dim']} cx={hotspot[0]} cy={hotspot[1]} r={px('diagram-cell') / 2} /> : null,
            )}

            {/* Названия экранов прототипа — над кривыми, на подложке цвета поля:
                кривая прерывается вокруг подписи, а не идёт сквозь буквы. */}
            {graph.nodes
              .filter(({ node }) => node.type === 'frame')
              .map(({ node, box }) => {
                const size = px('diagram-label-size');
                const knock = px('diagram-cell') / 2;
                const baseline = box.y - px('diagram-cell');
                return (
                  <g class:list={[node.dim && 'is-dim']}>
                    <rect
                      class="dg-frame__knock"
                      x={box.x - knock}
                      y={baseline - size - knock / 2}
                      width={measure(t(node.label), size) + 2 * knock}
                      height={size * 1.3 + knock}
                      rx={px('diagram-node-radius')}
                    />
                    <text class="dg-frame__name" x={box.x} y={baseline}>{t(node.label)}</text>
                  </g>
                );
              })}

            {graph.nodes
              .filter(({ node }) => node.type !== 'frame' && node.type !== 'group')
              .map(({ node, box, actions }) => {
                const cx = box.x + box.w / 2;
                const cy = box.y + box.h / 2;
                const label = t(node.label);
                return (
                  <g class:list={['dg-node', `dg-node--${node.type}`, node.dim && 'is-dim']}>
                    {(node.type === 'screen' || node.type === 'entry' || node.type === 'flowLink') && (
                      <rect class="dg-node__shape" x={box.x} y={box.y} width={box.w} height={box.h} rx={px('diagram-node-radius')} />
                    )}
                    {node.type === 'decision' && <path class="dg-node__shape" d={diamond(box)} />}
                    {node.type === 'input' && <path class="dg-node__shape" d={parallelogram(box)} />}

                    {node.type === 'start' ? (
                      <>
                        {/* Подпись прижата к черте: ширина узла посчитана по длинной
                            локали, и в короткой зазор до черты иначе растёт. */}
                        <text class="dg-label" x={box.x + box.w - 2 * px('diagram-cell')} y={cy} text-anchor="end">{label}</text>
                        <line class="dg-start-bar" x1={box.x + box.w} y1={cy - 1.5 * px('diagram-cell')} x2={box.x + box.w} y2={cy + 1.5 * px('diagram-cell')} />
                      </>
                    ) : node.type === 'decision' ? (
                      (() => {
                        const lines = decisionLines(box, label);
                        const lh = px('diagram-note-size') * 1.3;
                        return lines.map((line, i) => (
                          <text class="dg-note" x={cx} y={cy + (i - (lines.length - 1) / 2) * lh} text-anchor="middle">{line}</text>
                        ));
                      })()
                    ) : (
                      <text class="dg-label" x={cx} y={cy} text-anchor="middle">{label}</text>
                    )}

                    {actions.map((a) => (
                      <>
                        <text class="dg-note dg-note--action" x={a.x + px('diagram-cell')} y={a.y - px('diagram-cell')}>{t(a.label)}{a.external ? ' ↗' : ''}</text>
                        <line class="dg-action-rule" x1={a.x} y1={a.y} x2={a.x + a.w} y2={a.y} />
                      </>
                    ))}

                    {node.num !== undefined &&
                      (() => {
                        const b = badgeBox(box, node.num!);
                        return (
                          <>
                            <rect class="dg-badge" x={b.x} y={b.y} width={b.w} height={b.h} />
                            <text class="dg-badge__num" x={b.x + b.w / 2} y={b.y + b.h / 2} text-anchor="middle">{node.num}</text>
                          </>
                        );
                      })()}
                  </g>
                );
              })}

            {graph.edges.map(({ edge, pill }) =>
              pill ? (
                <g class:list={['dg-pill', `dg-pill--${pill.answer}`]}>
                  {/* Подложка цвета поля — вне приглушения: иначе бледная
                      таблетка просвечивает линию, на которой стоит. */}
                  <rect class="dg-pill__knock" x={pill.x} y={pill.y} width={pill.w} height={pill.h} rx={px('diagram-node-radius')} />
                  <g class:list={[edge.dim && 'is-dim']}>
                  <rect class="dg-pill__bg" x={pill.x} y={pill.y} width={pill.w} height={pill.h} rx={px('diagram-node-radius')} />
                  <text x={pill.x + pill.w / 2} y={pill.y + pill.h / 2} text-anchor="middle">{t(pillText[pill.answer])}</text>
                  </g>
                </g>
              ) : null,
            )}
          </svg>
        </div>
        <div class="ds-visually-hidden">
          <p>{t(data.summary)}</p>
          {data.kind !== 'prototype' && (
            <ul>
              {(data as GraphDiagram).edges
                .filter((edge) => edge.to)
                .map((edge) => (
                  <li>
                    {nodeName.get(edge.from)} {lang === 'ru' ? 'ведёт в' : 'leads to'} {nodeName.get(edge.to!)}
                    {edge.answer ? ` (${t(pillText[edge.answer])})` : ''}
                  </li>
                ))}
            </ul>
          )}
        </div>
      </>
    )
  }

  {
    lib && (
      <div class="lib" style={libStyle}>
        <h3 class="lib__title ds-heading-3xl">{t(lib.heading)}</h3>
        <p class="ds-visually-hidden">{t(lib.summary)}</p>

        <div class="lib__grid">
          <div class="lib__foundation">
            <table class="lib__type">
              <caption class="ds-visually-hidden">{t(lib.title)}</caption>
              <thead class="ds-visually-hidden">
                <tr>
                  <th scope="col">{lang === 'ru' ? 'Стиль' : 'Style'}</th>
                  <th scope="col">{lang === 'ru' ? 'Где используется' : 'Usage'}</th>
                  <th scope="col">{lang === 'ru' ? 'Кегль и начертание' : 'Size and weight'}</th>
                  <th scope="col">{lang === 'ru' ? 'Образец' : 'Sample'}</th>
                </tr>
              </thead>
              <tbody>
                {lib.type.map((row) => (
                  <tr>
                    <th scope="row" class="lib__style ds-body-base">{row.style}</th>
                    <td class="lib__usage ds-body-sm">{t(row.usage)}</td>
                    <td class="lib__metrics ds-body-sm">
                      size: {row.size}/{row.lineHeight} px
                      <br />
                      weight: {row.weight}
                    </td>
                    <td
                      class="lib__sample"
                      style={`font-size: ${row.size}px; line-height: ${row.lineHeight}px; font-weight: ${row.weight};`}
                    >
                      {t(row.sample)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            <ul class="lib__colors">
              {lib.colors.map((group) => (
                <li class="lib__color-group">
                  <ul>
                    {[group, ...(group.tints ?? [])].map((swatch, index) => (
                      <li
                        class:list={['lib__swatch', isDark(swatch.hex, swatch.alpha) && 'is-dark', index === 0 && 'is-main']}
                        style={`background: ${swatchBg(swatch.hex, swatch.alpha)};`}
                      >
                        <span class="lib__hex">{swatch.hex.toUpperCase()}</span>
                        {swatch.alpha !== undefined && <span class="lib__alpha">{swatch.alpha}%</span>}
                        <span class="lib__name">{swatch.name}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </div>

          <ul class="lib__sets">
            {lib.sets.map((set) => (
              <li class="lib__set">
                <p class="lib__set-title ds-body-sm">{t(set.title)}</p>
                <div class="lib__set-items">
                  {rows(set.items).map((row) => (
                    <div class={row[0].block === 'tab' ? 'lib-tabs' : 'lib-cell'}>
                  {row.map((item) => (
                    <div class={itemKey(item)}>
                      {item.block === 'field' ? (
                        <>
                          <span class="lib-field__hint">{t(item.hint)}</span>
                          <span class="lib-field__value">{t(item.label)}</span>
                        </>
                      ) : item.block === 'row' ? (
                        <>
                          <span>{t(item.label)}</span>
                          <span class="lib-row__chevron" aria-hidden="true">›</span>
                        </>
                      ) : item.block === 'checkbox' || item.block === 'radio' || item.block === 'toggle' ? (
                        <>
                          <span class={`lib-control lib-control--${item.block}`} aria-hidden="true" />
                          <span>{t(item.label)}</span>
                        </>
                      ) : (
                        <span>{t(item.label)}</span>
                      )}
                    </div>
                  ))}
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</figure>

<style>
  .dg {
    margin: 0;
  }

  /* Заголовок и поле схемы разделены шагом ритма. */
  .dg__heading {
    margin: 0;
    color: var(--diagram-text);
  }

  .dg__heading-name {
    color: var(--diagram-text-muted);
  }

  .dg__heading + .dg__scroll {
    margin-block-start: var(--flow-pair);
  }

  .dg__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* Полоса прокрутки — тонкая, в цвет линий схемы: системная на Windows
       ложилась под поле толстой серой плашкой. */
    scrollbar-width: thin;
    scrollbar-color: var(--diagram-edge) transparent;
    background: var(--diagram-field);
    border-radius: var(--diagram-node-radius);
  }

  .dg__svg {
    display: block;
    width: 100%;
    max-width: var(--dg-w);
    min-width: var(--dg-w);
    height: auto;
    margin-inline: auto;
  }

  @media (--bp-md) {
    .dg__svg {
      min-width: var(--dg-min);
    }
  }

  /* ---------- Текст ---------- */

  .dg-label,
  .dg-note,
  .dg-frame__name,
  .dg-pill text,
  .dg-badge__num {
    font-family: var(--font-body);
    dominant-baseline: central;
    fill: var(--diagram-text);
  }

  .dg-label {
    font-size: var(--diagram-label-size);
    font-weight: var(--weight-medium);
  }

  .dg-note,
  .dg-pill text {
    font-size: var(--diagram-note-size);
  }

  /* Строка-действие стоит на алфавитной базовой линии в клетке над
     подчёркиванием: выносные элементы (p, y, р, у) не касаются линии. */
  .dg-note--action {
    dominant-baseline: alphabetic;
  }

  .dg-frame__name {
    font-size: var(--diagram-label-size);
    fill: var(--diagram-text-muted);
    dominant-baseline: auto;
  }

  .dg-frame__knock {
    fill: var(--diagram-field);
  }

  /* ---------- Узлы ---------- */

  .dg-node__shape {
    fill: var(--diagram-node);
  }

  .dg-node--entry .dg-node__shape,
  .dg-node--flowLink .dg-node__shape,
  .dg-node--decision .dg-node__shape,
  .dg-node--input .dg-node__shape {
    stroke: var(--diagram-stroke);
    stroke-width: var(--diagram-line);
  }

  .dg-start-bar,
  .dg-action-rule {
    stroke: var(--diagram-stroke);
    stroke-width: var(--diagram-line);
  }

  .dg-group {
    fill: none;
    stroke: var(--diagram-group);
    stroke-width: var(--diagram-line);
    stroke-dasharray: calc(var(--diagram-cell) / 2);
  }

  .dg-badge {
    fill: var(--diagram-badge);
  }

  .dg-badge__num {
    font-family: var(--font-meta);
    font-size: var(--diagram-note-size);
    fill: var(--diagram-badge-text);
  }

  /* ---------- Связи ---------- */

  .dg-edge path {
    fill: none;
    stroke: var(--diagram-arrow);
    stroke-width: var(--diagram-line);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dg-edge--map path {
    stroke: var(--diagram-edge);
  }

  .dg-edge--prototype path {
    stroke: var(--diagram-proto);
    stroke-width: var(--diagram-proto-line);
  }

  .dg-hotspot {
    fill: var(--diagram-frame);
    stroke: var(--diagram-proto);
    stroke-width: var(--diagram-proto-line);
  }

  .dg-pill__knock { fill: var(--diagram-field); }
  .dg-pill--yes .dg-pill__bg { fill: var(--diagram-yes-bg); }
  .dg-pill--yes text { fill: var(--diagram-yes-text); }
  .dg-pill--no .dg-pill__bg  { fill: var(--diagram-no-bg); }
  .dg-pill--no text  { fill: var(--diagram-no-text); }

  .is-dim {
    opacity: var(--diagram-dim);
  }

  /* ---------- Вайрфрейм ---------- */

  .dg-frame__screen {
    fill: var(--diagram-frame);
  }

  .dg-wire-fill {
    fill: var(--diagram-wire);
  }

  .dg-wire-strong {
    fill: var(--diagram-wire-strong);
  }

  .dg-wire-stroke {
    fill: none;
    stroke: var(--diagram-wire-strong);
    stroke-width: var(--diagram-line);
  }

  .dg-wire-line {
    stroke: var(--diagram-wire);
    stroke-width: var(--diagram-line);
  }

  /* ---------- Лист библиотеки ---------- */

  .lib {
    padding: var(--space-6);
    background: var(--diagram-field);
    border-radius: var(--diagram-node-radius);
    color: var(--diagram-text);
  }

  @media (--bp-md) {
    .lib {
      padding: var(--space-12);
    }
  }

  .lib__title {
    margin: 0;
  }

  .lib__grid {
    display: grid;
    gap: var(--flow-group);
    margin-block-start: var(--flow-group);
  }

  @media (--bp-lg) {
    .lib__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  /* Типографика — таблица в четыре колонки; ниже bp-md строка
     становится карточкой из двух ярусов: имя и метрики над образцом. */
  .lib__type {
    width: 100%;
    border-collapse: collapse;
  }

  .lib__type tr {
    border-block-end: var(--diagram-line) solid var(--diagram-edge);
  }

  .lib__type th,
  .lib__type td {
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
    text-align: start;
    vertical-align: top;
  }

  .lib__style {
    font-weight: var(--weight-medium);
  }

