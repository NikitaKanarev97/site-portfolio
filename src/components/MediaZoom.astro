---
/** One native lightbox per route: complete image, separate text block. */
import { site, type SiteCopy } from '../copy/site.ts';
import ScreenSurface from './ScreenSurface.astro';
interface Props { class?: string; zoomCopy?: SiteCopy['zoom']; }
const { class: className, zoomCopy = site.zoom } = Astro.props;
const zoom = zoomCopy;
---
<dialog class:list={['media-zoom', className]} data-media-zoom aria-labelledby="media-zoom-title" aria-describedby="media-zoom-caption">
  <div class="media-zoom__panel">
    <header class="media-zoom__head">
      <h2 class="ds-heading-xl" id="media-zoom-title">{zoom.label}</h2>
      <button class="media-zoom__close ds-body-sm" type="button" data-media-zoom-close>
        <span>{zoom.close}</span><span aria-hidden="true">×</span>
      </button>
    </header>
    <figure class="media-zoom__figure">
      <div class="media-zoom__viewport" data-media-zoom-viewport tabindex="0" aria-label={zoom.label}>
        <ScreenSurface class="media-zoom__surface">
          <img class="media-zoom__media" data-media-zoom-image src="" alt="" decoding="async" />
        </ScreenSurface>
      </div>
      <figcaption class="media-zoom__caption ds-body-base" id="media-zoom-caption" data-media-zoom-caption></figcaption>
    </figure>
  </div>
</dialog>
<style>
  .media-zoom { width: 100%; max-width: 100%; height: 100%; max-height: 100%; margin: 0; padding: var(--space-4); border: 0; background: transparent; color: var(--text-default); overflow: hidden; }
  .media-zoom[open] { display: grid; place-items: center; }
  .media-zoom::backdrop { background: var(--surface-inverse); opacity: var(--scrim-opacity); }
  .media-zoom__panel { display: flex; flex-direction: column; inline-size: 100%; max-inline-size: var(--container-max); max-block-size: 100%; min-block-size: 0; border-radius: var(--radius-lg); background: var(--surface-default); overflow: hidden; box-shadow: var(--shadow-lg); }
  .media-zoom__head { display: flex; align-items: center; justify-content: space-between; flex: none; gap: var(--space-4); padding: var(--space-3) var(--space-4); border-block-end: var(--border-width) solid var(--border-default); }
  .media-zoom__head h2 { margin: 0; }
  .media-zoom__close { display: flex; align-items: center; justify-content: center; flex: none; gap: var(--space-2); min-block-size: var(--space-12); padding: 0 var(--space-3); border: var(--border-width) solid var(--border-default); border-radius: var(--radius-lg); background: var(--surface-default); color: var(--text-default); font: inherit; cursor: pointer; }
  .media-zoom__figure { display: flex; flex-direction: column; min-block-size: 0; margin: 0; }
  .media-zoom__viewport { min-block-size: 0; overflow: auto; overscroll-behavior: contain; padding: var(--space-4); background: var(--surface-default); }
  .media-zoom__media { display: block; margin-inline: auto; max-inline-size: 100%; block-size: auto; object-fit: contain; }
  .media-zoom__viewport :global(.media-zoom__surface) { inline-size: fit-content; max-inline-size: 100%; margin-inline: auto; }
  .media-zoom__caption { flex: none; max-block-size: 30svh; overflow: auto; margin: 0; padding: var(--space-4); border-block-start: var(--border-width) solid var(--border-default); color: var(--text-subtle); text-wrap: pretty; }
  @media (--bp-md) {
    .media-zoom { padding: var(--space-8); }
    .media-zoom__head { padding-inline: var(--space-6); }
    .media-zoom__viewport, .media-zoom__caption { padding: var(--space-6); }
  }
  .media-zoom__close { transition: color var(--motion-hover-duration) var(--motion-hover-ease); }
  @media (--can-hover) { .media-zoom__close:hover { color: var(--text-link-hover); } }
  .media-zoom__close:active { color: var(--text-link-pressed); transition-duration: var(--motion-press-duration); transition-timing-function: var(--motion-press-ease); }
</style>
<script>
  let zoomLifecycle: AbortController | undefined;
  let zoomDialog: HTMLDialogElement | undefined;
  function teardownMediaZoom() {
    if (zoomDialog?.open) zoomDialog.close();
    document.body.classList.remove('ds-scroll-locked');
    zoomLifecycle?.abort();
    zoomDialog = undefined;
  }
  function initMediaZoom() {
    teardownMediaZoom();
    const dialog = document.querySelector<HTMLDialogElement>('[data-media-zoom]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-media-zoom-image]');
    const caption = dialog?.querySelector<HTMLElement>('[data-media-zoom-caption]');
    const close = dialog?.querySelector<HTMLButtonElement>('[data-media-zoom-close]');
    const viewport = dialog?.querySelector<HTMLElement>('[data-media-zoom-viewport]');
    const surface = dialog?.querySelector<HTMLElement>('.media-zoom__surface');
    if (!dialog || !image || !caption || !close || !viewport) return;
    zoomDialog = dialog;
    zoomLifecycle = new AbortController();
    const { signal } = zoomLifecycle;
    let source: HTMLElement | undefined;
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-zoom-trigger]');
      if (!trigger || !dialog.showModal || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const preview = trigger.querySelector<HTMLImageElement>('img');
      source = trigger;
      image.src = trigger.dataset.zoomFixed ? trigger.dataset.zoomSrc! : preview?.currentSrc || trigger.dataset.zoomSrc || '';
      const narrow = preview?.currentSrc && preview.currentSrc !== preview.src;
      surface?.classList.toggle('screen-surface--native', !!trigger.dataset.zoomNative);
      image.alt = (narrow ? trigger.dataset.zoomAltNarrow : undefined) || trigger.dataset.zoomAlt || preview?.alt || '';
      caption.textContent = trigger.dataset.zoomCaption || image.alt;
      document.body.classList.add('ds-scroll-locked');
      dialog.showModal();
      viewport.scrollTop = 0;
      viewport.scrollLeft = 0;
    }, { signal });
    close.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); }, { signal });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('ds-scroll-locked');
      image.removeAttribute('src');
      image.alt = '';
      caption.textContent = '';
      if (source?.isConnected) source.focus({ preventScroll: true });
      source = undefined;
    }, { signal });
  }
  document.addEventListener('astro:page-load', initMediaZoom);
  document.addEventListener('astro:before-swap', teardownMediaZoom);
</script>
