---
/**
 * CaseNext — ds/components.md, карта ds/screens/case.md §8
 *
 * Переход к следующему кейсу (блок 10): блок во всю ширину на цвете
 * следующего кейса, название огромной бегущей строкой. Доноры —
 * hainteractive и Tubik. Цвет кейса стоит только здесь и на обложке.
 *
 * Весь блок — одна ссылка. Без перехвата колеса и без перехода по
 * докручиванию (PLAN-CHATS.md, общие правила): переход — клик или обычная
 * ссылка. Ссылка на прототип стоит ниже, вне большой ссылки, чтобы не
 * вкладывать одну цель в другую.
 *
 * Бегущая строка — три копии названия в ряд. Первую читает только
 * визуально, имя ссылки собирается из метки и названия в скрытом тексте;
 * все копии aria-hidden. Без JS и при reduced-motion строка стоит: первая
 * копия с левого поля контейнера, хвост уходит за край. Движение —
 * data-motion="marquee", исполнитель этап 3; раскрытие обложки следующего
 * кейса через View Transitions — тоже этап 3.
 */
import TextLink from './TextLink.astro';
import { caseThemes, type CaseTheme } from '../copy/cases/story';

interface Props {
  href: string;
  title: string;
  theme: CaseTheme;
  label: string;
  prototype?: { label: string; href: string };
  class?: string;
  transitionKey?: string;
}

const { href, title, theme, label, prototype, class: className, transitionKey } = Astro.props;
const { surface, tone } = caseThemes[theme];
---

<section class:list={['case-next', className]}>
  <a
    class="case-next__link ds-pressable"
    href={href}
    transition:name={transitionKey}
    transition:animate={transitionKey ? 'initial' : 'none'}
    data-case-next={transitionKey}
    data-tone={tone}
    style={`--next-surface: ${surface}`}
  >
    <span class="ds-container ds-meta-xs case-next__label" aria-hidden="true">{label}</span>
    <span class="ds-visually-hidden">{label}: {title}</span>
    <span class="case-next__marquee" aria-hidden="true">
      <span class="case-next__track" data-motion="marquee">
        {[0, 1, 2].map(() => <span class="ds-display-7xl case-next__title">{title}</span>)}
      </span>
    </span>
  </a>
  {
    prototype && (
      <p class="ds-container ds-body-sm case-next__proto">
        <TextLink href={prototype.href} external>
          {prototype.label}
        </TextLink>
      </p>
    )
  }
</section>

<style>
  /* Выше закреплённой обложки, как лист: иначе sticky-обложка с z-index 0
     рисуется поверх блока, который идёт после листа. */
  .case-next {
    position: relative;
    z-index: 1;
    background: var(--surface-default);
  }

  .case-next__link {
    display: flex;
    flex-direction: column;
    gap: var(--flow-node);
    padding-block: var(--section-gap);
    background: var(--next-surface);
    color: var(--text-default);
    text-decoration: none;
  }

  .case-next__link[data-tone='dark'] {
    color: var(--text-on-inverse);
  }

  .case-next__link:focus-visible {
    outline-offset: calc(-1 * var(--focus-ring-width) * 2);
  }

  /* min-inline-size обязателен: clip — не область прокрутки, и без него
     flex-элемент держит ширину всей строки и даёт прокрутку страницы. */
  .case-next__marquee {
    display: block;
    min-inline-size: 0;
    overflow: clip;
  }

  .case-next__track {
    display: flex;
    gap: var(--space-16);
    inline-size: max-content;
    padding-inline-start: var(--margin-sm);
  }

  @media (--bp-md) {
    .case-next__track {
      padding-inline-start: var(--margin-md);
    }
  }

  @media (--bp-lg) {
    .case-next__track {
      padding-inline-start: var(--margin-lg);
    }
  }

  .case-next__title {
    white-space: nowrap;
  }

  .case-next__proto {
    margin: var(--flow-node) 0 0;
    color: var(--text-subtle);
  }

</style>
