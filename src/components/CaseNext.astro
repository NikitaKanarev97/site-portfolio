---
/** Next case: one wrapped title and one native link; the product action stays in facts. */
import { caseThemes, type CaseTheme } from '../copy/cases/story';

interface Props {
  href: string;
  title: string;
  theme: CaseTheme;
  label: string;
  prototype?: { label: string; href: string };
  class?: string;
  transitionKey?: string;
}

const { href, title, theme, label, class: className, transitionKey } = Astro.props;
const { surface, tone } = caseThemes[theme];
---

<section class:list={['case-next', className]}>
  <a
    class="case-next__link ds-pressable"
    href={href}
    transition:name={transitionKey}
    transition:animate={transitionKey ? 'initial' : 'none'}
    data-case-next={transitionKey}
    data-tone={tone}
    style={`--next-surface: ${surface}`}
  >
    <span class="ds-container ds-meta-sm case-next__label" aria-hidden="true">{label}</span>
    <span class="ds-visually-hidden">{label}: {title}</span>
    <span class="ds-container ds-display-6xl case-next__title" aria-hidden="true">{title}</span>
  </a>
</section>

<style>
  /* Выше закреплённой обложки, как лист: иначе sticky-обложка с z-index 0
     рисуется поверх блока, который идёт после листа. */
  .case-next {
    position: relative;
    z-index: 1;
    background: var(--surface-default);
  }

  .case-next__link {
    display: flex;
    flex-direction: column;
    gap: var(--flow-node);
    padding-block: var(--section-gap);
    background: var(--next-surface);
    color: var(--text-default);
    text-decoration: none;
  }

  .case-next__link[data-tone='dark'] {
    color: var(--text-on-inverse);
  }

  .case-next__link:focus-visible {
    outline-offset: calc(-1 * var(--focus-ring-width) * 2);
  }

  .case-next__title {
    inline-size: 100%;
    overflow-wrap: anywhere;
  }

</style>
