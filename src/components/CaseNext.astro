---
/** Next case: one wrapped title and one native link; the product action stays in facts. */
import { caseThemes, type CaseTheme } from '../copy/cases/story';
import IconArrow from './IconArrow.astro';

interface Props {
  href: string;
  title: string;
  theme: CaseTheme;
  label: string;
  prototype?: { label: string; href: string };
  class?: string;
  transitionKey?: string;
}

const { href, title, theme, label, class: className, transitionKey } = Astro.props;
const { surface, tone } = caseThemes[theme];
---

<section class:list={['case-next', className]}>
  <a
    class="case-next__link ds-pressable"
    href={href}
    transition:name={transitionKey}
    transition:animate={transitionKey ? 'initial' : 'none'}
    data-case-next={transitionKey}
    data-tone={tone}
    style={`--next-surface: ${surface}`}
  >
    <span class="ds-container ds-meta-sm case-next__label" aria-hidden="true">
      <span class="case-next__label-text">{label}<span class="case-next__rule"></span></span>
      <IconArrow class="case-next__arrow" />
    </span>
    <span class="ds-visually-hidden">{label}: {title}</span>
    <span class="ds-container ds-display-6xl case-next__title" aria-hidden="true">{title}</span>
  </a>
</section>

<style>
  /* Выше закреплённой обложки, как лист: иначе sticky-обложка с z-index 0
     рисуется поверх блока, который идёт после листа. */
  .case-next {
    position: relative;
    z-index: 1;
    background: var(--surface-default);
  }

  .case-next__link {
    display: flex;
    flex-direction: column;
    gap: var(--flow-node);
    padding-block: var(--section-gap);
    background: var(--next-surface);
    color: var(--text-default);
    text-decoration: none;
  }

  .case-next__link[data-tone='dark'] {
    color: var(--text-on-inverse);
  }

  .case-next__link:focus-visible {
    outline-offset: calc(-1 * var(--focus-ring-width) * 2);
  }

  .case-next__label { display: flex; align-items: center; gap: var(--space-2); color: var(--text-link); transition: color var(--motion-hover-duration) var(--motion-hover-ease); }
  .case-next__link[data-tone='dark'] .case-next__label { color: var(--text-link-on-inverse); }
  .case-next__label-text { position: relative; }
  .case-next__rule { position: absolute; inset-inline: 0; bottom: calc(var(--space-1) * -1); height: var(--border-width); background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform var(--motion-hover-duration) var(--motion-hover-ease); }
  .case-next__link:focus-visible .case-next__rule { transform: scaleX(1); transform-origin: left; }
  .case-next__link:active .case-next__rule { transform: scaleX(1); transform-origin: left; }
  .case-next__link:active .case-next__label { color: var(--text-link-pressed); }
  .case-next__link[data-tone='dark']:active .case-next__label { color: var(--text-link-pressed-on-inverse); }
  .case-next__link:active .case-next__label, .case-next__link:active .case-next__rule { transition-duration: var(--motion-press-duration); transition-timing-function: var(--motion-press-ease); }
  .case-next__label :global(.case-next__arrow) { transition: transform var(--motion-hover-duration) var(--motion-hover-ease); }
  @media (--can-hover) {
    .case-next__link:hover .case-next__label { color: var(--text-link-hover); }
    .case-next__link[data-tone='dark']:hover .case-next__label { color: var(--text-link-on-inverse); }
    .case-next__link:hover .case-next__rule { transform: scaleX(1); transform-origin: left; }
    .case-next__link:active .case-next__label { color: var(--text-link-pressed); }
    .case-next__link[data-tone='dark']:active .case-next__label { color: var(--text-link-pressed-on-inverse); }
    @media (prefers-reduced-motion: no-preference) {
      .case-next__link:hover :global(.case-next__arrow) { transform: translateX(var(--space-1)); }
    }
  }

  .case-next__title {
    inline-size: 100%;
    overflow-wrap: anywhere;
  }

</style>
