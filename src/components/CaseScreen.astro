---
/** Full capture on a single edge; a padded frame is an explicit option. */
import MediaFrame from './MediaFrame.astro';
import ScreenSurface from './ScreenSurface.astro';
import { frameSize } from '../lib/media';
import type { ShotItem } from '../copy/cases/story';
import { assertShotMedia } from '../copy/cases/story';
import { px } from '../lib/tokens';
import { site } from '../copy/site';
import { siteRu } from '../copy/ru/site';

interface Props {
  item: ShotItem;
  loading?: 'lazy' | 'eager';
  class?: string;
  native?: boolean;
  appearance?: 'edge' | 'frame';
  caption?: string;
  href?: string;
  linkLabel?: string;
  narrowAt?: 'md' | 'lg';
}
const { item, loading = 'lazy', class: className, native = false, caption, href, linkLabel, narrowAt = 'md' } = Astro.props;
const appearance = Astro.props.appearance ?? 'edge';
assertShotMedia(item);
const size = await frameSize(item.src);
const narrowSize = item.srcNarrow ? await frameSize(item.srcNarrow) : size;
const narrowMedia = `(max-width: ${px(`bp-${narrowAt}`) - 1}px)`;
const ar = size ? size.width / size.height : item.device === 'phone' ? 390 / 844 : 16 / 10;
const copy = Astro.url.pathname.startsWith('/ru') ? siteRu : site;
---

<div
  class:list={['case-screen', `case-screen--${item.device}`, `case-screen--${appearance}`, native && 'case-screen--native', item.srcNarrow && narrowAt === 'lg' && 'case-screen--narrow-tablet', className]}
  style={`--ar: ${ar.toFixed(4)}; --ar-narrow: ${narrowSize ? narrowSize.width / narrowSize.height : ar}; ${item.nativeWidth ? `max-inline-size:calc(${item.nativeWidth}px + ${native || appearance === 'edge' ? '0px' : 'var(--frame-inset) * 2'});` : ''}`}
  data-motion={!native && !href ? 'fade-image' : undefined}
>
  {item.video ? (
    <div class="case-screen__media">
      <MediaFrame src={item.src} alt={item.alt} video={item.video} film={item.film} ratio="natural" fill reveal={false} />
    </div>
  ) : (
    <a class:list={['case-screen__open', href && 'case-screen__open--case']} href={href ?? item.src} data-astro-reload={href ? undefined : true} data-zoom-trigger={href ? undefined : true} data-zoom-src={href ? undefined : item.src}
      data-zoom-alt={item.alt} data-zoom-alt-narrow={item.altNarrow}
      data-zoom-native={native || undefined}
      data-zoom-caption={caption} aria-label={href ? linkLabel : `${copy.zoom.open}: ${item.alt}`}>
      <div class="case-screen__media">
        <ScreenSurface native={native} outlined={appearance === 'edge'}>
        <picture>
          {item.srcNarrow && <source media={narrowMedia} srcset={item.srcNarrow} width={narrowSize?.width} height={narrowSize?.height} />}
          <img src={item.src} alt={item.alt} width={size?.width} height={size?.height}
            loading={loading} decoding="async" />
        </picture>
        </ScreenSurface>
        <slot name="annotations" />
        {!href && (
          <span class="case-screen__cue" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </span>
        )}
      </div>
      {caption && <div class="case-screen__text"><p class="ds-body-sm">{caption}</p></div>}
    </a>
  )}
</div>

<style>
  .case-screen {
    position: relative;
    min-inline-size: 0;
    inline-size: 100%;
    padding: 0;
    border-radius: var(--radius-lg);
    color: inherit;
  }
  .case-screen--frame {
    padding: var(--frame-inset);
    border-radius: var(--radius-lg);
    background: var(--surface-default);
    color: var(--text-default);
    box-shadow: 0 0 0 var(--border-width) var(--border-default);
  }
  .case-screen__open { display: grid; gap: var(--flow-pair); min-block-size: var(--space-12); border-radius: var(--radius-media); color: inherit; text-decoration: none; cursor: zoom-in; }
  .case-screen__open:focus-visible { outline-offset: var(--space-2); }
  .case-screen__open:focus-visible .case-screen__cue { opacity: 1; transform: none; }
  .case-screen__open--case { cursor: pointer; }
  .case-screen__open--case::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .case-screen__media { position: relative; }
  .case-screen__media picture { display: contents; }
  .case-screen img { display: block; inline-size: 100%; block-size: auto; object-fit: contain; }
  .case-screen__text { display: grid; gap: var(--space-2); }
  .case-screen__text p { margin: 0; }
  /* Метка увеличения вместо подписи «Enlarge ↗»: кадр кликабелен целиком,
     курсор zoom-in и aria-label говорят то же самое, а видимый служебный
     текст под каждым кадром читался как интерфейс разработчика. */
  .case-screen__cue {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    display: grid;
    place-items: center;
    inline-size: var(--zoom-cue-size);
    block-size: var(--zoom-cue-size);
    border-radius: var(--zoom-cue-radius);
    background: var(--surface-default);
    color: var(--text-default);
    box-shadow: var(--zoom-cue-elevation);
    opacity: 0;
    transform: scale(var(--motion-press-scale));
    transition: opacity var(--motion-hover-duration) var(--motion-hover-ease), transform var(--motion-hover-duration) var(--motion-hover-ease), color var(--motion-hover-duration) var(--motion-hover-ease);
    pointer-events: none;
  }
  .case-screen__cue svg { inline-size: 50%; block-size: 50%; }
  .case-screen .case-screen__media :global(.media-frame--natural .media-frame__frame) { padding: 0; background: transparent; box-shadow: none; border: 0; }
  .case-screen--native { padding: 0; background: transparent; box-shadow: none; color: inherit; }
  .case-screen--native img { border-radius: 0; }
  @media (--can-hover) {
    .case-screen__open:hover .case-screen__cue { opacity: 1; transform: none; }
  }
  .case-screen__open:active .case-screen__cue {
    opacity: 1;
    transform: none;
    color: var(--text-link-pressed);
    transition-duration: var(--motion-press-duration);
    transition-timing-function: var(--motion-press-ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-screen__cue { transform: none; }
  }
</style>
