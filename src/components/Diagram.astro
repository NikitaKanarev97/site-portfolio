---
/** Responsive graph composition. DiagramCanvas is the single notation renderer. */
import DiagramCanvas from './DiagramCanvas.astro';
import { mobileDiagram, type Diagram } from '../data/diagrams/schema';
interface Props { data: Diagram; lang?: 'en' | 'ru'; class?: string }
const { data, lang = 'en', class: className } = Astro.props;
const mobile = data.kind !== 'library' ? mobileDiagram(data) : undefined;
---
{mobile ? <div class:list={['dg-responsive', className]}>
  <div class="dg-responsive__desktop" data-diagram-layout="desktop"><DiagramCanvas data={data} lang={lang} /></div>
  <div class="dg-responsive__mobile" data-diagram-layout="mobile"><DiagramCanvas data={mobile} lang={lang} /></div>
</div> : <DiagramCanvas data={data} lang={lang} class={className} />}
<style>
  .dg-responsive { inline-size: 100%; min-inline-size: 0; }
  .dg-responsive__desktop { display: none; }
  .dg-responsive__mobile { display: block; }
  @media (--bp-md) {
    .dg-responsive__desktop { display: block; }
    .dg-responsive__mobile { display: none; }
  }
</style>
