---
/** Step heading and one explanatory body. Focus/checkpoint keep existing motion hooks; phone sequences share rows. */
import CasePlate from './CasePlate.astro';
import CaseScreen from './CaseScreen.astro';
import type { Thesis, ShotItem } from '../copy/cases/story';

interface Props {
  label: string;
  items: (Thesis & { shot: ShotItem; layout?: 'wide' | 'split'; caption?: string; desktopOnly?: boolean; scene?: 'overview' | 'workspace' | 'promise' | 'decision' })[];
  tone?: 'light' | 'dark';
  variant?: 'focus';
  composition?: 'checkpoint' | 'handoff';
  gate?: string;
  class?: string;
}

const { label, items, tone = 'light', variant, composition, gate, class: className } = Astro.props;
const phones = items.every(step => step.shot.device === 'phone');
---

<div class:list={['case-steps', phones && 'case-steps--phones', variant && `case-steps--${variant}`, composition && `case-steps--${composition}`, className]} data-composition={composition} data-motion={composition === 'handoff' ? undefined : variant === 'focus' ? 'focus-stage' : 'pin-swap'}>
  {composition === 'checkpoint' && <div class="case-steps__field-bleed" aria-hidden="true" />}
  <div class="case-steps__stage">
  <ol class="case-steps__list">
    {
      items.map((step) => (
        <li class:list={['case-steps__step', `case-steps__step--${step.layout ?? 'split'}`, step.shot.nativeWidth && 'case-steps__step--compact', step.desktopOnly && 'case-steps__step--desktop-only']} style={step.shot.nativeWidth ? `--step-width:${step.shot.nativeWidth}px` : undefined} data-focus-state data-scene={step.scene}>
          <div class="case-steps__text">
            <h3 class="ds-heading-3xl case-steps__thesis" data-h="thesis">
              {step.thesis}
            </h3>
            {(step.body || step.caption) && (
              <p class="ds-body-lg case-steps__body" data-h="para">
                {step.body || step.caption}
              </p>
            )}
            {composition === 'checkpoint' && step.scene === 'decision' && <div class="case-steps__stop"><span class="case-steps__stop-symbol" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" focusable="false"><circle cx="24" cy="15" r="7" stroke="currentColor" stroke-width="2" /><path d="M10 40v-4a14 14 0 0 1 28 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></span><p class="ds-body-sm">{gate}</p></div>}
          </div>
          <div class="case-steps__shot">
            <CasePlate tone={composition === 'checkpoint' ? 'dark' : variant === 'focus' ? 'light' : tone}>
              <CaseScreen item={step.shot} class="case-steps__screen" />
            </CasePlate>
          </div>
        </li>
      ))
    }
  </ol>
  </div>
</div>

<style>
  .case-steps--handoff .case-steps__step { display: block; }
  @media (--bp-lg) {
    .case-steps--handoff .case-steps__list { grid-template-columns: 3fr 2fr; gap: var(--flow-block) var(--space-12); align-items: start; }
    .case-steps--handoff .case-steps__step:first-child { grid-column: 1 / -1; }
    .case-steps--handoff .case-steps__step:last-child .case-steps__shot { max-inline-size: calc(var(--space-48) * 2); margin-inline: 0; }
  }

  .case-steps__list {
    display: grid;
    gap: var(--flow-block);
    margin: 0;
    padding: 0;
    list-style: none;
  }


  .case-steps__thesis {
    margin: 0;
    color: var(--text-default);
    text-wrap: balance;
  }

  .case-steps__body {
    margin: var(--flow-text) 0 0;
    max-inline-size: var(--measure-case);
    color: var(--text-subtle);
    text-wrap: pretty;
  }

  .case-steps__shot {
    margin-block-start: var(--flow-group);
  }

  .case-steps__shot :global(.case-steps__screen) {
    inline-size: 100%;
  }


  /* Native focus materials keep their own scale; motion enhances this DOM. */
  .case-steps--focus .case-steps__shot {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .case-steps--focus .case-steps__shot > :global(.case-plate) { inline-size: 100%; }
  .case-steps--focus .case-steps__step--split { display: block; }
  .case-steps--focus .case-steps__step--split .case-steps__shot { margin-block-start: var(--flow-group); }

  /* Added only while the entire scene fits. No duplicate images or text. */
  .case-steps--focus.is-focused .case-steps__stage {
    block-size: var(--focus-height);
    position: relative;
  }
  .case-steps--focus.is-focused .case-steps__list {
    position: relative;
    block-size: calc(100% - var(--flow-node));
    margin: var(--flow-node) 0 0;
    display: block;
  }
  .case-steps--focus.is-focused .case-steps__step {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .case-steps--focus.is-focused .case-steps__text {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-16);
    min-block-size: calc(var(--space-32) + var(--space-8));
    align-content: start;
    flex-shrink: 0;
  }
  .case-steps--focus.is-focused .case-steps__thesis { margin-block-start: var(--flow-pair); }
  .case-steps--focus.is-focused .case-steps__body { margin-block-start: var(--flow-pair); }
  .case-steps--focus.is-focused .case-steps__shot {
    margin-block-start: var(--flow-text);
    flex: 1;
    min-block-size: 0;
  }
  .case-steps--focus.is-focused .case-steps__shot > :global(.case-plate) {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-block-size: 0;
    padding: var(--space-6);
  }

  @media (--below-bp-md) {
    .case-steps__step--desktop-only { display: none; }
  }

  /* Checkpoint: the stage becomes a place for a human decision. The
     asymmetric content sits inside equal, generous outer fields. */
  .case-steps__stop { display: none; }
  .case-steps--checkpoint .case-steps__stop {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-block-start: var(--flow-group);
  }
  .case-steps__stop p { margin: 0; }
  .case-steps__stop-symbol { display: block; flex: none; inline-size: var(--space-12); block-size: var(--space-12); }
  .case-steps__stop-symbol svg { display: block; inline-size: 100%; block-size: 100%; }

  /* Без движения (reduce, нет JS, сцена не помещается) шаги идут списком,
     но на десктопе в той же композиции, что и сцена: текст слева, кадр
     справа. Иначе транскрипт и карточка одобрения растягивались на всю
     ширину крупнее собственного масштаба, а знак проверки висел над ними. */
  @media (--bp-lg) {
    .case-steps--checkpoint:not(.is-focused) .case-steps__step:not([data-scene='overview']) {
      display: grid;
      grid-template-columns: 2fr 3fr;
      gap: var(--space-12);
      align-items: center;
    }
    .case-steps--checkpoint:not(.is-focused) .case-steps__step:not([data-scene='overview']) .case-steps__text { display: block; grid-column: auto; }
    .case-steps--checkpoint:not(.is-focused) .case-steps__step:not([data-scene='overview']) .case-steps__shot { margin: 0; grid-column: auto; }
    .case-steps--checkpoint:not(.is-focused) .case-steps__step:not([data-scene='overview']) .case-steps__body { margin-block-start: var(--flow-text); }
  }
  .case-steps--checkpoint.is-focused {
    position: relative;
    isolation: isolate;
    padding: var(--space-12);
    color: var(--text-on-inverse);
    border-radius: var(--radius-lg);
  }
  .case-steps__field-bleed { display: none; }
  .case-steps--checkpoint.is-focused .case-steps__field-bleed {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface-review);
    border-radius: inherit;
    transform-origin: center;
    pointer-events: none;
  }
  .case-steps--checkpoint.is-focused .case-steps__thesis,
  .case-steps--checkpoint.is-focused .case-steps__body { color: inherit; }
  .case-steps--checkpoint.is-focused .case-steps__stage {
    block-size: calc(var(--focus-height) - var(--space-12) * 2 - var(--space-8));
  }
  .case-steps--checkpoint.is-focused .case-steps__list { margin-block-start: var(--flow-node); }
  .case-steps--checkpoint.is-focused .case-steps__text { min-block-size: auto; }
  .case-steps--checkpoint.is-focused .case-steps__shot { margin-block-start: var(--flow-group); }
  .case-steps--checkpoint.is-focused .case-steps__shot > :global(.case-plate) {
    background: transparent;
    padding: 0;
  }
  .case-steps--checkpoint.is-focused .case-steps__step:not([data-scene='overview']) {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-12);
    align-items: center;
  }
  .case-steps--checkpoint.is-focused .case-steps__step:not([data-scene='overview']) .case-steps__text { display: block; }
  .case-steps--checkpoint.is-focused .case-steps__text,
  .case-steps--checkpoint.is-focused .case-steps__shot { grid-column: auto; }
  .case-steps--checkpoint.is-focused .case-steps__step:not([data-scene='overview']) .case-steps__shot { margin: 0; }
  .case-steps--checkpoint.is-focused .case-steps__step:not([data-scene='overview']) .case-steps__body { margin-block-start: var(--flow-text); }
  .case-steps--checkpoint.is-focused [data-scene='promise'] .case-steps__shot {
    border-inline-start: var(--border-width) solid currentColor;
    padding-inline-start: var(--space-12);
  }
  .case-steps--checkpoint.is-focused .case-steps__stop {
    flex-direction: column;
    align-items: start;
    gap: var(--space-6);
  }
  @media not all and (--bp-xl) {
    .case-steps--checkpoint.is-focused { padding: var(--space-8); }
    .case-steps--checkpoint.is-focused .case-steps__stage { block-size: calc(var(--focus-height) - var(--space-8) * 3); }
    .case-steps--checkpoint.is-focused .case-steps__step:not([data-scene='overview']) { gap: var(--space-8); }
    .case-steps--checkpoint.is-focused [data-scene='promise'] .case-steps__shot { padding-inline-start: var(--space-8); }
  }
  /* Fit the complete frame, including its fields and action, in the scene. */
  .case-steps--focus.is-focused .case-steps__shot :global(.case-steps__screen),
  .case-steps--checkpoint.is-focused .case-steps__step .case-steps__shot :global(.case-steps__screen) {
    inline-size: min(100%, var(--focus-screen-width));
    flex-shrink: 0;
  }
  @media (--bp-xl) {
    .case-steps__step--split {
      display: grid;
      grid-template-columns: repeat(var(--columns-lg), minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }

    .case-steps__step--split .case-steps__text {
      grid-column: 1 / 5;
    }

    .case-steps__step--split .case-steps__shot {
      grid-column: 5 / -1;
      margin-block-start: 0;
    }

    .case-steps__step--wide .case-steps__text {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-16);
    }
    .case-steps__step--wide .case-steps__body {
      margin-block-start: var(--flow-pair);
    }
  }

  /* The handoff keeps text above every frame, including wide viewports. */
  .case-steps--handoff .case-steps__step .case-steps__shot { margin-block-start: var(--flow-group); }

  /* Native small panels keep their field close; phone sequences share an axis. */
  .case-steps:not(.is-focused) .case-steps__step--compact .case-steps__shot > :global(.case-plate) {
    inline-size: 100%;
    max-inline-size: calc(var(--step-width) + var(--space-4) * 2);
    padding: var(--space-4);
    align-items: start;
  }
  @media (--bp-md) {
    .case-steps--phones .case-steps__list { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto auto; gap: var(--flow-node) var(--space-8); }
    .case-steps--phones .case-steps__step--compact { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: subgrid; grid-row: span 2; }
    .case-steps--phones .case-steps__shot { margin-block-start: 0; }
    .case-steps--phones .case-steps__text,
    .case-steps--phones .case-steps__shot { grid-column: auto; }
    .case-steps:not(.is-focused):not(.case-steps--phones) .case-steps__step--compact { display: block; }
  }
</style>
