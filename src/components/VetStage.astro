---
import CaseScreen from './CaseScreen.astro';
import { makeVetStory } from '../copy/cases/vet-clinic';
import { learnVetStageCopy } from '../copy/learn-vet-stage';
const {locale,loading='lazy',href,linkLabel} = Astro.props as {locale:'en'|'ru';loading?:'eager'|'lazy';href?:string;linkLabel?:string};
const copy = learnVetStageCopy(locale).vet;
const step = makeVetStory(locale).blocks.find(b=>b.type==='steps');
if (!step || step.type!=='steps') throw new Error('Vet handoff is required');
const [trace,invoice,owner] = step.payload.items;
/* Use the accepted vertical captures to give all roles a readable column.
   The owner keeps its desktop detail and the complete narrow view on mobile. */
const traceShot = {...trace.shot, src:trace.shot.srcNarrow ?? trace.shot.src, nativeWidth:undefined};
const invoiceShot = {...invoice.shot, src:invoice.shot.srcNarrow ?? invoice.shot.src, nativeWidth:undefined};
---
<div class:list={['vet-stage', !href && 'vet-stage--cover']} data-motion-group data-motion-stagger="tight">
  <figure class="vet-stage__trace"><CaseScreen item={traceShot} loading={loading} href={href} linkLabel={linkLabel} /></figure>
  <figure class="vet-stage__invoice"><CaseScreen item={invoiceShot} loading={loading} href={href} linkLabel={linkLabel} /></figure>
  <figure class="vet-stage__owner"><CaseScreen item={{...owner.shot, nativeWidth: undefined}} loading={loading} href={href} linkLabel={linkLabel} /></figure>
  {href && <p class="vet-stage__caption ds-body-sm">{copy.caption}</p>}
</div>
<style>
  .vet-stage { display:grid; gap:var(--flow-node); min-inline-size:0; padding:var(--stage-inset); border-radius:var(--radius-lg); background:var(--surface-cover-vet); color:var(--text-default); }
  .vet-stage figure { margin:0; min-inline-size:0; display:grid; align-content:start; }
  .vet-stage__owner { inline-size:100%; }
  .vet-stage__caption { margin:0; max-inline-size:var(--measure-lead); }
  @media (--below-bp-md) {
    .vet-stage--cover .vet-stage__invoice,
    .vet-stage--cover .vet-stage__owner { display:none; }
  }
  @media (--bp-lg) {
    .vet-stage { grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--flow-node) var(--space-8); align-items:start; }
    .vet-stage__caption { grid-column:1 / -1; }
  }
</style>
