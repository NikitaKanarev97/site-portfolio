---
/** Footer — one quiet copyright line, without a personal location or clock. */
interface Props {
  /** Legacy props retained for compatibility with the component catalogue. */
  location?: string;
  utcLabel?: string;
  timeZone?: string;
  timeLabel?: string;
  copyright: string;
  class?: string;
}

const { copyright, class: className } = Astro.props;
// The /kit fixture also uses this component; normalize its historic symbol.
const copyrightText = copyright.replace(/^©\s*/, Astro.url.pathname.startsWith('/ru') ? 'Авторские права ' : 'Copyright ');
---

<footer class:list={['footer', className]}>
  <div class="ds-container footer__inner">
    <p class="footer__copyright ds-body-sm">{copyrightText}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-width) solid var(--border-default);
    padding-block: var(--space-8);
    color: var(--text-meta);
  }
</style>
