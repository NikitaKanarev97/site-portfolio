---
import CaseScreen from './CaseScreen.astro';
import type { CoverMedia } from '../copy/cases/story';
interface Props { title: string; outcome: string; media: Extract<CoverMedia, { variant: 'proof' }>; as: 'h1' | 'h2' }
const { title, outcome, media, as: Heading } = Astro.props;
const flow = media.workflow!;
const review = {
  src: '/media/rebuild/partner-portal/hero-review-wide.webp',
  srcNarrow: '/media/rebuild/partner-portal/hero-review-narrow.webp',
  alt: flow.reviewLabel + ': source rows with ambiguous, missing and superseded product identities',
  device: 'panel' as const,
};
---
<div class="ds-container procurement-cover">
  <p class="ds-meta-xs procurement-cover__eyebrow">{media.eyebrow}</p>
  <div class="procurement-cover__heading">
    <Heading class="ds-display-6xl procurement-cover__title" data-motion="lines">{title}</Heading>
    <p class="ds-heading-2xl procurement-cover__lead" data-h="lead" data-cover-lead>{outcome}</p>
  </div>
  <div class="procurement-cover__work">
    <div class="procurement-cover__source">
      <p class="ds-meta-xs procurement-cover__label">{flow.sourceLabel}</p>
      <div class="procurement-cover__file">
        <div class="procurement-cover__file-head"><span class="ds-meta-xs">XLS</span><span class="ds-body-sm">{flow.source}</span></div>
        <div class="procurement-cover__row ds-body-sm"><span class="ds-meta-xs">38</span><span>{flow.request}</span><span>{flow.quantity}</span></div>
        <p class="ds-body-sm procurement-cover__count">{flow.total}</p>
      </div>
      <p class="ds-heading-3xl procurement-cover__exceptions">{flow.exceptions}</p>
      <p class="ds-body-lg procurement-cover__decision">{flow.decision}</p>
    </div>
    <div class="procurement-cover__review">
      <p class="ds-meta-xs procurement-cover__label">{flow.reviewLabel}</p>
      <CaseScreen item={review} loading="eager" />
      <div class="procurement-cover__result">
        <p class="ds-meta-xs procurement-cover__label">{flow.resultLabel}</p>
        <CaseScreen item={media.shot} loading="eager" />
      </div>
    </div>
  </div>
  <p class="ds-body-sm procurement-cover__caption" data-h="caption">{media.caption}</p>
</div>
<style>
  .procurement-cover { padding-block: var(--space-12) var(--space-16); }
  .procurement-cover__eyebrow { margin: 0; }
  .procurement-cover__heading { display: grid; gap: var(--space-6); margin-block-start: var(--space-8); }
  .procurement-cover__title { margin: 0; text-wrap: balance; }
  .procurement-cover__lead { margin: 0; max-inline-size: var(--measure-lead); text-wrap: pretty; }
  .procurement-cover__work { display: grid; gap: var(--space-12); margin-block-start: var(--space-12); align-items: start; }
  .procurement-cover__source, .procurement-cover__review { min-inline-size: 0; }
  .procurement-cover__label { margin: 0 0 var(--space-4); }
  .procurement-cover__file { background: var(--surface-default); border-radius: var(--radius-sm); padding: var(--space-6); transform: rotate(-2deg); box-shadow: var(--shadow-md); }
  .procurement-cover__file-head { display: flex; align-items: center; gap: var(--space-3); padding-block-end: var(--space-4); border-block-end: var(--border-width) solid var(--border-default); }
  .procurement-cover__file-head > :first-child { color: var(--text-muted); }
  .procurement-cover__file-head > :last-child { overflow-wrap: anywhere; }
  .procurement-cover__row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-3); align-items: start; padding-block: var(--space-6); border-block-end: var(--border-width) solid var(--border-default); }
  .procurement-cover__count { margin: var(--space-4) 0 0; color: var(--text-muted); }
  .procurement-cover__exceptions { margin: var(--space-8) 0 0; }
  .procurement-cover__decision { margin: var(--space-3) 0 0; text-wrap: pretty; max-inline-size: var(--measure-case); }
  .procurement-cover__review { position: relative; }
  .procurement-cover__result { margin-block-start: var(--space-8); padding-block-start: var(--space-8); border-block-start: var(--border-width) solid var(--border-default); }
  .procurement-cover__caption { margin: var(--space-8) 0 0; color: var(--text-muted); }
  @media (--bp-lg) {
    .procurement-cover__heading { grid-template-columns: 3fr 2fr; align-items: end; gap: var(--space-12); }
    .procurement-cover__work { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-16); }
    .procurement-cover__source { padding-block-start: var(--space-8); }
  }
  @media (--below-bp-md) {
    .procurement-cover { padding-block: var(--space-8) var(--space-12); }
    .procurement-cover__title { font-size: var(--size-4xl); }
    .procurement-cover__file { transform: none; }
    .procurement-cover__work { gap: var(--space-8); }
  }
</style>
