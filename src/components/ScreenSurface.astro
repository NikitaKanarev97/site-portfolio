---
/** Rounded screenshot with fields matching its documented surface colour. */
import { frameSize } from '../lib/media';
interface Props {
  src: string;
  srcNarrow?: string;
  narrowAt?: 'md' | 'lg';
  extend?: boolean;
  class?: string;
}
const { src, srcNarrow, narrowAt = 'md', extend = true, class: className } = Astro.props;
const wide = extend && src ? await frameSize(src) : null;
const narrow = extend && srcNarrow ? await frameSize(srcNarrow) : wide;
---
<div class:list={['screen-surface', !extend && 'screen-surface--native', className]}
  style={`--screen-surface-wide:${wide?.surface ?? 'transparent'};--screen-surface-narrow:${narrow?.surface ?? 'transparent'};`}
  data-narrow-at={narrowAt}>
  <div class="screen-surface__edge"><slot /></div>
</div>
<style>
  .screen-surface {
    --screen-surface: var(--screen-surface-narrow);
    min-inline-size: 0;
    inline-size: 100%;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--screen-surface);
  }
  .screen-surface__edge {
    padding: var(--screen-inset);
    /* The original pixels sit outside the rounded corners. The extra fields
       use the source surface, without stretching source borders or text. */
  }
  .screen-surface--native, .screen-surface--native .screen-surface__edge { display: contents; }
  @media (--bp-md) {
    .screen-surface[data-narrow-at='md'] { --screen-surface: var(--screen-surface-wide); }
  }
  @media (--bp-lg) {
    .screen-surface[data-narrow-at='lg'] { --screen-surface: var(--screen-surface-wide); }
  }
</style>
