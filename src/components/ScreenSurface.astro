---
/** Clip the actual capture; never extend its edges with a sampled colour. */
interface Props {
  native?: boolean;
  class?: string;
}
const { native = false, class: className } = Astro.props;
---
<div class:list={['screen-surface', native && 'screen-surface--native', className]}>
  <div class="screen-surface__edge"><slot /></div>
</div>
<style>
  .screen-surface {
    min-inline-size: 0;
    inline-size: 100%;
    border-radius: var(--radius-media);
    overflow: hidden;
    isolation: isolate;
  }
  .screen-surface__edge {
    /* One clipping boundary, exactly the size of the original capture. */
    padding: 0;
  }
  .screen-surface--native, .screen-surface--native .screen-surface__edge { display: contents; }
</style>
