---
import CaseScreen from './CaseScreen.astro';
import LearnStage from './LearnStage.astro';
import VetStage from './VetStage.astro';
import { caseArt } from '../copy/case-art';
import type { CaseTheme, CoverMedia, ShotItem } from '../copy/cases/story';
interface Props {
  theme: CaseTheme;
  media: CoverMedia;
  locale: 'en' | 'ru';
  usage?: 'home' | 'cover';
  loading?: 'eager' | 'lazy';
  href?: string;
  linkLabel?: string;
}
const {theme, media, locale, usage = 'home', loading = 'lazy', href, linkLabel} = Astro.props;
const art = caseArt(theme, locale);
const shots = media.variant === 'proof' ? media.panels ?? [media.shot] : media.variant === 'screen' ? media.items : [];
const visibleShots: ShotItem[] = theme === 'pawly' ? shots.slice(-1) : shots;
---
<div class:list={['work-stage', `work-stage--${theme}`, `work-stage--${usage}`]} data-focus-tone={theme === 'agent' || theme === 'learn' ? 'inverse' : undefined} data-motion={theme === 'agent' && usage === 'cover' ? 'cover-interlock' : undefined}>
  {theme === 'learn' ? <LearnStage locale={locale} loading={loading} href={href} linkLabel={linkLabel} /> : theme === 'vet' ? <VetStage locale={locale} loading={loading} href={href} linkLabel={linkLabel} /> : <>
  {theme === 'portal' && <div class="work-stage__annotation">
    <p class="ds-display-7xl work-stage__figure">38</p>
    <p class="ds-body-base work-stage__detail">{art.detail}</p>
  </div>}
  {theme === 'pawly' && <figure class="work-stage__photo">
    <img src="/media/art-direction/pawly/handover-dropoff.webp" width="800" height="597" loading={loading} decoding="async" alt={locale === 'ru' ? 'Pawly: питомец у двери, исполнитель снимает поводок.' : 'Pawly: a dog at the door as the walker unclips the lead.'} />
    <figcaption class="ds-body-sm">{art.detail}</figcaption>
  </figure>}
  <div class="work-stage__screens">
    {visibleShots.map((shot, i) => <>
      {theme === 'agent' && i === 1 && <div class="work-stage__gate" data-cover-gate data-motion={usage === 'home' ? 'fade' : undefined}>
        <svg class="work-stage__reviewer" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
          <circle cx="24" cy="15" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M10 40v-4a14 14 0 0 1 28 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <p class="ds-body-sm">{art.label}</p>
      </div>}
      <div class="work-stage__panel" data-cover-panel={theme === 'agent' ? '' : undefined}><CaseScreen item={{...shot, nativeWidth: undefined}} loading={loading} href={href} linkLabel={linkLabel} /></div>
    </>)}
  </div>
  </>}
</div>
<style>
  .work-stage { display: grid; gap: var(--space-6); align-items: center; }
  .work-stage__screens { display: grid; gap: var(--space-6); min-inline-size: 0; align-items: center; }
  .work-stage__panel { min-inline-size: 0; }
  .work-stage__annotation { display: grid; gap: var(--flow-pair); align-content: start; }
  .work-stage__annotation p, .work-stage__gate p { margin: 0; }
  .work-stage__figure { font-variant-numeric: tabular-nums; }
  .work-stage__detail { max-inline-size: var(--measure-case); text-wrap: pretty; }
  .work-stage__gate { display: flex; gap: var(--space-3); align-items: center; justify-content: center; text-align: center; }
  .work-stage__reviewer { flex: none; inline-size: var(--space-8); block-size: var(--space-8); }
  .work-stage__photo { margin: 0; display: grid; gap: var(--space-3); }
  .work-stage__photo img { display: block; inline-size: 100%; block-size: auto; border-radius: var(--radius-lg); }
  .work-stage--pawly .work-stage__panel { inline-size: 100%; }
  .work-stage--portal { padding: var(--stage-inset); border-radius: var(--radius-lg); background: var(--surface-cover-portal); color: var(--text-default); }
  .work-stage--home.work-stage--learn { padding:var(--stage-inset); border-radius:var(--radius-lg); background:var(--surface-cover-learn); color:var(--text-on-inverse); }
  @media (--below-bp-md) {
    .work-stage__annotation { grid-template-columns: auto 1fr; align-items: center; column-gap: var(--space-6); }
    .work-stage__figure { grid-row: 1; }
    .work-stage__detail { grid-column: 2; }
  }
  @media (--bp-md) {
    .work-stage--agent .work-stage__screens { grid-template-columns: 5fr 1fr 5fr; gap: var(--space-8); }
    .work-stage--agent .work-stage__panel:last-child { padding-block-start: var(--space-12); }
    .work-stage__gate { flex-direction: column; }
    .work-stage__reviewer { inline-size: var(--space-12); block-size: var(--space-12); }
  }
  @media (--bp-lg) {
    .work-stage--portal { grid-template-columns: minmax(0,1fr) minmax(0,4fr); gap: var(--space-8); align-items: start; }
    .work-stage--pawly { grid-template-columns: minmax(0,2fr) minmax(0,1fr); gap: var(--space-8); align-items: start; }
    .work-stage--pawly .work-stage__panel { max-inline-size: calc(var(--space-48) * 2); }
    .work-stage--pawly .work-stage__photo, .work-stage--pawly .work-stage__screens { align-self: start; }
  }
</style>
