node_modules/
dist/
.astro/
.vercel/
.env
.env.production
.DS_Store

# Резервные копии артефактов
*.bak

# Отчёты прогонов screens-audit. Решения из них переносятся в ds/ тем же
# прогоном — здесь остаётся сырой лог, он локальный.
.tmp/

# Рабочие папки прогонов: логи сканеров, итерации PDF, резервные копии
# кадров до пересъёмки. Локальные, воспроизводятся скриптами.
tmp/

# Сборка резюме. Генерируется npm run cv:build и cv:build:ru из
# cv/resume-data*.json — в репозитории хранятся источники, не выгрузка.
output/

# Тяжёлые материалы бенчмарка: видео, записи прокрутки, исходники доноров,
# покадровая съёмка. Локальные, ~45 МБ; выводы лежат в .md рядом.
research/portfolio-benchmark/blinkov-rec/
research/portfolio-benchmark/ha-src/
research/portfolio-benchmark/motion-rec/
research/portfolio-benchmark/frames/
research/portfolio-benchmark/ha/
research/portfolio-benchmark/ours/
research/portfolio-benchmark/picks/
research/portfolio-benchmark/shots/

# Полные выводы astro check (18–85 МБ каждый) и архивы логов: воспроизводятся
# одной командой, в репозиторий не идут. Сводки и решения лежат в .md рядом.
*check*.log
tasks/**/*.zip

# Снимки и логи Playwright MCP — кэш инструмента.
.playwright-mcp/
